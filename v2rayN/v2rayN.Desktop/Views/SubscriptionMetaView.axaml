<UserControl
    x:Class="v2rayN.Desktop.Views.SubscriptionMetaView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:v2rayN.Desktop.Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignWidth="408"
    mc:Ignorable="d">

    <!--
        Мета-бар подписки = ЗАГОЛОВОК её группы серверов (под-план 2, 1:1 c Android
        layout_subscription_meta_bar.xml). Владелец: карточка подписки сверху ДОЛЖНА
        бесшовно продолжаться в свои серверы одной секцией — поэтому этот вид живёт КАК
        header каждой группы внутри ServerListView (никакого отдельного «Сервера»-заголовка).

        Строка 1: шеврон-сворачивание (сворачивает серверы ЭТОЙ подписки) + (title + subtitle)
                   + действия (пинг · обновить · пин · удалить подписку).
        Тело (видно только у реальной подписки с userinfo): трафик-пилюля + expiry, announce,
                   поддержка + telegram.

        DataContext = HomeServerGroup (наследуется из шаблона группы). SubItem резолвится в
        code-behind по Subid первого сервера группы (AppManager.GetSubItem) — только реальные
        данные движка, ничего не выдумываем. Образцы — ТОЛЬКО в Design.IsDesignMode.
    -->

    <UserControl.Resources>
        <!--  Скругление карточки подписки = 16 (tokens.md). Локальный токен, а не число в атрибуте:
              один источник правды на этот вид, пока владелец GlobalResources не поднимет его в
              общую шкалу.  -->
        <CornerRadius x:Key="Radius.SubCard">16</CornerRadius>

        <!--  Глифы-иконки, портированные 1:1 из Android res/drawable (viewport 24×24).  -->
        <!--  ic_arrow_drop_down/шеврон группы — тонкий caret «⌄» (expand_more).  -->
        <StreamGeometry x:Key="Meta.Chevron">M7.41,8.59L12,13.17l4.59,-4.58L18,10l-6,6 -6,-6z</StreamGeometry>
        <!--  ic_ping_24dp — концентрические дуги-вещание.  -->
        <StreamGeometry x:Key="Meta.Ping">M12,11c-1.1,0 -2,0.9 -2,2s0.9,2 2,2 2,-0.9 2,-2 -0.9,-2 -2,-2zM18,13c0,-3.31 -2.69,-6 -6,-6s-6,2.69 -6,6c0,2.22 1.21,4.15 3,5.19l1,-1.74c-1.19,-0.7 -2,-1.97 -2,-3.45 0,-2.21 1.79,-4 4,-4s4,1.79 4,4c0,1.48 -0.81,2.75 -2,3.45l1,1.74c1.79,-1.04 3,-2.97 3,-5.19zM12,3C6.48,3 2,7.48 2,13c0,3.7 2.01,6.92 4.99,8.65l1,-1.73C5.61,18.53 4,15.96 4,13c0,-4.42 3.58,-8 8,-8s8,3.58 8,8c0,2.96 -1.61,5.53 -4,6.92l1,1.73c2.98,-1.73 5,-4.95 5,-8.65 0,-5.52 -4.48,-10 -10,-10z</StreamGeometry>
        <!--  ic_refresh_24dp — круговая стрелка обновления.  -->
        <StreamGeometry x:Key="Meta.Refresh">M17.65,6.35C16.2,4.9 14.21,4 12,4c-4.42,0 -7.99,3.58 -7.99,8s3.57,8 7.99,8c3.73,0 6.84,-2.55 7.73,-6h-2.08c-0.82,2.33 -3.04,4 -5.65,4 -3.31,0 -6,-2.69 -6,-6s2.69,-6 6,-6c1.66,0 3.14,0.69 4.22,1.78L13,11h7V4l-2.35,2.35z</StreamGeometry>
        <!--  ic_pin_24dp — канцелярская кнопка.  -->
        <StreamGeometry x:Key="Meta.Pin">M16,9V4h1c0.55,0 1,-0.45 1,-1s-0.45,-1 -1,-1H7C6.45,2 6,2.45 6,3s0.45,1 1,1h1v5c0,1.66 -1.34,3 -3,3v2h5.97v7l1,1 1,-1v-7H19v-2c-1.66,0 -3,-1.34 -3,-3z</StreamGeometry>
        <!--  ic_support_24dp — вопрос в круге (help).  -->
        <StreamGeometry x:Key="Meta.Support">M12,2C6.48,2 2,6.48 2,12s4.48,10 10,10 10,-4.48 10,-10S17.52,2 12,2zM13,19h-2v-2h2v2zM15.07,11.25l-0.9,0.92C13.45,12.9 13,13.5 13,15h-2v-0.5c0,-1.1 0.45,-2.1 1.17,-2.83l1.24,-1.26c0.37,-0.36 0.59,-0.86 0.59,-1.41 0,-1.1 -0.9,-2 -2,-2s-2,0.9 -2,2H8c0,-2.21 1.79,-4 4,-4s4,1.79 4,4c0,0.88 -0.36,1.68 -0.93,2.25z</StreamGeometry>
        <!--  Telegram — бумажный самолётик (send). Устойчивый all-line путь (без арок).  -->
        <StreamGeometry x:Key="Meta.Telegram">M2.01,21L23,12 2.01,3 2,10l15,2 -15,2z</StreamGeometry>
        <!--  Корзина (ic_delete_24dp) — удалить ЭТУ подписку (тихий нейтральный глиф, темнеет на ховере).  -->
        <StreamGeometry x:Key="Meta.Trash">M6,19c0,1.1 0.9,2 2,2h8c1.1,0 2,-0.9 2,-2V7H6v12zM19,4h-3.5l-1,-1h-5l-1,1H5v2h14V4z</StreamGeometry>
    </UserControl.Resources>

    <UserControl.Styles>
        <!--  Шеврон-сворачивание (0° раскрыто, −90° свёрнуто, зеркалит Android bindHeader) вращается
              в code-behind через явный RotateTransform с ПЛАВНЫМ переходом угла. Центр задаём РОВНО
              ОДИН раз — через RenderTransformOrigin="50%,50%" самого глифа (ОТНОСИТЕЛЬНЫЙ центр = 10,10
              у 20px-глифа). ВАЖНО: «50%,50%», а НЕ «0.5,0.5»: последнее парсится как 0.5 ПИКСЕЛЯ ≈ угол,
              и шеврон облетал бы орбитой. RotateTransform.CenterX/Y держим на 0, чтобы центр НЕ удвоился
              (origin 10,10 + center 0 = 10,10 = центр глифа) — вращение строго на месте.  -->

        <!--  КОМПАКТ: узкое окно (~360-380) требует более плотной мета-карты, чем базовые 40/22.
              Денсифицируем ВСЕ иконочные действия строки-1 и нижней строки до бокса 34 с глифом 20
              (Android-пропорции: маленькие ~20px глифы в компактных боксах). Это локальные стили ЭТОГО
              вида (переопределяют глобальный Button.IconButton40), масштаб карточки — компактный, но
              цель касания 34 остаётся комфортной для мыши десктопа. Всё видимо, ничего не переполняет.  -->
        <Style Selector="Button.MetaIcon">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
        </Style>
        <Style Selector="Button.MetaIcon PathIcon">
            <!--  14, не 18: PathIcon растягивает чернила на весь бокс, и 18 выглядел заметно крупнее
                  эталона (замер чернил по кадрам: 12–15 при боксе 26–30). Бокс 30 не трогаем — цель
                  касания остаётся.  -->
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
        </Style>
        <!--  «Удалить подписку» — деструктив, но ТИХИЙ: глиф нейтральный (Brush.OnSurfaceVariant от
              IconButton40) в покое и лишь ЗАТЕМНЯЕТСЯ на шаг (Brush.OnSurfaceVariantHover) при
              наведении/нажатии — ровно как иконочная навигация. НИКАКОГО красного и НИКАКОЙ фон-плитки:
              разрушительность уже ясна из диалога-подтверждения. Поэтому здесь ещё и ГАСИМ hover-бокс
              базового IconButton40 (ContentPresenter → Transparent), чтобы темнел САМ глиф, а не всплывала
              плитка. Серый → mono-безопасен; тема (тёмная/светлая/mono) соблюдается через DynamicResource.  -->
        <Style Selector="Button.MetaDanger:pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariantHover}" />
        </Style>
        <Style Selector="Button.MetaDanger:pressed PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariantHover}" />
        </Style>
        <Style Selector="Button.MetaDanger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.MetaDanger:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <!--  Карточка подписки: Surface, 1px OutlineVariant, СКРУГЛЕНИЕ 16 (tokens.md «Скругления»:
          карточка 16). Глобальный Radius.Card = 20 достался ветке от прежней шкалы и им пользуются
          чужие экраны — поэтому здесь локальный именованный токен, а не магическое число в атрибуте;
          в GlobalResources его должен поднять владелец токенов (см. отчёт). Паддинг 12/14/14/14
          как в прототипе. Без вложенных карточек.  -->
    <Border
        x:Name="MetaCard"
        Classes="Card"
        CornerRadius="{StaticResource Radius.SubCard}"
        Padding="14,12,14,14">
        <StackPanel>

            <!--  ============ Строка 1: шеврон + заголовок/подзаголовок + действия ============  -->
            <Grid ColumnDefinitions="Auto,*,Auto">

                <!--  Шеврон-сворачивание серверов подписки. Бокс 40 — ≥ touch target, но САМ ГЛИФ
                      миниатюрный: PathIcon растягивает чернила на весь бокс, и 20 читались «огромной
                      толстой» кареткой (владелец). 14 — та же величина, что у прочих каретка/шевронов.
                      Отрицательный левый отступ −10 сдвигает кнопку ЛЕВЕЕ, к краю карточки: владелец
                      дважды просил подвинуть её влево, чтобы глиф встал по гутеру, а не «правее».  -->
                <Button
                    x:Name="CollapseButton"
                    Grid.Column="0"
                    Margin="-10,0,2,0"
                    Classes="IconButton40 MetaIcon"
                    Click="OnCollapseClick">
                    <PathIcon
                        x:Name="CollapseIcon"
                        Width="14"
                        Height="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="{StaticResource Meta.Chevron}"
                        Foreground="{DynamicResource Brush.OnSurfaceVariant}"
                        RenderTransformOrigin="50%,50%" />
                </Button>

                <!--  Заголовок (profile-title/remarks) + подзаголовок (last-update · автообновление).  -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="TitleText"
                        Classes="Title"
                        FontSize="15"
                        Text=""
                        TextTrimming="CharacterEllipsis" />
                    <!--  Подзаголовок несёт дату/время последнего обновления — цифрам даём
                          Font.Numeric + tnum (табличные, слэш-ноль), буквы не затрагиваются.  -->
                    <TextBlock
                        x:Name="SubtitleText"
                        Margin="0,3,0,0"
                        Classes="Caption"
                        FontSize="11"
                        FontFamily="{DynamicResource Font.Numeric}"
                        FontFeatures="tnum,lnum,zero"
                        Text=""
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!--  Действия: пинг → обновить → пин → удалить. Компактные иконки (бокс 34, глиф 18).  -->
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <!--  Пинг: на время замера глиф В ТОМ ЖЕ слоте сменяется вращающимся кругом
                          (motion.md «Пинг и обновление подписки»), поэтому вокруг ничего не двигается.  -->
                    <Button
                        x:Name="PingButton"
                        Classes="IconButton40 Row Accent MetaIcon">
                        <Panel>
                            <PathIcon
                                x:Name="PingIcon"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="{StaticResource Meta.Ping}" />
                            <Ellipse
                                x:Name="PingSpinner"
                                Width="16"
                                Height="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Classes="Spinner"
                                IsVisible="False"
                                Stroke="{DynamicResource Brush.Accent}"
                                StrokeDashArray="6.3,18.8"
                                StrokeLineCap="Round"
                                StrokeThickness="2">
                                <!--  Явный центр вращения (половина 16 = 8): глобальный
                                      Ellipse.Spinner.spinning крутит RotateTransform.Angle, а origin
                                      к этому пути не применяется — без CenterX/CenterY дуга «облетала».  -->
                                <Ellipse.RenderTransform>
                                    <RotateTransform
                                        Angle="0"
                                        CenterX="8"
                                        CenterY="8" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Panel>
                    </Button>
                    <!--  Обновить: во время обновления глиф В ТОМ ЖЕ слоте заменяется компактным
                          спиннером-дугой (никакого растущего прогресс-бара, ничего вокруг не сдвигается).  -->
                    <Button
                        x:Name="RefreshButton"
                        Classes="IconButton40 Row Accent MetaIcon">
                        <Panel>
                            <PathIcon
                                x:Name="RefreshIcon"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="{StaticResource Meta.Refresh}" />
                            <Ellipse
                                x:Name="RefreshSpinner"
                                Width="16"
                                Height="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Classes="Spinner"
                                IsVisible="False"
                                Stroke="{DynamicResource Brush.Accent}"
                                StrokeDashArray="6.3,18.8"
                                StrokeLineCap="Round"
                                StrokeThickness="2">
                                <!--  Явный центр вращения (половина 16px = 8): глобальный
                                      Ellipse.Spinner.spinning крутит RotateTransform.Angle, а origin
                                      к этому пути не применяется — без CenterX/CenterY дуга «облетала».  -->
                                <Ellipse.RenderTransform>
                                    <RotateTransform
                                        Angle="0"
                                        CenterX="8"
                                        CenterY="8" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Panel>
                    </Button>
                    <Button
                        x:Name="PinButton"
                        Classes="IconButton40 Row MetaIcon">
                        <!--  Foreground = OnSurfaceVariant (не закреплено) / Accent (закреплено).  -->
                        <PathIcon
                            x:Name="PinIcon"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="{StaticResource Meta.Pin}"
                            Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
                    </Button>
                    <!--  Удалить ЭТУ подписку (SubItem + её серверы) с подтверждением. Заменяет прежний
                          «+» (добавление переехало в верхний-правый угол приложения — другой агент).
                          Тихий нейтральный глиф-корзина (темнеет на ховере, без красного); виден лишь у
                          реальной подписки (как обновить/пин). Деструктивность ясна из диалога-подтверждения.  -->
                    <Button
                        x:Name="DeleteButton"
                        Classes="IconButton40 Row MetaIcon MetaDanger">
                        <PathIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="{StaticResource Meta.Trash}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!--  ============ Тело (только у реальной подписки): трафик + announce + поддержка ============  -->
            <StackPanel x:Name="MetaBody">

                <!--  Строка 2: трафик-пилюля (по центру) + expiry-маркер. Две строки-слота:
                      code-behind (ApplyTrafficLayout по фактической ширине) кладёт expiry на
                      ОДНУ линию справа от пилюли в широком макете, а в КОМПАКТЕ (~372) уводит
                      его на свою строку под пилюлю — так дата и пилюля НИКОГДА не налезают друг
                      на друга и обе читаются целиком. Резервируем место сеткой (нет сдвига CLS).  -->
                <!--  Пилюля трафика (screens.md): значение слева 12/500, срок справа, под ними
                      линия 2 с заливкой по доле. Не «текст внутри залитой капсулы», а строка данных
                      с тонким индикатором — цифры читаются на фоне карточки, а не на градиенте.
                      Линия лежит В СВОЁМ ряду (не абсолютом поверх текста), поэтому ничего не
                      наезжает друг на друга ни в какой ширине.  -->
                <Grid
                    x:Name="TrafficRow"
                    Margin="0,12,0,0"
                    RowDefinitions="Auto,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                        <TextBlock
                            x:Name="TrafficText"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Classes="Numeric"
                            FontFamily="{DynamicResource Font.Numeric}"
                            FontFeatures="tnum,lnum,zero"
                            FontSize="12"
                            FontWeight="Medium"
                            Text="" />
                        <!--  Срок: «∞» / «до dd.MM.yyyy» / «Просрочено» (красный) — данные подписки.
                              Строку/выравнивание назначает code-behind: широкий макет — справа на
                              одной линии со значением, компакт — своя строка под линией.  -->
                        <TextBlock
                            x:Name="ExpiryText"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Classes="Caption"
                            FontFamily="{DynamicResource Font.Numeric}"
                            FontFeatures="tnum,lnum,zero"
                            Text="" />
                    </Grid>

                    <!--  Линия 2: трек во всю ширину + заливка по доле трафика. Ширину заливки
                          (доля × живая ширина трека) и её кисть назначает code-behind, поэтому
                          индикатор верен при любой ширине колонки и в любой из трёх тем.  -->
                    <Border
                        x:Name="TrafficTrack"
                        Grid.Row="1"
                        Height="2"
                        Margin="0,6,0,0"
                        Background="{DynamicResource Brush.SurfaceVariant}"
                        ClipToBounds="True"
                        CornerRadius="1">
                        <Border
                            x:Name="TrafficFill"
                            Width="0"
                            HorizontalAlignment="Left"
                            CornerRadius="1">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Width" Duration="0:0:0.5">
                                        <DoubleTransition.Easing>
                                            <SplineEasing X1="0.25" Y1="1" X2="0.5" Y2="1" />
                                        </DoubleTransition.Easing>
                                    </DoubleTransition>
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                    </Border>
                </Grid>

                <!--  Announce-баннер подписки (по центру, приглушённый). Скрыт, если пусто. Переносится и
                      показывается ЦЕЛИКОМ: карточка — вертикальный StackPanel без фикс-высоты, поэтому
                      растёт под текст. Прежний MaxLines=4 + многоточие обрезали промо в компактной ширине
                      (~372): первая строка переносится на две, и «@departamentvpn» уезжал за нижний край.
                      Теперь без ограничения строк и без троеточия — провайдерский текст виден полностью
                      в любой ширине и в любом состоянии (свёрнуто/развёрнуто).  -->
                <TextBlock
                    x:Name="AnnounceText"
                    Margin="0,10,0,0"
                    Classes="Caption"
                    FontSize="11.5"
                    LineHeight="17.8"
                    Text=""
                    TextAlignment="Center"
                    TextTrimming="None"
                    TextWrapping="Wrap" />

                <!--  Нижняя строка: тональная «Поддержка» слева + Telegram справа (противоположные углы).
                      Скрыта целиком, когда провайдер не прислал ни support-url, ни web-page-url.  -->
                <Grid
                    x:Name="ActionRow"
                    Margin="0,10,0,0"
                    ColumnDefinitions="Auto,*,Auto">
                    <!--  «Поддержка»: компактная КОНТУРНАЯ пилюля. Была синим контейнером акцента, но
                          владелец убрал синие заливки с кнопок вообще («фона не должно быть синего
                          ваще»), взяв за образец контурную «Пополнить». Высота 30 → радиус 15.  -->
                    <Button
                        x:Name="SupportButton"
                        Grid.Column="0"
                        Height="30"
                        Padding="14,0,18,0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderBrush="{DynamicResource Brush.Accent}"
                        BorderThickness="1.5"
                        CornerRadius="{DynamicResource Radius.Pill30}"
                        Classes="Tonal"
                        FontSize="12"
                        Foreground="{DynamicResource Brush.Accent}">
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6">
                            <PathIcon
                                Width="15"
                                Height="15"
                                Data="{StaticResource Meta.Support}"
                                Foreground="{DynamicResource Brush.Accent}" />
                            <TextBlock VerticalAlignment="Center" Text="{loc:T Sub_Support}" />
                        </StackPanel>
                    </Button>

                    <!--  Telegram (правый нижний угол): компактная иконка-кнопка, tint Accent.  -->
                    <!--  Telegram — единственный глиф со своим фирменным цветом: токен Brush.Telegram
                          (#2AABEE в тёмной и светлой, белый в чёрно-белой). Именно поэтому здесь НЕ
                          класс Accent — иначе самолётик стал бы синим акцентом приложения.  -->
                    <Button
                        x:Name="TelegramButton"
                        Grid.Column="2"
                        Classes="IconButton40 Row MetaIcon"
                        VerticalAlignment="Center">
                        <PathIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="{StaticResource Meta.Telegram}"
                            Foreground="{DynamicResource Brush.Telegram}" />
                    </Button>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
