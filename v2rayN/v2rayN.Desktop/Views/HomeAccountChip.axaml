<UserControl
    x:Class="v2rayN.Desktop.Views.HomeAccountChip"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:v2rayN.Desktop.Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignWidth="408"
    mc:Ignorable="d">

    <!--  ================================================================================
          ЧИП АККАУНТА — ЕДИНОЕ определение (CA-1). Раньше жил инлайном в HomeView; вынесен
          сюда, чтобы широкая («Главная») и компактная (CompactHomeView) раскладки делили ОДНУ
          разметку и поведение (аватар-инициал + @handle + «Управление аккаунтом» + шеврон).

          Виден ТОЛЬКО при входе (AccountSession.State, read-only): управляет своей видимостью
          сам (this.IsVisible), поэтому пустой слот в родителе схлопывается. Тап / Enter / Space →
          событие AccountRequested, которое хост превращает в открытие вкладки «Аккаунт» (рейл в
          широкой, нижняя навигация в компактной). Данные не выдумываем — только реальная сессия.

          Фаза 3: (1) СКЕЛЕТОН, пока вошли, но имя/аватар ещё не разрешились (холодный старт до
          прихода профиля) — вместо «выскакивания готовой» строки; (2) фокус-с-клавиатуры
          (Focusable + Enter/Space) с авто-кольцом FocusAdorner (Border.AccountChip); (3) центр
          press-scale (RenderTransformOrigin 50%,50%); (4) вход при разрешении аккаунта
          (opacity 0→1 + translateY 8→0, задержка ~120мс) — под .lite всё мгновенно.
          =================================================================================  -->

    <UserControl.Styles>
        <!--  Строка-поверхность: hover = subtle darken (SurfaceHigh), НЕ белый glow. Press scale 0.99
              ОТ ЦЕНТРА (50%,50% — относительный центр; абсолютный 0.5,0.5 ≈ 0.5px сжал бы из угла,
              репо-правило GlobalStyles Border.ConnectDisc/ServerRow).  -->
        <Style Selector="Border.AccountChip">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.OutlineVariant}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.AccountChip:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHigh}" />
        </Style>
        <Style Selector="Border.AccountChip.pressed">
            <Setter Property="RenderTransform" Value="scale(0.99)" />
        </Style>

        <!--  Скелет-круг аватара (40): нейтральный SurfaceHighest (не синий Tile), пульс несёт
              родитель (SkeletonContent.SkeletonPulse — авто-статичен под .lite).  -->
        <Style Selector="Border.SkelAvatar">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="100" />
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHighest}" />
        </Style>
    </UserControl.Styles>

    <Border
        x:Name="ChipRoot"
        Height="64"
        Classes="AccountChip"
        Focusable="True"
        Padding="10,8,16,8"
        KeyDown="OnChipKeyDown"
        PointerExited="OnChipExited"
        PointerPressed="OnChipPressed"
        PointerReleased="OnChipReleased"
        Tapped="OnChipTapped">
        <Panel>
            <!--  ==================== Разрешённая строка (аватар · имя · шеврон) ====================  -->
            <Grid x:Name="RealContent" ColumnDefinitions="Auto,*,Auto">
                <Border
                    Grid.Column="0"
                    Width="40"
                    Height="40"
                    Classes="Avatar">
                    <TextBlock
                        x:Name="AccountInitial"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource Font.Grotesk}"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="{DynamicResource Brush.Accent}"
                        Text="" />
                </Border>
                <StackPanel
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Spacing="1">
                    <TextBlock
                        x:Name="AccountName"
                        Classes="Title"
                        Text=""
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="Caption" Text="{loc:T Home_ManageAccount}" />
                </StackPanel>
                <PathIcon
                    Grid.Column="2"
                    Width="18"
                    Height="18"
                    VerticalAlignment="Center"
                    Data="{StaticResource Geo.ChevronRight}"
                    Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
            </Grid>

            <!--  ==================== Скелетон (вошли, но имя/аватар ещё не разрешились) ====================
                  Класс SkeletonPulse навешивает code-behind ТОЛЬКО пока скелет показан (не пульсируем за
                  кадром); под .lite глобальный селектор гасит пульс → статичная непрозрачность.  -->
            <Grid
                x:Name="SkeletonContent"
                VerticalAlignment="Center"
                ColumnDefinitions="Auto,*"
                IsVisible="False">
                <Border Grid.Column="0" Classes="SkelAvatar" />
                <Border
                    Grid.Column="1"
                    Width="120"
                    Margin="12,0,0,0"
                    HorizontalAlignment="Left"
                    Classes="SkelBar" />
            </Grid>
        </Panel>
    </Border>
</UserControl>
