<UserControl
    x:Class="v2rayN.Desktop.Views.BackupPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:v2rayN.Desktop.Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignWidth="800"
    d:DesignHeight="520"
    mc:Ignorable="d">

    <!--  Фон НЕ задан: подэкран прозрачный, шелл под ним погашен (ApplySubPageShellGate).  -->

    <UserControl.Styles>
        <StyleInclude Source="avares://departament/Assets/SubScreenStyles.axaml" />
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <!--  Колонка подэкрана: карточки 720 + поля по 20 = внешний габарит 760, как в прототипе
              (`max-width:760;padding:0 20px`). В Avalonia Margin лежит СНАРУЖИ MaxWidth, поэтому
              ту же геометрию даёт 720 + поля 20 — ровно как в колонке вкладки настроек, чтобы
              карточки не меняли ширину при входе в подэкран.
              Выравнивание Stretch, а НЕ Center — см. SubScreenStyles.axaml, «Ширина колонки»:
              Center отдаёт панели её желаемую ширину, и карточка съёживается по самой длинной
              строке, у каждого экрана до своей.  -->
        <StackPanel
            MaxWidth="720"
            Margin="20,10,20,20"
            HorizontalAlignment="Stretch">

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button
                    x:Name="btnBack"
                    Classes="SubBack">
                    <PathIcon
                        Width="22"
                        Height="22"
                        Data="{DynamicResource Geo.Sub.Back}"
                        Foreground="{DynamicResource Brush.OnSurface}" />
                </Button>
                <TextBlock Classes="SubTitle" Text="{loc:T Settings_Backup}" />
            </StackPanel>
            <TextBlock
                Margin="0,8,0,0"
                Classes="SubNote"
                Text="{loc:T Backup_Intro}" />

            <!--  ==================== Данные ====================  -->
            <TextBlock Classes="SubGroupLabel" Text="{loc:T Backup_SecData}" />
            <Border Classes="SubCard">
                <StackPanel>
                    <Border x:Name="RowExport" Classes="SubRow tap">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Classes="SubTile">
                                <PathIcon Data="{DynamicResource Geo.Sub.Backup}" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                Margin="16,0,12,0"
                                VerticalAlignment="Center">
                                <TextBlock Classes="SubName" Text="{loc:T Backup_SaveCopy}" />
                                <TextBlock
                                    Classes="SubSub"
                                    Text="{loc:T Backup_SaveCopyHint}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <PathIcon
                                Grid.Column="2"
                                Classes="SubChevron"
                                Data="{DynamicResource Geo.Sub.Chevron}" />
                        </Grid>
                    </Border>

                    <Border Classes="SubDivider" />

                    <!--  Восстановление заменяет текущие серверы и перезапускает приложение — это
                          сказано подписью строки, а не спрятано в подтверждении после нажатия.  -->
                    <Border x:Name="RowImport" Classes="SubRow tap">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Classes="SubTile">
                                <PathIcon Data="{DynamicResource Geo.Sub.Refresh}" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                Margin="16,0,12,0"
                                VerticalAlignment="Center">
                                <TextBlock Classes="SubName" Text="{loc:T Backup_RestoreFile}" />
                                <TextBlock
                                    Classes="SubSub"
                                    Text="{loc:T Backup_RestoreFileHint}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <PathIcon
                                Grid.Column="2"
                                Classes="SubChevron"
                                Data="{DynamicResource Geo.Sub.Chevron}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!--  ==================== Облако ====================
                  Строка ведёт на подэкран WebDAV: адрес, логин, папка и выгрузка/загрузка копии.
                  Подпись — живое состояние: адрес сервера либо «Не настроено».  -->
            <TextBlock Classes="SubGroupLabel" Text="{loc:T Backup_SecCloud}" />
            <Border Classes="SubCard">
                <Border x:Name="RowWebDav" Classes="SubRow tap">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0" Classes="SubTile">
                            <PathIcon Data="{DynamicResource Geo.Sub.Lock}" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            Margin="16,0,12,0"
                            VerticalAlignment="Center">
                            <TextBlock Classes="SubName" Text="{loc:T Backup_WebDav}" />
                            <TextBlock x:Name="txtWebDavState" Classes="SubSub" />
                        </StackPanel>
                        <PathIcon
                            Grid.Column="2"
                            Classes="SubChevron"
                            Data="{DynamicResource Geo.Sub.Chevron}" />
                    </Grid>
                </Border>
            </Border>

            <TextBlock x:Name="txtStatus" Classes="SubFoot" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
