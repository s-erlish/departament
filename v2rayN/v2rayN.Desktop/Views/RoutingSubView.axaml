<UserControl
    x:Class="v2rayN.Desktop.Views.RoutingSubView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:v2rayN.Desktop.Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:v="clr-namespace:v2rayN.Desktop.Views"
    d:DesignWidth="800"
    d:DesignHeight="680"
    mc:Ignorable="d">

    <!--  Фон НЕ задан: подэкран прозрачный, шелл под ним погашен (ApplySubPageShellGate).  -->

    <UserControl.Resources>
        <!--  «8 правил» / «4 правила» — склонение по числу (L.Plural) поверх целочисленного RuleNum.  -->
        <v:RuleCountConverter x:Key="RuleCountConverter" />
        <!--  Встроенные наборы движка — по-русски; наборы пользователя — как есть.  -->
        <v:RoutingNameConverter x:Key="RoutingNameConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <StyleInclude Source="avares://departament/Assets/SubScreenStyles.axaml" />

        <!--  Каретка строки «Разрешение доменов»: поворот на 180° за 300 мс, пока окошко открыто.  -->
        <Style Selector="PathIcon.StrategyCaret">
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Duration="0:0:0.30" Property="RenderTransform" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="PathIcon.StrategyCaret.open">
            <Setter Property="RenderTransform" Value="rotate(180deg)" />
        </Style>
        <!--  Значение гаснет до приглушённого, пока окошко открыто (motion.md).  -->
        <Style Selector="TextBlock.StrategyValue.open">
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <!--  Колонка подэкрана: карточки 720 + поля по 20 = внешний габарит 760, как в прототипе
              (`max-width:760;padding:0 20px`). В Avalonia Margin лежит СНАРУЖИ MaxWidth, поэтому
              ту же геометрию даёт 720 + поля 20 — ровно как в колонке вкладки настроек, чтобы
              карточки не меняли ширину при входе в подэкран.
              Выравнивание Stretch, а НЕ Center — см. SubScreenStyles.axaml, «Ширина колонки»:
              Center отдаёт панели её желаемую ширину, и карточка съёживается по самой длинной
              строке, у каждого экрана до своей.  -->
        <StackPanel
            MaxWidth="720"
            Margin="20,10,20,20"
            HorizontalAlignment="Stretch">

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button
                    x:Name="btnBack"
                    Classes="SubBack">
                    <PathIcon
                        Width="22"
                        Height="22"
                        Data="{DynamicResource Geo.Sub.Back}"
                        Foreground="{DynamicResource Brush.OnSurface}" />
                </Button>
                <TextBlock Classes="SubTitle" Text="{loc:T Settings_Routing}" />
            </StackPanel>
            <!--  Пояснения под заголовком тут нет: на этом экране его нет и в эталонном кадре.
                  «Правила proxy, direct и block» уже сказано подписью строки, из которой сюда пришли.  -->

            <!--  ==================== Доменная стратегия ====================
                  Выбор из трёх — общее «окошко у значения», а не отдельный экран: шеврон обещал бы
                  страницу, на которой лежали бы те же три пункта.
                  ClipToBounds=False — контракт ValuePopup: карточка не имеет права обрезать окошко
                  нижней кромкой, поэтому углы маскирует сама строка (15 = 16 карточки минус контур).  -->
            <TextBlock Classes="SubGroupLabel" Text="{loc:T Routing_DomainStrategy}" />
            <Border Classes="SubCard" ClipToBounds="False">
                <Border
                    x:Name="RowStrategy"
                    Classes="SubRow tap"
                    CornerRadius="15">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <Border Grid.Column="0" Classes="SubTile">
                            <PathIcon Data="{DynamicResource Geo.Sub.Globe}" />
                        </Border>
                        <TextBlock
                            Grid.Column="1"
                            Margin="16,0,12,0"
                            VerticalAlignment="Center"
                            Classes="SubName"
                            Text="{loc:T Routing_DomainResolution}" />
                        <TextBlock
                            x:Name="txtStrategyValue"
                            Grid.Column="2"
                            Classes="SubValue strong StrategyValue" />
                        <PathIcon
                            x:Name="StrategyCaret"
                            Grid.Column="3"
                            Classes="SubChevron StrategyCaret"
                            Data="{DynamicResource Geo.Sub.Caret}" />

                        <!--  Компонент занимает 0×0 и не двигает раскладку строки.  -->
                        <v:ValuePopup
                            x:Name="StrategyPopup"
                            Grid.Column="3"
                            Anchor="{Binding #RowStrategy}"
                            PopupWidth="230"
                            Trigger="{Binding #RowStrategy}" />
                    </Grid>
                </Border>
            </Border>
            <TextBlock Classes="SubFoot" Text="{loc:T Routing_DomainHint}" />

            <!--  ==================== Наборы правил ====================
                  В ветке маршрутизация живёт НАБОРАМИ правил, а не отдельными строками proxy /
                  direct / block, как в прототипе: тап делает набор активным. Показывать три
                  фиксированные строки поверх этого значило бы врать про устройство экрана.
                  Строки «Добавить правило» тоже нет и не будет (решено владельцем): редактор правил
                  был отдельным окном, отдельных окон в приложении больше нет, и обещать кнопкой
                  экран, которого не существует, — хуже, чем её отсутствие.  -->
            <TextBlock Classes="SubGroupLabel" Text="{loc:T Routing_RuleSets}" />
            <Border x:Name="RulesCard" Classes="SubCard">
                <ItemsControl x:Name="listRoutings">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                            <StackPanel>
                                <Border Classes="SubDivider" IsVisible="{Binding ShowDivider}" />
                                <Border Classes="SubRow tap" Tapped="OnRoutingRowTapped">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Classes="SubTile">
                                            <PathIcon Data="{DynamicResource Geo.Sub.Routing}" />
                                        </Border>
                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="16,0,12,0"
                                            VerticalAlignment="Center">
                                            <TextBlock Classes="SubName" Text="{Binding Item.Remarks, Converter={StaticResource RoutingNameConverter}}" />
                                            <TextBlock Classes="SubSub" Text="{Binding Item.RuleNum, Converter={StaticResource RuleCountConverter}}" />
                                        </StackPanel>
                                        <!--  «Активен» — не чип, а значение строки: тот же слот справа,
                                              что у остальных подэкранов. Скрыт у неактивных целиком
                                              (а не прозрачен) — иначе его прочитал бы экранный диктор.
                                              Имя и подпись стоят в левой колонке и не съезжают.  -->
                                        <TextBlock
                                            Grid.Column="2"
                                            Classes="SubValue accent"
                                            IsVisible="{Binding Item.IsActive}"
                                            Text="{loc:T Routing_Active}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!--  Пустое состояние: наборов может не быть после сброса конфига.  -->
            <Border x:Name="RulesEmpty" Classes="SubEmpty" IsVisible="False">
                <StackPanel VerticalAlignment="Center" Spacing="12">
                    <Border Classes="SubEmptyTile">
                        <PathIcon Data="{DynamicResource Geo.Sub.Routing}" />
                    </Border>
                    <TextBlock Classes="SubEmptyTitle" Text="{loc:T Routing_NoRules}" />
                    <TextBlock Classes="SubEmptyText" Text="{loc:T Routing_DefaultRulesHint}" />
                </StackPanel>
            </Border>

            <!--  ==================== Обслуживание ====================  -->
            <TextBlock Classes="SubGroupLabel" Text="{loc:T Routing_Maintenance}" />
            <Border Classes="SubCard">
                <Border x:Name="RowResetRules" Classes="SubRow tap">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0" Classes="SubTile">
                            <PathIcon Data="{DynamicResource Geo.Sub.Refresh}" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            Margin="16,0,12,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                x:Name="txtResetRules"
                                Classes="SubName accent"
                                Text="{loc:T Routing_DefaultRules}" />
                            <TextBlock
                                Classes="SubSub"
                                Text="{loc:T Routing_DefaultRulesHint}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock
                            x:Name="txtResetState"
                            Grid.Column="2"
                            Classes="SubValue" />
                    </Grid>
                </Border>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
