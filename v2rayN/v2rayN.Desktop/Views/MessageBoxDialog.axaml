<Window
    x:Class="v2rayN.Desktop.Views.MessageBoxDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    Background="Transparent"
    Cursor="Arrow"
    CanResize="False"
    FontFamily="{DynamicResource Font.Grotesk}"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    TransparencyLevelHint="Transparent"
    WindowDecorations="None"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <!--
        Incy-подтверждение (замена стокового OS/v2rayN-диалога). ОБЩИЙ для всех yes/no
        (удаление сервера/подписки/правил и пр.), поэтому оформлен глобально-и-безопасно
        токенами Incy. Хрома OS-заголовка нет (WindowDecorations=None), поэтому «v2rayN» из
        заголовка исчезает — сам вопрос ЕСТЬ заголовок. Окно ПРОЗРАЧНО (Background=Transparent +
        TransparencyLevelHint=Transparent) — раньше здесь стоял непрозрачный Brush.Bg, и он рисовал
        за скруглённой карточкой ЧЁРНЫЙ ПРЯМОУГОЛЬНИК с прямыми углами: его владелец и видел вокруг
        диалога. Тот же приём уже держит главное окно. Видимое — только карточка Surface:
        radius_card 20, 1px OutlineVariant, мягкая тень (читается плавающей).
        Утвердительная — акцентная Primary (годится и для не-деструктивных подтверждений),
        «Отмена» — тональная. Тема (тёмная/светлая/mono) соблюдается через DynamicResource.
    -->

    <Border
        Margin="16"
        Padding="24"
        Background="{DynamicResource Brush.Surface}"
        BorderBrush="{DynamicResource Brush.OutlineVariant}"
        BorderThickness="1"
        BoxShadow="0 16 40 0 #73000000"
        CornerRadius="{DynamicResource Radius.Card}">
        <StackPanel Width="300" Spacing="24">

            <!--  Вопрос = заголовок диалога: OnSurface, sentence-case, перенос; длинный текст скроллится.  -->
            <ScrollViewer
                MaxHeight="280"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <TextBlock
                    x:Name="txtMessage"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource Brush.OnSurface}"
                    LineHeight="24"
                    TextWrapping="Wrap" />
            </ScrollViewer>

            <!--  Действия: «Отмена» (тональная) слева · «Подтвердить» (акцентная) справа.  -->
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="12">
                <Button
                    x:Name="btnNo"
                    MinWidth="96"
                    Padding="18,0"
                    Classes="Tonal"
                    Content="{x:Static resx:ResUI.TbCancel}"
                    IsCancel="True" />
                <Button
                    x:Name="btnYes"
                    MinWidth="112"
                    Padding="18,0"
                    Classes="Primary"
                    Content="{x:Static resx:ResUI.TbConfirm}"
                    IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
