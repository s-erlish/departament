<UserControl
    x:Class="v2rayN.Desktop.Views.ConnectHeroView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:v2rayN.Desktop.Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:v2rayN.Desktop.Views"
    d:DesignHeight="680"
    d:DesignWidth="560"
    mc:Ignorable="d">

    <!--  ================================================================================
          Connect-щит (герой) + стата-строка — правая панель «Главной».
          Перенос 1:1 из Android (activity_main.xml hero + MainActivity connect-состояния).
          Слои снизу вверх: glow → 2 кольца → сонар → connecting-дуга → диск(176)+щит.
          Состояния (idle/connecting/connected) и режим «нет подписки» переключает
          код-behind по данным будущего HomeViewModel — разметка чисто визуальная.
          Дизайн: Incy (pure dark + один синий #4C8DFF), ease-out анимации, без bounce.
          =================================================================================  -->

    <UserControl.Styles>
        <!--  КОМЕТА (motion.md «Кнопка подключения»): один оборот 1500 мс, СТРОГО ЛИНЕЙНО — ни
              разгона, ни торможения. Комета — не отдельная дуга, а само активное кольцо, окрашенное
              по углу (см. views:CometRing): вращаем ЕГО, поэтому свет бежит ПО кольцу, а не рядом.  -->
        <Style Selector="views|CometRing.Comet.spinning">
            <Style.Animations>
                <Animation
                    Duration="0:0:1.5"
                    Easing="LinearEasing"
                    IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!--  Glow «дышит» пока класс .breathing (connecting): scale 0.96↔1.04, alpha 0.3↔0.6.  -->
        <Style Selector="Ellipse.Glow.breathing">
            <Style.Animations>
                <Animation
                    Duration="0:0:0.85"
                    Easing="SineEaseInOut"
                    IterationCount="Infinite"
                    PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0.96" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.96" />
                        <Setter Property="Opacity" Value="0.3" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.04" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1.04" />
                        <Setter Property="Opacity" Value="0.6" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!--  Connecting «дыхание» щита: пока класс .shieldbreathe (connecting), контур-щит
              (уже залит акцентом) мягко пульсирует alpha 1↔0.8 в УНИСОН с glow-breathe (те же
              850мс sine, PlaybackDirection=Alternate) → две синхронные волны читаются как ОДИН
              спокойный вдох, а не как две суеты. ЭТО ТОЛЬКО OPACITY — ни transform, ни центра:
              физически не может «улететь» из угла (в отличие от scale/rotate). Снимается код-behind
              на выходе из connecting (иначе перекрыл бы crossfade контур→залив на connected).  -->
        <Style Selector="Path.shieldbreathe">
            <Style.Animations>
                <Animation
                    Duration="0:0:0.85"
                    Easing="SineEaseInOut"
                    IterationCount="Infinite"
                    PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.8" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!--  Подтверждение подключения (master plan 5.3.6): ОДНО кольцо от активного кольца, scale
              1→1.35 и alpha 0.6→0 за emphasis (600мс), ease_out_quint (0.22,1,0.36,1 = Ease.OutQuint),
              ОДИН РАЗ на подключение. Второго кольца нет: раньше за ведущим (1→1.6 с полной яркости)
              шло эхо, и вместе они вылетали далеко за кадр героя.  -->
        <Style Selector="Ellipse.Sonar.pulsing">
            <Style.Animations>
                <Animation
                    Duration="0:0:0.6"
                    FillMode="Forward"
                    IterationCount="1">
                    <!--  Ease.OutQuint (0.22,1,0.36,1) — инлайн, чтобы не зависеть от скоупа стиля.  -->
                    <Animation.Easing>
                        <SplineEasing X1="0.22" Y1="1" X2="0.36" Y2="1" />
                    </Animation.Easing>
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                        <Setter Property="Opacity" Value="0.6" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.35" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1.35" />
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!--  ============================ Ambient «живой» слой ============================
              Медленный низкоконтрастный фон-пульс вокруг щита, чтобы герой «дышал» и в ПОКОЕ
              (выбор сервера / не подключено) И в CONNECTED — не застывшая картинка. ОДИН синий
              акцент (Brush.Ring.Inner → mono схлопывает в серый, light приглушает), ~5-6с петли,
              тема-корректно. Два слоя не в фазе (6с вдох + 6.5с волна) читаются как «живое», а не
              «суетливое». Полностью снимается код-behind в lite/reduced-motion, на паузе окна и в
              онбординге «нет подписки». Все элементы IsHitTestVisible=False и лежат ПОД диском.  -->

        <!--  (A) Дышащее кольцо — медленный вдох scale+alpha (Alternate), калм в idle.
              Голый ScaleTransform без центра → origin «50%,50%» (как GlowHalo/сонар).  -->
        <Style Selector="Ellipse.AmbientRing.breathe-idle">
            <Style.Animations>
                <Animation
                    Duration="0:0:6"
                    Easing="SineEaseInOut"
                    IterationCount="Infinite"
                    PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0.99" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.99" />
                        <Setter Property="Opacity" Value="0.35" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.04" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1.04" />
                        <Setter Property="Opacity" Value="0.7" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!--  Connected-вариант: чуть ярче + крупнее амплитуда + чуть быстрее (5с) = «активно».  -->
        <Style Selector="Ellipse.AmbientRing.breathe-live">
            <Style.Animations>
                <Animation
                    Duration="0:0:5"
                    Easing="SineEaseInOut"
                    IterationCount="Infinite"
                    PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                        <Setter Property="Opacity" Value="0.5" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.05" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1.05" />
                        <Setter Property="Opacity" Value="0.95" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!--  (B) Покойный сонар — волна медленно расходится и гаснет. НЕ Alternate: alpha=0 на
              ОБОИХ концах цикла, поэтому на стыке scale снапается назад НЕВИДИМЫМ (нет «щелчка»).
              Пик alpha в первой трети → «выдох» наружу, длинный fade. Ease.OutQuint на всём.  -->
        <Style Selector="Ellipse.AmbientSonar.rest-idle">
            <Style.Animations>
                <Animation
                    Duration="0:0:6.5"
                    IterationCount="Infinite">
                    <Animation.Easing>
                        <SplineEasing X1="0.22" Y1="1" X2="0.36" Y2="1" />
                    </Animation.Easing>
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="18%">
                        <Setter Property="Opacity" Value="0.45" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.3" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1.3" />
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!--  Connected-вариант волны: ярче пик + чуть дальше + чуть быстрее (5.5с) = «активно».  -->
        <Style Selector="Ellipse.AmbientSonar.rest-live">
            <Style.Animations>
                <Animation
                    Duration="0:0:5.5"
                    IterationCount="Infinite">
                    <Animation.Easing>
                        <SplineEasing X1="0.22" Y1="1" X2="0.36" Y2="1" />
                    </Animation.Easing>
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="15%">
                        <Setter Property="Opacity" Value="0.6" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.34" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1.34" />
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!--  Cold-start «сборка» героя: ОДИН раз за процесс — scale 0.9→1 + alpha 0→1 за
              400мс, ease_out_quint, без овершута; оканчивается в покое (shield_assemble.xml).
              Навешивается код-behind по первому Loaded (статик-гвард), снимается после.  -->
        <Style Selector="Panel.assembling">
            <Style.Animations>
                <Animation
                    Duration="0:0:0.4"
                    FillMode="Forward"
                    IterationCount="1">
                    <!--  Ease.OutQuint (0.22,1,0.36,1) — инлайн (см. выше).  -->
                    <Animation.Easing>
                        <SplineEasing X1="0.22" Y1="1" X2="0.36" Y2="1" />
                    </Animation.Easing>
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0.9" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.9" />
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!--  Hover-lift диска (P0-1): наведение на диск поднимает поверхность на шаг (SurfaceHigh→
              Highest, тема-реактивно через DynamicResource) — БЕЗ scale и БЕЗ glow. Класс .hover
              навешивает код-behind (PointerEntered/Exited); плавность даёт BrushTransition на самом
              Border (120мс OutQuart в движении, 0мс в lite). Специфичнее базового Border.ConnectDisc
              (2 класса против 1) → перекрывает фон покоя, пока указатель над диском.  -->
        <Style Selector="Border.ConnectDisc.hover">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHighest}" />
        </Style>
    </UserControl.Styles>

    <!--  Корень прозрачный: панель лежит поверх радиального фона Главной (Brush.HomeGradient).  -->
    <Panel>

        <!--  ===================== СЛОЙ «есть подписка»: стата + герой ===================== -->
        <Grid x:Name="LayerNormal">

            <!--  Герой-блок: щит по центру панели; ПОД диском идут подпись состояния, компактная
                  стата-строка (↑ отдача · аптайм · ↓ приём) и идентичность сервера. Стата-строка
                  переехала с верха панели СЮДА — под щит, над именем сервера (как на телефоне);
                  верхний ряд «висел криво» на старте компакта. Центрирование по вертикали убирает
                  «щит висит высоко, снизу пусто» → выглядит ровно (spec §1.4).  -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <!--  Рамка 230×230, clip выключен: glow/сонар могут выходить за диск.  -->
                <!--  Cold-start «сборка» (Panel.assembling) масштабирует ГОЛЫЙ ScaleTransform 0.9→1
                      без собственного центра → он вращается вокруг RenderTransformOrigin. Значит origin
                      обязан быть ОТНОСИТЕЛЬНЫМ центром «50%,50%»; «0.5,0.5» = 0.5px ≈ угол → «сборка»
                      росла бы из левого-верхнего угла.  -->
                <!--  Размеры кадра / колец / диска / щита ставит ApplyHeroGeometry (одна таблица
                      пресетов, равные зазоры по построению) — в разметке диаметров нет.  -->
                <Panel
                    x:Name="HeroFrame"
                    HorizontalAlignment="Center"
                    ClipToBounds="False"
                    RenderTransformOrigin="50%,50%">

                    <!--  (0) Ambient «живой» слой (idle + connected): покойный сонар-волна + дышащее
                          кольцо. Лежат ПЕРВЫМИ в Panel → ПОД glow/кольцами/сонаром/дугой/диском, поэтому
                          не перекрывают тап по диску; IsHitTestVisible=False дублирует эту гарантию.
                          Голый ScaleTransform без центра → origin = относительный центр «50%,50%» (как
                          GlowHalo/SonarPulse), иначе пульс/волна росли бы из угла. Петли навешивает/снимает
                          код-behind (SetAmbient) — gated по lite/reduced-motion, паузе окна и онбордингу.  -->
                    <Ellipse
                        x:Name="AmbientSonar"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Classes="AmbientSonar"
                        IsHitTestVisible="False"
                        IsVisible="False"
                        Opacity="0"
                        RenderTransformOrigin="50%,50%"
                        Stroke="{DynamicResource Brush.Ring.Inner}"
                        StrokeThickness="1.5" />
                    <!--  Ambient-кольцо чуть внутри внешнего (кадр − g/2): пик вдоха (×1.04) читается
                          как ОДНО расходящееся кольцо наружу, а не биение впритык (де-муар).  -->
                    <Ellipse
                        x:Name="AmbientRing"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Classes="AmbientRing"
                        IsHitTestVisible="False"
                        IsVisible="False"
                        Opacity="0"
                        RenderTransformOrigin="50%,50%"
                        Stroke="{DynamicResource Brush.Ring.Inner}"
                        StrokeThickness="1.5" />

                    <!--  (1) glow-halo (bg_connect_glow) — виден только при connected.
                          «Дыхание» (Glow.breathing) масштабирует ГОЛЫЙ ScaleTransform без центра →
                          origin = относительный центр «50%,50%», иначе пульс рос бы из угла.  -->
                    <Ellipse
                        x:Name="GlowHalo"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Classes="Glow"
                        Fill="{DynamicResource Brush.ConnectGlow}"
                        IsVisible="False"
                        Opacity="0"
                        RenderTransformOrigin="50%,50%">
                        <!--  Reveal/hide glow: длительность+кривую перекл. код-behind по направлению
                              (reveal 300 OutQuint / hide 225 Standard). Здесь — forward-дефолт.  -->
                        <Ellipse.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.3">
                                    <!--  Ease.OutQuint (reveal). Код-behind перекл. на Standard при hide.  -->
                                    <DoubleTransition.Easing>
                                        <SplineEasing X1="0.22" Y1="1" X2="0.36" Y2="1" />
                                    </DoubleTransition.Easing>
                                </DoubleTransition>
                            </Transitions>
                        </Ellipse.Transitions>
                    </Ellipse>

                    <!--  (2) ТРИ концентрических кольца (tokens.md «Кольцо подключения»): внешнее лежит
                          по кромке рамки (отступ 0), среднее на отступе g, активное на 2g, диск на 3g.
                          Все четыре радиуса — ОДНА арифметическая прогрессия с шагом g = (кадр − диск)/6,
                          поэтому зазоры равны ПО ПОСТРОЕНИЮ и остаются равными на любом пресете размера
                          (230/166, 212/152, 190/138) — приёмка «кольца дают равные зазоры на всех
                          размерах». Ширины/высоты назначает ApplyHeroGeometry: единственный источник
                          правды — таблица пресетов, ни одного магического диаметра в разметке.
                          Толщины: внешнее и среднее 1.5, активное 2.5.  -->
                    <Ellipse
                        x:Name="RingOuter"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stroke="{DynamicResource Brush.Ring.Outer}"
                        StrokeThickness="1.5" />
                    <!--  Hover-brighten (P0-1): накладной дубль внешнего кольца, Opacity 0 в покое →
                          проявляется код-behind при наведении на диск (компоновщик-only fade, БЕЗ scale/
                          glow), усиливая кромку кольца. Так «brighten» не трогает утверждённый rest-вид
                          (RingOuter уже на Opacity 1) и остаётся чистым opacity-переходом. IsHitTestVisible
                          =False — никогда не перехватывает тап по диску; лежит ПОД диском.  -->
                    <Ellipse
                        x:Name="RingHoverGlow"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Opacity="0"
                        Stroke="{DynamicResource Brush.Ring.Inner}"
                        StrokeThickness="1.5" />
                    <Ellipse
                        x:Name="RingMid"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stroke="{DynamicResource Brush.Ring.Outer}"
                        StrokeThickness="1.5">
                        <Ellipse.Transitions>
                            <Transitions>
                                <BrushTransition Property="Stroke" Duration="0:0:0.3">
                                    <BrushTransition.Easing>
                                        <SplineEasing X1="0.25" Y1="1" X2="0.5" Y2="1" />
                                    </BrushTransition.Easing>
                                </BrushTransition>
                            </Transitions>
                        </Ellipse.Transitions>
                    </Ellipse>
                    <!--  Активное кольцо — то самое, ПО которому бежит комета (та же окружность, тот же
                          центр, та же толщина 2.5).  -->
                    <Ellipse
                        x:Name="RingActive"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stroke="{DynamicResource Brush.Ring.Outer}"
                        StrokeThickness="2.5">
                        <Ellipse.Transitions>
                            <Transitions>
                                <BrushTransition Property="Stroke" Duration="0:0:0.3">
                                    <BrushTransition.Easing>
                                        <SplineEasing X1="0.25" Y1="1" X2="0.5" Y2="1" />
                                    </BrushTransition.Easing>
                                </BrushTransition>
                            </Transitions>
                        </Ellipse.Transitions>
                    </Ellipse>

                    <!--  (3) одноразовый сонар-импульс на подтверждение connect.
                          Sonar.pulsing масштабирует ГОЛЫЙ ScaleTransform 1→1.6 без центра → origin =
                          относительный центр «50%,50%» (иначе кольцо расходилось бы из угла).  -->
                    <Ellipse
                        x:Name="SonarPulse"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Classes="Sonar"
                        IsVisible="False"
                        Opacity="0"
                        RenderTransformOrigin="50%,50%"
                        Stroke="{DynamicResource Brush.Ring.Inner}"
                        StrokeThickness="2" />

                    <!--  (4) КОМЕТА. Приёмка: «комета при подключении лежит НА активном кольце, а не
                          отдельной дугой рядом». Поэтому здесь НЕ дуга поверх кольца, а ТА ЖЕ окружность:
                          размер и толщина назначаются кода-behind ровно те же, что у RingActive (отступ 2g,
                          2.5), а свет по ней даёт коническая рампа внутри самого элемента (см. CometRing —
                          конический градиент разобран на дуги, потому что в Avalonia его нет). Видна только
                          при connecting; вращение — .spinning (1500 мс линейно).
                          Центр вращения: origin 0.5,0.5 + RotateTransform.CenterX/Y (половина кадра,
                          назначается в ApplyHeroGeometry) — оба указывают в геометрический центр, орбита
                          физически невозможна.  -->
                    <views:CometRing
                        x:Name="Comet"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Classes="Comet"
                        IsHitTestVisible="False"
                        IsVisible="False"
                        RenderTransformOrigin="0.5,0.5"
                        StrokeThickness="2.5">
                        <views:CometRing.RenderTransform>
                            <RotateTransform Angle="0" />
                        </views:CometRing.RenderTransform>
                    </views:CometRing>

                    <!--  (5) диск-кнопка (Border.ConnectDisc, SurfaceHigh). Диаметр и радиус ставит
                          ApplyHeroGeometry по таблице пресетов (166 / 152 / 138), а ступень прогиба —
                          константа DiscPressScale в код-behind (0.975, motion.md). Ни размера, ни
                          глубины нажатия в разметке нет: одно значение — одно место.
                          (6) внутри два щита: контур (idle, серый) + залив (connected, синий).  -->
                    <!--  Фон диска — тема-токен (Brush.SurfaceHigh): тёмный «колодец» на dark-теме,
                          светлая приподнятая плитка на light-теме, и серый на «Чёрно-белой» оверлее.
                          НЕ хардкодим #… — иначе диск оставался бы чёрным на light/mono (щит
                          терялся бы в черноте). Щит (idle=OnSurfaceVariant / connected=Accent)
                          гарантированно контрастирует с ним во всех 4 комбинациях.  -->
                    <!--  origin ОСТАВЛЕН «0.5,0.5» (=0.5px ≈ 0,0) НАМЕРЕННО: press-scale диска центрирует
                          себя САМ через self-centering TransformGroup в code-behind (translate −88 / scale /
                          translate +88, 88 = 176/2). Относительный «50%,50%» удвоил бы центр → диск в угол.  -->
                    <!--  Фон НЕ задаём локально: его ставит стиль Border.ConnectDisc (Brush.SurfaceHigh).
                          Локальный атрибут был бы LocalValue и перекрыл бы hover-стиль (.ConnectDisc.hover
                          = SurfaceHighest) — тогда наведение не поднимало бы поверхность. Стиль покоя даёт
                          тот же SurfaceHigh, поэтому вид покоя не меняется, а hover теперь работает.  -->
                    <Border
                        x:Name="ConnectDisc"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Classes="ConnectDisc"
                        Cursor="Arrow"
                        RenderTransformOrigin="0.5,0.5">
                        <Panel>
                            <!--  Press-«колодец» (P1-2): чёрный скрим 0→~12% при нажатии — диск темнеет
                                  «в лунку» под глифом (щит рисуется ПОВЕРХ, остаётся крепким). Эллипс
                                  ровно накрывает круг диска (176 = CornerRadius 88), поэтому не выходит
                                  за скруглённую кромку. IsHitTestVisible=False — тап идёт по диску.
                                  Переход (длительность/кривую) ведёт код-behind в унисон с press-scale.  -->
                            <!--  ОСОЗНАННОЕ ИСКЛЮЧЕНИЕ (00-rules §1.4.6), то же, что у скрима в
                                  «Устройствах»: это затемнение диска на нажатии, а не цвет. Живёт
                                  на Opacity 0 и приоткрывается кодом; в светлой теме оно тоже
                                  обязано быть чёрным, иначе не затемняет.  -->
                            <Ellipse
                                x:Name="PressScrim"
                                Fill="#000000"
                                IsHitTestVisible="False"
                                Opacity="0" />
                            <!--  Viewbox центрирует узкую геометрию щита в квадрате диска (Stretch+явные
                                  Width/Height у Path прижимали её к краю → щит уходил влево). Собственный
                                  self-centering ScaleTransform (parallax-dip 1.0→0.97 на press) ставит
                                  код-behind — глиф «вдавливается» в диск чуть глубже самого диска.  -->
                            <Viewbox
                                x:Name="ShieldViewbox"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Stretch="Uniform">
                          <Panel Width="24" Height="24">
                            <!--  Контур-щит (ic_shield_outline, evenodd-дырка): idle серый / connecting синий.  -->
                            <Path
                                x:Name="ShieldOutline"
                                Data="F0 M12,2.2 L19.6,5.2 L19.6,11.4 C19.6,16.1 15.9,19.9 12,21.8 C8.1,19.9 4.4,16.1 4.4,11.4 L4.4,5.2 Z M12,4.7 L17.2,6.8 L17.2,11.4 C17.2,14.9 14.7,17.9 12,19.3 C9.3,17.9 6.8,14.9 6.8,11.4 L6.8,6.8 Z"
                                Fill="{DynamicResource Brush.ShieldOff}">
                                <!--  Crossfade+tint: код-behind перекл. длительность 220↔165 (реверс 75%).
                                      ПОРЯДОК фиксирован: [0]=Opacity, [1]=Fill (см. code-behind).  -->
                                <Path.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.22">
                                            <DoubleTransition.Easing>
                                                <SplineEasing X1="0.2" Y1="0" X2="0" Y2="1" />
                                            </DoubleTransition.Easing>
                                        </DoubleTransition>
                                        <BrushTransition Property="Fill" Duration="0:0:0.22">
                                            <BrushTransition.Easing>
                                                <SplineEasing X1="0.2" Y1="0" X2="0" Y2="1" />
                                            </BrushTransition.Easing>
                                        </BrushTransition>
                                    </Transitions>
                                </Path.Transitions>
                            </Path>
                            <!--  Залив-щит (ic_shield_filled, тот же силуэт): crossfade-in при connect, синий.  -->
                            <Path
                                x:Name="ShieldFilled"
                                Data="M12,2.2 L19.6,5.2 L19.6,11.4 C19.6,16.1 15.9,19.9 12,21.8 C8.1,19.9 4.4,16.1 4.4,11.4 L4.4,5.2 Z"
                                Fill="{DynamicResource Brush.Accent}"
                                Opacity="0">
                                <!--  Залив: crossfade-in при connect (0→1), out при disconnect.
                                      Длительность 220↔165 перекл. код-behind ([0]=Opacity).  -->
                                <Path.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.22">
                                            <DoubleTransition.Easing>
                                                <SplineEasing X1="0.2" Y1="0" X2="0" Y2="1" />
                                            </DoubleTransition.Easing>
                                        </DoubleTransition>
                                    </Transitions>
                                </Path.Transitions>
                            </Path>
                          </Panel>
                            </Viewbox>
                        </Panel>
                    </Border>
                </Panel>

                <!--  Пилюля статуса (tokens.md «Пилюля статуса»): высота 30, скругление «пилюля»,
                      отступы 17, текст 14/500. Контурная: серый контур + приглушённый текст пока не
                      подключено, акцентный контур + акцентный текст когда подключаемся/подключено.
                      Цвета ведёт код-behind (SetConnectState), переходы — 300 мс ease-out-quart.

                      РАДИУС = ПОЛОВИНА ВЫСОТЫ (Radius.Pill30 = 15), а НЕ 100 из tokens.md. В CSS
                      браузер подрезает border-radius до идеальной пилюли на любой ширине; Avalonia
                      клампит радиус ПО КАЖДОЙ ОСИ ОТДЕЛЬНО, поэтому 100 на пилюле «Подключаемся…»
                      (~170×30) дало бы rx=85 / ry=15 — раздутый по бокам эллипс, а не пилюля.  -->
                <Border
                    x:Name="StatusPill"
                    Height="30"
                    Margin="0,18,0,0"
                    Padding="17,0"
                    HorizontalAlignment="Center"
                    BorderBrush="{DynamicResource Brush.ButtonOutline}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Pill30}">
                    <Border.Transitions>
                        <Transitions>
                            <BrushTransition Property="BorderBrush" Duration="0:0:0.3">
                                <BrushTransition.Easing>
                                    <SplineEasing X1="0.25" Y1="1" X2="0.5" Y2="1" />
                                </BrushTransition.Easing>
                            </BrushTransition>
                        </Transitions>
                    </Border.Transitions>
                    <TextBlock
                        x:Name="StatusText"
                        MaxWidth="300"
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource Font.Grotesk}"
                        FontSize="14"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Brush.OnSurfaceVariant}"
                        Text="{loc:T Home_NotConnected}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis">
                        <TextBlock.Transitions>
                            <Transitions>
                                <BrushTransition Property="Foreground" Duration="0:0:0.3">
                                    <BrushTransition.Easing>
                                        <SplineEasing X1="0.25" Y1="1" X2="0.5" Y2="1" />
                                    </BrushTransition.Easing>
                                </BrushTransition>
                            </Transitions>
                        </TextBlock.Transitions>
                    </TextBlock>
                </Border>

                <!--  Подсказка-ретрай: видна ТОЛЬКО в состоянии Error (§A4). Тихая аффорданс —
                      сам диск-щит остаётся кнопкой connect, поэтому тап по нему = повторная попытка.
                      Приглушённый OnSurfaceVariant, sentence-case, активный глагол. Скрыта по умолчанию;
                      видимость ведёт code-behind (RetryHint.IsVisible = state == Error).  -->
                <!--  Opacity=0 в покое; вход в Error плавно проявляет подсказку (fade 0→1, 220мс
                      Standard) — один спокойный сигнал, переход навешивает код-behind (lite = мгновенно).  -->
                <!--  Текст ведёт HomeViewModel.ConnectFailureHint: причина отказа + шаг дальше
                      (00-rules §9.4). Фраза длиннее одной строки, поэтому ПЕРЕНОС, а не обрезка:
                      обрезанная причина — это снова отказ без причины (§1.1 «Text that overflows»).  -->
                <TextBlock
                    x:Name="RetryHint"
                    Margin="24,6,24,0"
                    MaxWidth="320"
                    HorizontalAlignment="Center"
                    Classes="Caption"
                    Foreground="{DynamicResource Brush.OnSurfaceVariant}"
                    IsVisible="False"
                    LineHeight="18"
                    Opacity="0"
                    Text="{loc:T Home_RetryHint}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />

                <!--  Всё, что НИЖЕ пилюли статуса, приглушается до 45%, пока не подключено
                      (screens.md «Главная» → правая панель). Один общий контейнер вместо двух
                      независимых Opacity: скорости и имя сервера гаснут/зажигаются ОДНОЙ волной.  -->
                <StackPanel x:Name="HeroMeta">
                    <StackPanel.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.3">
                                <DoubleTransition.Easing>
                                    <SplineEasing X1="0.25" Y1="1" X2="0.5" Y2="1" />
                                </DoubleTransition.Easing>
                            </DoubleTransition>
                        </Transitions>
                    </StackPanel.Transitions>

                    <!--  Стата-строка ПОД пилюлей: ↑ отдача · аптайм · ↓ приём. Скрывается целиком в
                          «Облегчённом режиме» (владелец: «над кнопкой эти показатели должны пропадать»).  -->
                    <!--  Ячейки скоростей держат ширину САМОЙ длинной строки («99,9 МБ/с», её меряет
                          ReserveSpeedWidth), а значение прижато к таймеру: ↑ справа в своей ячейке,
                          ↓ слева. Без резерва строка центрировалась заново на каждом тике — таймер
                          ездил влево-вправо, как только менялась длина скорости, и вся колонка героя
                          перекладывалась раз в секунду.  -->
                    <StackPanel
                        x:Name="StatsRow"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="20">
                        <Panel x:Name="UpCell" VerticalAlignment="Center">
                            <StackPanel
                                x:Name="UpGroup"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="4">
                                <TextBlock
                                    x:Name="UpArrow"
                                    VerticalAlignment="Center"
                                    Classes="Caption"
                                    FontSize="11"
                                    Foreground="{DynamicResource Brush.Accent}"
                                    Text="↑" />
                                <TextBlock
                                    x:Name="UpSpeed"
                                    VerticalAlignment="Center"
                                    Classes="Numeric"
                                    FontSize="12.5"
                                    FontWeight="Bold" />
                            </StackPanel>
                        </Panel>
                        <TextBlock
                            x:Name="Uptime"
                            VerticalAlignment="Center"
                            Classes="Numeric"
                            FontSize="12.5"
                            FontWeight="Bold"
                            Foreground="{DynamicResource Brush.OnSurfaceVariant}"
                            Text="00:00:00" />
                        <Panel x:Name="DownCell" VerticalAlignment="Center">
                            <StackPanel
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="4">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Classes="Caption"
                                    FontSize="11"
                                    Foreground="{DynamicResource Brush.Accent}"
                                    Text="↓" />
                                <TextBlock
                                    x:Name="DownSpeed"
                                    VerticalAlignment="Center"
                                    Classes="Numeric"
                                    FontSize="12.5"
                                    FontWeight="Bold" />
                            </StackPanel>
                        </Panel>
                    </StackPanel>

                    <!--  Идентичность сервера: флаг + имя АКЦЕНТОМ (screens.md: «флаг и имя сервера
                          акцентом»). Протокол и транспорт живут в строке списка слева — здесь они
                          дублировались бы, поэтому под кольцом их нет.
                          Флаг по tokens.md «Строка сервера»: «в строке под кольцом 24 и 14» — круглая
                          плитка 24 и флаг 14 ВНУТРИ неё, а не флаг во всю плитку. Плитка читается
                          тонким кольцом вокруг флага и держит один силуэт для любой картинки: узкие
                          и широкие полотнища, глобус-заглушка и пустой слот занимают ровно один круг.  -->
                    <StackPanel
                        x:Name="ServerInfo"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="9">
                        <!--  Флаг-чип: круглая плитка 24 (радиус = половина = 12; «100» дало бы тот же
                              круг только потому, что бокс квадратный — но правило одно: половина
                              стороны). Внутри флаг 14 (tokens.md), заполняется FlagResolver (§5).  -->
                        <Border
                            x:Name="ServerFlag"
                            Width="24"
                            Height="24"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Brush.SurfaceVariant}"
                            ClipToBounds="True"
                            CornerRadius="12">
                            <Image
                                x:Name="ServerFlagImage"
                                Width="14"
                                Height="14"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Stretch="UniformToFill" />
                        </Border>
                        <TextBlock
                            x:Name="ServerName"
                            MaxWidth="260"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource Font.Grotesk}"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{DynamicResource Brush.Accent}"
                            Text=""
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!--  «+» в правом-верхнем углу connect-панели: добавить подписку (буфер / QR). Живёт в
                  углу шелла возле connect-области (владелец: «+» переехал сюда с мета-карты). В
                  компактной раскладке скрывается (SetCornerAddVisible(false)) — там свой «+» в шапке.
                  Меню — команды унаследованного HomeViewModel (те же, что «+» в компактной шапке).  -->
            <Button
                x:Name="CornerAddButton"
                Margin="0,12,16,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Classes="IconButton40">
                <!--  Глиф 16, а не 22: PathIcon растягивает чернила на весь бокс, и «плюс» выходил
                      заметно крупнее остальных иконок интерфейса (владелец: «плюсик сделай поменьше»).
                      Бокс кнопки 40 не трогаем — цель касания остаётся.  -->
                <PathIcon
                    Width="16"
                    Height="16"
                    Data="M11,5 H13 V11 H19 V13 H13 V19 H11 V13 H5 V11 H11 Z"
                    Foreground="{DynamicResource Brush.OnSurface}" />
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuItem Click="OnCornerAddClipboard" Header="{loc:T Common_AddFromClipboard}" />
                        <MenuItem Click="OnCornerAddQr" Header="{loc:T Common_AddViaQr}" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!--  ===================== СЛОЙ «нет подписки» (онбординг) — скрыт по умолчанию =====================
              Аналог Android updateHomeEmptyState: щит прячется, показывается приветствие +
              карточка-онбординг с двумя CTA. Тексты verbatim из strings(-ru).xml.  -->
        <StackPanel
            x:Name="LayerEmpty"
            MaxWidth="400"
            Margin="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsVisible="False">
            <TextBlock
                Margin="0,0,0,12"
                HorizontalAlignment="Center"
                Classes="Headline"
                Text="{loc:T Home_Welcome}"
                TextAlignment="Center" />
            <Border Classes="Card">
                <StackPanel>
                    <TextBlock
                        HorizontalAlignment="Center"
                        Classes="Title"
                        Text="{loc:T Home_NoSubs}" />
                    <TextBlock
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        Classes="Subtitle"
                        Text="{loc:T Home_NoSubsHint}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <!--  Первое действие — уйти в «Аккаунт» и купить подписку: серверы приезжают
                          сами, добавлять их руками новому человеку не с чего. Цвет НЕ Brush.OnAccent:
                          Primary давно рисуется обводкой, а не заливкой, и белая по замыслу подпись
                          на прозрачном фоне попросту не читалась — берём AccentText, как у самой
                          кнопки.  -->
                    <Button
                        x:Name="GoAccountButton"
                        Margin="0,24,0,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Classes="Primary">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path
                                Width="18"
                                Height="18"
                                VerticalAlignment="Center"
                                Data="M12 12 A4 4 0 1 0 12 4 A4 4 0 0 0 12 12 M4 21 V20 A6 6 0 0 1 10 14 H14 A6 6 0 0 1 20 20 V21"
                                Stretch="Uniform"
                                Stroke="{DynamicResource Brush.AccentText}"
                                StrokeJoin="Round"
                                StrokeLineCap="Round"
                                StrokeThickness="1.8" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource Brush.AccentText}"
                                Text="{loc:T Home_GoToAccount}" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="AddClipboardButton"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Classes="Tonal">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon
                                Width="16"
                                Height="16"
                                VerticalAlignment="Center"
                                Data="{StaticResource building_copy}"
                                Foreground="{DynamicResource Brush.OnSurface}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource Brush.OnSurface}"
                                Text="{loc:T Common_AddFromClipboard}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </Panel>
</UserControl>
