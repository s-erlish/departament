<UserControl
    x:Class="v2rayN.Desktop.Views.QrcodeView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--  ================================================================================
          QR сервера — единственный диалог этой дорожки, который в departament-оболочке ещё
          открывается (список серверов → «Поделиться»). Пакет редизайна о нём молчит, поэтому
          СОСТАВ не менялся: код и ссылка, и ничего больше. Приведена только подача.

          СВОЕЙ КАРТОЧКИ ЗДЕСЬ НЕТ. Подложку, скругление и скрим рисует сам DialogHost
          (MainWindow), и вторая карточка внутри неё дала бы ровно то вложение карточек,
          которое запрещено. Отсюда — только контент с отступом 20 и шагом 16.

          Плитка под кодом БЕЛАЯ и в тёмной теме тоже: QR читается сканером по контрасту, и
          «подкрасить его под тему» значит сломать саму функцию. Поле 12 вокруг кода — тихая
          зона стандарта, без неё код не считывается впритык к краю.
          =================================================================================  -->

    <StackPanel
        Width="300"
        Margin="20"
        Spacing="16">

        <!--  ОСОЗНАННОЕ ИСКЛЮЧЕНИЕ (00-rules §1.4.6). Белая подложка кода нужна СКАНЕРУ, а не теме:
              QR читается по контрасту тёмных модулей на светлом поле, и подложка, следующая за
              тёмной темой, делает код нечитаемым. Тематизировать тут нечего.  -->
        <Border
            Padding="12"
            HorizontalAlignment="Center"
            Background="#FFFFFF"
            CornerRadius="{DynamicResource Radius.Search}">
            <Image
                Name="imgQrcode"
                Width="252"
                Height="252" />
        </Border>

        <!--  Ссылка целиком: поле только для чтения, по фокусу выделяется целиком
              (code-behind), чтобы её можно было забрать копированием.

              БЕЗ темы TextBox.Incy: она однострочная по устройству — внутренний ScrollViewer
              шаблона жёстко «VerticalScrollBarVisibility=Disabled», а текст выровнен по центру
              строки. Ссылка на сервер в одну строку не влезает НИКОГДА, и в такой теме её видно
              на треть. Поэтому поле многострочное, а токены Incy (поверхность, контур, радиус 14)
              выставлены напрямую — тот же облик, но с переносом.  -->
        <TextBox
            x:Name="txtContent"
            MaxHeight="94"
            Padding="12,10"
            Background="{DynamicResource Brush.SurfaceVariant}"
            BorderBrush="{DynamicResource Brush.OutlineVariant}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.Search}"
            FontSize="12"
            Foreground="{DynamicResource Brush.OnSurface}"
            IsReadOnly="True"
            LineHeight="18"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            TextWrapping="Wrap"
            VerticalContentAlignment="Top" />

    </StackPanel>
</UserControl>
