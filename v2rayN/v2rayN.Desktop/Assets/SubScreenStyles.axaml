<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        ============================================================================================
        ЕДИНОЕ ЛЕКАЛО ПОДЭКРАНОВ (screens.md «Подэкраны», tokens.md «Строка настроек»/«Скругления»)
        ============================================================================================
        Один шаблон на все одиннадцать подэкранов настроек:

            кнопка назад 40 (смещена на −8 влево) → заголовок 22/700 → необязательное пояснение 13
            → группы карточек (заголовок группы 16/700 → карточка 16 со строками 56).

        Почему отдельный файл, а не копипаста в каждом .axaml: одиннадцать экранов с одинаковой
        геометрией — это одиннадцать мест, где лекало может разъехаться. Здесь оно одно. Файл
        подключается через `<StyleInclude Source="avares://departament/Assets/SubScreenStyles.axaml" />`
        в `<UserControl.Styles>` подэкрана (Assets\** уже в AvaloniaResource, регистрировать нечего).

        Assets/GlobalResources.axaml и Assets/GlobalStyles.axaml НЕ трогаются — они заняты. Всё, что
        нужно только подэкранам, живёт тут; общие вещи (TextBlock.Body/Subtitle, Brush.*) берутся оттуда.

        Скругления заданы ЧИСЛАМИ, а не Radius.Card/Radius.Tile: токены ветки (карточка 20, плитка 12)
        пока расходятся с tokens.md (карточка 16, плитка 10, поиск 14). Числа здесь = tokens.md.
        Цвета — ТОЛЬКО через DynamicResource: одна разметка, три темы.

        ── ШИРИНА КОЛОНКИ (правило разметки, не стиль — потому и живёт тут, в одном месте) ──
        Колонка подэкрана: `MaxWidth="720"` + `Margin="20,10,20,20"`, то есть карточки 720 и поля по
        20 — внешний габарит 760, как в прототипе (`max-width:760;padding:0 20px`). В Avalonia Margin
        лежит СНАРУЖИ MaxWidth, поэтому «760» из макета пишется здесь числом 720.
        Замер эталона (B_about_dark.png): карточка 720…2160 из 2732, то есть ровно 720 при 1366.
        Та же пара чисел стоит в колонке вкладки настроек — вход в подэкран не меняет ширину карточек.

        Выравнивание колонки — Stretch (то есть у StackPanel просто НЕТ атрибута HorizontalAlignment,
        либо он явно Stretch). НЕ Center. Разница неочевидна и стоила живого экрана:
          • Center → Layoutable.ArrangeCore отдаёт панели её ЖЕЛАЕМУЮ ширину. У StackPanel это ширина
            самого широкого ребёнка, а карточка ширины не имеет и меряется по своему содержимому.
            Итог: «О приложении» съёживалось до 288 вместо 720, и у каждого подэкрана выходила своя
            ширина карточки — по длине самой длинной строки на нём.
          • Stretch → панель получает всю доступную ширину, MaxWidth режет её до 760, а остаток
            ArrangeCore раскладывает поровну (Stretch и Center там считаются одинаково, когда размер
            уже ограничен). Колонка стоит по центру и одинакова на всех одиннадцати экранах.
    -->

    <Styles.Resources>
        <!--  ==================== Глифы лекала (24-я сетка, если не сказано иное) ====================  -->
        <!--  Назад: тот же шеврон, зеркальный (не «толстая» стрелка) — как в прототипе.  -->
        <StreamGeometry x:Key="Geo.Sub.Back">M15.4,4.6L16.8,6l-6,6l6,6l-1.4,1.4L8,12z</StreamGeometry>
        <StreamGeometry x:Key="Geo.Sub.Chevron">M8.6,4.6L7.2,6l6,6l-6,6l1.4,1.4L16,12z</StreamGeometry>
        <StreamGeometry x:Key="Geo.Sub.Caret">M7,10l5,5 5,-5z</StreamGeometry>
        <StreamGeometry x:Key="Geo.Sub.Check">M9,16.2L4.8,12l-1.4,1.4L9,19 21,7l-1.4,-1.4L9,16.2z</StreamGeometry>
        <StreamGeometry x:Key="Geo.Sub.Copy">M16,1L4,1c-1.1,0 -2,0.9 -2,2v14h2L4,3h12L16,1zM19,5L8,5c-1.1,0 -2,0.9 -2,2v14c0,1.1 0.9,2 2,2h11c1.1,0 2,-0.9 2,-2L21,7c0,-1.1 -0.9,-2 -2,-2zM19,21L8,21L8,7h11v14z</StreamGeometry>
        <StreamGeometry x:Key="Geo.Sub.Globe">M12,2C6.48,2 2,6.48 2,12s4.48,10 10,10 10,-4.48 10,-10S17.52,2 12,2zM11,19.93c-3.95,-0.49 -7,-3.85 -7,-7.93 0,-0.62 0.08,-1.21 0.21,-1.79L9,15v1c0,1.1 0.9,2 2,2v1.93zM17.9,17.39c-0.26,-0.81 -1,-1.39 -1.9,-1.39h-1v-3c0,-0.55 -0.45,-1 -1,-1H8v-2h2c0.55,0 1,-0.45 1,-1V7h2c1.1,0 2,-0.9 2,-2v-0.41c2.93,1.19 5,4.06 5,7.41 0,2.08 -0.8,3.97 -2.1,5.39z</StreamGeometry>
        <StreamGeometry x:Key="Geo.Sub.Grid">M4,8h4L8,4L4,4v4zM10,20h4v-4h-4v4zM4,20h4v-4L4,16v4zM4,14h4v-4L4,10v4zM10,14h4v-4h-4v4zM16,4v4h4L20,4h-4zM10,8h4L14,4h-4v4zM16,14h4v-4h-4v4zM16,20h4v-4h-4v4z</StreamGeometry>
        <StreamGeometry x:Key="Geo.Sub.Router">M20.2,5.9l0.8,-0.8C19.6,3.7 17.8,3 16,3s-3.6,0.7 -5,2.1l0.8,0.8C13,4.8 14.5,4.2 16,4.2s3,0.6 4.2,1.7zM19.3,6.7c-0.8,-0.8 -2.1,-1.4 -3.3,-1.4s-2.5,0.5 -3.3,1.4l0.8,0.8c0.6,-0.6 1.6,-1 2.5,-1s1.9,0.4 2.5,1l0.8,-0.8zM19,13h-2V9h-2v4H5c-1.1,0 -2,0.9 -2,2v4c0,1.1 0.9,2 2,2h14c1.1,0 2,-0.9 2,-2v-4c0,-1.1 -0.9,-2 -2,-2zM8,18H6v-2h2v2zM11.5,18h-2v-2h2v2zM15,18h-2v-2h2v2z</StreamGeometry>
        <StreamGeometry x:Key="Geo.Sub.Lock">M18,8h-1V6c0,-2.76 -2.24,-5 -5,-5S7,3.24 7,6v2H6c-1.1,0 -2,0.9 -2,2v10c0,1.1 0.9,2 2,2h12c1.1,0 2,-0.9 2,-2V10c0,-1.1 -0.9,-2 -2,-2zM9,6c0,-1.66 1.34,-3 3,-3s3,1.34 3,3v2H9V6zM18,20H6V10h12v10z</StreamGeometry>
        <StreamGeometry x:Key="Geo.Sub.Url">M3.9,12c0,-1.71 1.39,-3.1 3.1,-3.1h4V7H7c-2.76,0 -5,2.24 -5,5s2.24,5 5,5h4v-1.9H7c-1.71,0 -3.1,-1.39 -3.1,-3.1zM8,13h8v-2H8v2zM17,7h-4v1.9h4c1.71,0 3.1,1.39 3.1,3.1s-1.39,3.1 -3.1,3.1h-4V17h4c2.76,0 5,-2.24 5,-5s-2.24,-5 -5,-5z</StreamGeometry>
        <StreamGeometry x:Key="Geo.Sub.Refresh">M17.65,6.35C16.2,4.9 14.21,4 12,4c-4.42,0 -7.99,3.58 -7.99,8s3.57,8 7.99,8c3.73,0 6.84,-2.55 7.73,-6h-2.08c-0.82,2.33 -3.04,4 -5.65,4 -3.31,0 -6,-2.69 -6,-6s2.69,-6 6,-6c1.66,0 3.14,0.69 4.22,1.78L13,11h7V4l-2.35,2.35z</StreamGeometry>
        <StreamGeometry x:Key="Geo.Sub.Device">M4,6h11V4H4c-1.1,0 -2,0.9 -2,2v9H0v3h13v-3H4V6zM22,8h-6c-0.55,0 -1,0.45 -1,1v10c0,0.55 0.45,1 1,1h6c0.55,0 1,-0.45 1,-1V9c0,-0.55 -0.45,-1 -1,-1zM21,18h-4v-8h4v8z</StreamGeometry>
        <!--  1024-я сетка (перенесены как есть из прототипа).  -->
        <StreamGeometry x:Key="Geo.Sub.Routing">M740,161a112.1,112.1 0,0 0,-33.5 218.9v95.9L320,602.4L320,318.1a112.1,112.1 0,1 0,-148 -106.1c0,49.3 31.8,91 76,106.1v387.9a112.1,112.1 0,1 0,148 106.1c0,-49.2 -31.8,-91 -76,-106.1v-27.8l423.5,-138.7a50.6,50.6 0,0 0,34.9 -48.2L778.4,378.2c42.9,-15.8 73.6,-57 73.6,-105.2 0,-61.8 -50.2,-112 -112,-112zM236,212a48,48 0,1 1,96 0,48 48,0 0,1 -96,0zM332,812a48,48 0,1 1,-96 0,48 48,0 0,1 96,0zM740,321a48,48 0,1 1,0 -96,48 48,0 0,1 0,96z</StreamGeometry>
        <StreamGeometry x:Key="Geo.Sub.File">M537,85.3A85.3,85.3 0,0 1,597.3 110.3L828.3,341.3A85.3,85.3 0,0 1,853.3 401.7L853.3,810.7a128,128 0,0 1,-128 128L298.7,938.7a128,128 0,0 1,-128 -128L170.7,213.3a128,128 0,0 1,128 -128zM537,170.7L298.7,170.7a42.7,42.7 0,0 0,-42.7 42.7v597.3a42.7,42.7 0,0 0,42.7 42.7h426.7a42.7,42.7 0,0 0,42.7 -42.7L768,401.7L537,170.7z</StreamGeometry>
        <StreamGeometry x:Key="Geo.Sub.Backup">M864,192L704,192L704,96c0,-17.7 -14.3,-32 -32,-32L352,64c-9,0 -17.2,3.7 -22.9,9.7L137.7,265.1c-6,5.8 -9.7,14 -9.7,22.9v512c0,17.7 14.3,32 32,32h160v96c0,17.7 14.3,32 32,32h512c17.7,0 32,-14.3 32,-32L896,224c0,-17.7 -14.3,-32 -32,-32zM320,173.2L320,256h-82.8l82.8,-82.8zM192,768L192,320h160c17.7,0 32,-14.3 32,-32L384,128h256v64h-96c-9,0 -17.2,3.7 -22.9,9.7L329.7,393.1c-6,5.8 -9.7,14 -9.7,22.9v352L192,768zM512,301.2L512,384h-82.8l82.8,-82.8zM832,896L384,896L384,448h160c17.7,0 32,-14.3 32,-32L576,256h256v640z</StreamGeometry>
        <StreamGeometry x:Key="Geo.Sub.Frag">M469.2,802.1l-81.7,-24.6L554.8,221.9l81.7,24.6L469.2,802.1zM362.7,654.5l-124.7,-141.7 124.8,-143.5 -64.4,-56 -173.8,199.8 174,197.7 64.1,-56.3zM899.4,513.1l-173.8,-199.8 -64.4,56 124.8,143.5 -124.7,141.7 64.1,56.4 174,-197.7z</StreamGeometry>
    </Styles.Resources>

    <!--  ==================== Кнопка «назад» ====================
          40×40, глиф 22, смещена на −8 влево (screens.md): оптический край стрелки садится на ту же
          вертикаль 16, что и текст заголовка и края карточек. Отклик — только прогиб (0.92), без свечения.  -->
    <Style Selector="Button.SubBack">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="-8,0,0,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Arrow" />
        <!--  Круг, а не квадрат: бокс 40×40 → радиус 20.  -->
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill40}" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Duration="0:0:0.09" Property="RenderTransform" />
            </Transitions>
        </Setter>
    </Style>
    <!--  Никакой подложки НИ В ОДНОМ состоянии: у кнопок свечения при наведении нет вовсе.
          Раньше подложку рисовала тема Semi, и она же оставалась видна постоянно.  -->
    <Style Selector="Button.SubBack /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.SubBack:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.SubBack:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <!--  Глиф стрелки — 14, а не 22: PathIcon заливает чернилами весь бокс, и 22 давали стрелку
          вдвое крупнее эталона (замер: 9×14 в кадре против 14×22 живьём). Одним правилом на все
          одиннадцать подэкранов, чтобы стрелка не «прыгала» между экранами.  -->
    <Style Selector="Button.SubBack PathIcon">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.SubBack:pressed">
        <Setter Property="RenderTransform" Value="scale(0.90)" />
    </Style>

    <!--  ==================== Заголовок и пояснение ====================  -->
    <Style Selector="TextBlock.SubTitle">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Grotesk}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="LetterSpacing" Value="-0.22" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!--  Пояснение под заголовком: 13/1.5, ширина ограничена 560 — длинная строка не растягивается
          на всю колонку и читается одним взглядом.  -->
    <Style Selector="TextBlock.SubNote">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="19.5" />
        <Setter Property="MaxWidth" Value="560" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
    </Style>
    <!--  Заголовок группы: 16/700 sentence-case, отступы 18 сверху / 8 снизу, инсет 4 (прототип).  -->
    <!--  LineHeight задана явно: без неё высота строки зависит от метрик гарнитуры, и карточка
          под заголовком вставала то на 6 ниже эталона, то на 8 выше — на разных подэкранах
          по-разному. Одно правило выправляет ритм всех одиннадцати.  -->
    <Style Selector="TextBlock.SubGroupLabel">
        <Setter Property="LineHeight" Value="22" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Grotesk}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Margin" Value="4,18,4,8" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}" />
    </Style>
    <!--  Сноска под группой: 12/1.5, инсет 4, отступ 10 сверху.  -->
    <Style Selector="TextBlock.SubFoot">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="Margin" Value="4,10,4,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
    </Style>

    <!--  ==================== Карточка группы ====================
          Поверхность, скругление 16, контур 1. ClipToBounds — чтобы ховер крайней строки не вылезал
          прямыми углами за скруглённый край карточки.  -->
    <Style Selector="Border.SubCard">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.OutlineVariant}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!--  ==================== Строка настроек ====================
          Высота от 56, паддинг 16×9. Отклик — ТОЛЬКО ховер (шаг фона), без прогиба: press-scale
          из строк настроек убран осознанно (коммит «Settings rows: remove press-scale») — строка
          уезжала из-под курсора и жест Tapped отменялся, тап срабатывал через раз.
          Кольцо фокуса внутреннее — строка во всю ширину карточки, внешнее вылезло бы за скругление.  -->
    <Style Selector="Border.SubRow">
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border
                    Margin="3"
                    BorderBrush="{DynamicResource Brush.Accent}"
                    BorderThickness="2"
                    CornerRadius="12" />
            </FocusAdornerTemplate>
        </Setter>
    </Style>
    <!--  Ховер только у СТРОК-ДЕЙСТВИЙ (.tap): строка без действия не должна подсвечиваться —
          это ложный аффорданс (ровно то же правило, что у .segmentRow в GlobalStyles).  -->
    <Style Selector="Border.SubRow.tap">
        <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="Border.SubRow.tap:pointerover">
        <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
    </Style>
    <Style Selector="Border.SubRow.tap:disabled">
        <Setter Property="Opacity" Value="0.45" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <!--  Разделитель на всю ширину карточки перед каждой строкой кроме первой (tokens.md).  -->
    <Style Selector="Border.SubDivider">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Brush.OutlineVariant}" />
    </Style>

    <!--  ==================== Плитка иконки ====================
          40 со скруглением 10, глиф 22 (tokens.md «Строка настроек»). Одна нейтральная плитка на все
          строки — никаких радужных цветных плиток.  -->
    <Style Selector="Border.SubTile">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{DynamicResource Brush.Tile.Neutral}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.SubTile > PathIcon">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
    </Style>
    <!--  Плитка с буквой (список программ): та же плитка, инициал 15/700.  -->
    <Style Selector="Border.SubTile > TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Grotesk}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
    </Style>

    <!--  ==================== Тексты строки ====================  -->
    <Style Selector="TextBlock.SubName">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="LineHeight" Value="18.2" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.SubName.accent">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <Style Selector="TextBlock.SubName.danger">
        <Setter Property="Foreground" Value="{DynamicResource Brush.RedText}" />
    </Style>
    <Style Selector="TextBlock.SubSub">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16.2" />
        <Setter Property="Margin" Value="0,3,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!--  Значение справа: 12.5, ограничено 200 с многоточием. Обрезается ЗНАЧЕНИЕ, а не заголовок —
          подпись, срезанная на полуслове, хуже, чем её отсутствие.  -->
    <Style Selector="TextBlock.SubValue">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="MaxWidth" Value="200" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
    </Style>
    <Style Selector="TextBlock.SubValue.strong">
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}" />
    </Style>
    <Style Selector="TextBlock.SubValue.accent">
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    </Style>

    <!--  Шеврон 18 / каретка 18 / копирование 19 — приглушённые, отступ слева как в прототипе.  -->
    <Style Selector="PathIcon.SubChevron">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
    </Style>

    <!--  ==================== Радио ====================
          20 с обводкой 2, точка 9. Геометрия строки НЕ меняется между выбранным и невыбранным:
          рамка всегда есть (меняется только её цвет), точка всегда занимает место (меняется только
          прозрачность). Ровно то же правило, что у списка серверов на Главной.  -->
    <Style Selector="Border.SubRadio">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Outline}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Duration="0:0:0.22" Property="BorderBrush" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.SubRadio.on">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <Style Selector="Border.SubRadio > Ellipse">
        <Setter Property="Width" Value="9" />
        <Setter Property="Height" Value="9" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Duration="0:0:0.22" Property="Opacity" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.SubRadio.on > Ellipse">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!--  ==================== Чекбокс ====================
          22 со скруглением 7, обводка 2, галочка 15. Как и радио — размеры фиксированы, меняются
          только цвета и прозрачность галочки.  -->
    <Style Selector="Border.SubCheck">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Outline}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Duration="0:0:0.22" Property="BorderBrush" />
                <BrushTransition Duration="0:0:0.22" Property="Background" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.SubCheck.on">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <Style Selector="Border.SubCheck > PathIcon">
        <Setter Property="Width" Value="15" />
        <Setter Property="Height" Value="15" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Duration="0:0:0.22" Property="Opacity" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.SubCheck.on > PathIcon">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!--  ==================== Поле поиска ====================
          Высота 46, скругление 14, контур 1 (tokens.md «поле поиска и мелкая карточка 14»).
          БЕЗ глифа лупы: в кадрах прототипа (B_log, B_perapp) поле поиска — только плейсхолдер.  -->
    <Style Selector="Border.SubSearch">
        <Setter Property="Height" Value="46" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Outline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="15,0" />
    </Style>
    <Style Selector="Border.SubSearch > Grid > TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <!--  Часть шаблона у Semi зовётся PART_ContentPresenterBorder (PART_BorderElement — имя из
          наших ControlTheme TextBox.Incy*). Селектор с чужим именем не совпадал ни с чем, и Semi
          рисовал под курсором серую подложку внутри поля.  -->
    <Style Selector="Border.SubSearch > Grid > TextBox:focus /template/ Border#PART_ContentPresenterBorder">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.SubSearch > Grid > TextBox:pointerover /template/ Border#PART_ContentPresenterBorder">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!--  ==================== Поле-значение внутри строки ====================
          Порт/адрес правятся прямо в строке — без модалок. Выглядит как значение (12.5, справа),
          рамка появляется только на фокусе, чтобы строка не превращалась в форму.  -->
    <Style Selector="TextBox.SubField">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="TextBox.SubField /template/ Border#PART_ContentPresenterBorder">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.SubField:pointerover /template/ Border#PART_ContentPresenterBorder">
        <Setter Property="Background" Value="{DynamicResource Brush.PressBg}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.SubField:focus /template/ Border#PART_ContentPresenterBorder">
        <Setter Property="Background" Value="{DynamicResource Brush.PressBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox.SubField:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!--  ==================== Пустое состояние ====================
          Карточка от 230 в высоту: плитка 54 со скруглением 14 и глифом 26 → заголовок 15/700 →
          пояснение 12.5 по центру. Пустой экран — тоже экран, а не «ничего не нашлось».  -->
    <Style Selector="Border.SubEmpty">
        <Setter Property="MinHeight" Value="230" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.OutlineVariant}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.SubEmptyTile">
        <Setter Property="Width" Value="54" />
        <Setter Property="Height" Value="54" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Brush.Tile.Neutral}" />
    </Style>
    <Style Selector="Border.SubEmptyTile > PathIcon">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
    </Style>
    <Style Selector="TextBlock.SubEmptyTitle">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Grotesk}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}" />
    </Style>
    <Style Selector="TextBlock.SubEmptyText">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
    </Style>

    <!--  ==================== Моноширинный блок (строки журнала) ====================  -->
    <Style Selector="Border.SubMono">
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="{DynamicResource Brush.PressBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.OutlineVariant}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBlock.SubMonoLine">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Numeric}" />
        <Setter Property="FontFeatures" Value="tnum,lnum,zero" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
    </Style>
</Styles>
