<?xml version="1.0" encoding="utf-8"?>
<!--
  THE LOADING SILHOUETTE FOR THE TRAFFIC RING (activity_account.xml, group_sub_skeleton).

  A skeleton's whole job is to hold the shape the real thing will take, so that the tab
  does not jump when the figures land. The ring is a 172dp disc with a 6dp wall, so the
  silhouette is a 172dp ring with the same wall — an oval with a stroke and no fill —
  and not the rounded slab @drawable/bg_skeleton draws for a text block.

  Same fill colour as the ring's own unfilled track (?attr/colorSurfaceContainerHighest),
  because that IS what the ring looks like before any progress is set. AccountFragment
  pulses its alpha; nothing here animates.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="6dp"
        android:color="?attr/colorSurfaceContainerHighest" />
</shape>
