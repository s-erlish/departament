<?xml version="1.0" encoding="utf-8"?>
<!--
  THE LOG SLAB — handoff §7, «Журнал: моноширинный блок лога», measured off the
  prototype (docs/design2026/port-shots-2/47-log.geo.json).

      radius 16, no stroke, fill #0D1017 — which is ?attr/colorPressBg

  It is deliberately NOT a section card: a card is a surface a row sits ON, this is
  a well the text sits IN, so it steps DOWN from the page instead of up, and it uses
  the one token that already means «на шаг ниже фона». The same three values the
  prototype gives it — #0D1017 dark, #0B0B0C mono, #EAEFF7 light — come free with
  the attribute, so the light theme does not invert into a black box.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/colorPressBg" />
    <corners android:radius="@dimen/radius_popup" />
</shape>
