<?xml version="1.0" encoding="utf-8"?>
<!--
    Rounded window background for app-wide AlertDialogs (departament design).
    Solid app dialog-surface colour (resolves per theme: dark / light / mono)
    with ~20dp corners, replacing the flat default v2ray/system grey box.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/colorSurfaceContainerHigh" />
    <corners android:radius="20dp" />
</shape>
