<?xml version="1.0" encoding="utf-8"?>
<!-- «Есть новая версия» on the Настройки tab: an 8dp accent dot at the glyph's corner, ringed in the
     screen's ground colour so it reads as sitting ON the glyph rather than merging into its strokes. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <solid android:color="?attr/colorPrimary" />
    <stroke
        android:width="1.5dp"
        android:color="?attr/colorSurface" />
</shape>
