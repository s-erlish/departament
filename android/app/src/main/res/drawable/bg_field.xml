<?xml version="1.0" encoding="utf-8"?>
<!--
  Field shape for a bare EditText that has not yet been wrapped in a
  TextInputLayout. radius_control 16 (D-7 collapsed nine radii to four: a 12dp field
  beside a 16dp button reads as two systems), fill colorSurfaceContainerHighest,
  boundary @color/md_theme_outlineControl at stroke_control 1dp — 3.43:1 dark /
  3.45:1 light, which clears WCAG 1.4.11's 3:1 floor that ?attr/colorOutline
  (1.45:1) fails.

  This is a migration aid, not the component. The component is
  @style/Widget.Departament.TextField, which also gives you the label slot, the
  reserved helper line, the error border and the focus stroke.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/colorSurfaceContainerHighest" />
    <stroke
        android:width="@dimen/stroke_control"
        android:color="?attr/colorOutlineControl" />
    <corners android:radius="@dimen/radius_control" />
</shape>
