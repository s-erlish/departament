<?xml version="1.0" encoding="utf-8"?>
<!--
  THE OUTLINED BALANCE CHIP in the account profile row (handoff README §5.1,
  «справа контурный чип баланса с «+»»).

  Contour, not fill: the chip states a figure and offers the top-up, and it sits
  16dp from the accent-outlined «Пополнить» button below it. A filled chip there
  would be the second filled object in a band that has no primary — the outline
  is what keeps the ring the only thing on this screen with weight.

  The prototype's border is its `line` variable, which is `?attr/colorOutlineVariant`
  (#20242B dark / #38383C mono) — the same hairline every card on this tab draws,
  so the chip belongs to the same family as the surfaces around it rather than
  inventing a third edge colour.

  radius_pill and not radius_chip: this is a 30dp-tall lozenge whose width is set
  by its content, which is exactly the case @dimen/radius_pill documents.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="@dimen/stroke_control"
        android:color="?attr/colorOutlineVariant" />
    <corners android:radius="@dimen/radius_pill" />
</shape>
