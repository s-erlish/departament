<?xml version="1.0" encoding="utf-8"?>
<!--
  Golos Text — THE UI FACE (00-rules.md 3.4 / 5.1, decision D-1).

  This family draws EVERY Russian string in the product: Headline, Title,
  Title.Medium, Body, Subtitle, Caption, Section header, and every button label.
  It is never used for the Display figure, the Chip label, the Numeric role or
  the wordmark — those four are Space Grotesk (D-2).

  THREE STATIC INSTANCES, NOT A VARIABLE FILE. Real 400 / 500 / 700 masters,
  because android:fontVariationSettings needs API 28 and minSdk here is 24, so a
  variable file would render its default instance on every device below 28 and
  the ramp's weights would be fiction. Measured usWeightClass of the three
  vendored binaries: 400 / 500 / 700 — they agree with the fontWeight declared
  below, so Android's weight matching is exact and no synthetic bold is ever
  needed (00-rules.md 5.4 bans android:textStyle="bold" outright).

  BOTH NAMESPACES ON EVERY ENTRY. android:* is what the platform font resolver
  reads on API 26+; app:* is what androidx.core's FontResourcesParserCompat reads
  through ResourcesCompat.getFont() on API 24-25, which is the whole reason this
  file exists instead of three separate @font/ references. Drop the app:* half and
  weight selection silently collapses to the first entry on API 24-25.

  Measured coverage (all three files, cmap): 566 codepoints, 170 of them in
  U+0400-U+04FF — the full Russian alphabet including Ё/ё — plus ₽ (U+20BD),
  … (U+2026), «» and U+2009 THIN SPACE (the thousands separator of 10-design-system.md
  2.10). It does NOT map U+2007 FIGURE SPACE; that character is only ever used for
  numeric column padding, which is set in Space Grotesk, which does map it.

  Licence: SIL OFL 1.1, see GOLOS-TEXT-LICENSE.txt.
-->
<font-family
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- 400 Regular — Body, Subtitle, Caption. -->
    <font
        android:font="@font/golos_text_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/golos_text_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />

    <!-- 500 Medium — Title.Medium, Secondary and Tertiary button labels,
         inactive navigation labels, unselected segment labels. -->
    <font
        android:font="@font/golos_text_medium"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/golos_text_medium"
        app:fontStyle="normal"
        app:fontWeight="500" />

    <!-- 700 Bold — Headline, Title, Section header, Primary and Destructive
         button labels, the active navigation label, the selected segment. -->
    <font
        android:font="@font/golos_text_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/golos_text_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />

</font-family>
