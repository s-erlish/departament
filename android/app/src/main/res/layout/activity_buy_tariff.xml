<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  «Купить подписку» (BuyTariffActivity) — handoff README §7.
  ============================================================================

      кнопка назад → «Купить подписку» 24sp/700 → «Выберите тариф и срок» 13sp
      → карточки тарифов, раскрываются в список сроков
      → карточка оформления: устройства · Итого · «Оплатить N ₽»

  §7 draws the pay button inside the open tariff, because the prototype's tariff has
  nothing else to configure. THIS screen does (P-16): a stepper for extra devices and
  the «Итого» they change. Splitting those from the button that charges for them
  would put the amount in one card and the confirmation in another, so the checkout
  card keeps all three and stays directly under the tariff list — «кнопка внизу
  подстраивается» reads the same way, and it now says «Оплатить 1 290 ₽».

  The header replaced «Выберите тариф», the section label that used to sit above the
  cards: §7 puts that sentence under the title as the lekalo's note, and one screen
  does not need to say «выберите тариф» twice.

  States (driven by BuyTariffActivity): ll_skeleton = loading; iv_state_icon +
  tv_state + btn_retry = error; iv_state_icon + tv_state = empty. progress_buy is
  NOT a screen state — it is the pay CTA's in-flight arc and lives on the button.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".ui.BuyTariffActivity">

    <include
        android:id="@+id/toolbar"
        layout="@layout/view_sub_header" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_gutter"
        android:paddingTop="@dimen/space_8"
        android:paddingBottom="@dimen/space_24">

        <!-- ============ States ============ -->
        <!-- Error/empty glyph: wire-ready, revealed by the activity alongside tv_state. -->
        <ImageView
            android:id="@+id/iv_state_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_32"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_dl_info"
            app:tint="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:padding="@dimen/space_16"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.App.Body"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            tools:text="Не удалось загрузить тарифы. Проверьте соединение и повторите."
            tools:visibility="visible" />

        <!-- Retry affordance for the error state -->
        <!-- Secondary, not a raw M3 tonal: the app's own tier carries the bevel, the press
             motion, the focus ring and btn_height 48 (OWNER-FEEDBACK D1). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_retry"
            style="@style/Widget.Departament.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_4"
            android:layout_marginBottom="@dimen/space_8"
            android:text="@string/buy_retry"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Post-checkout pending hint: shown while re-polling after a browser payment -->
        <TextView
            android:id="@+id/tv_pending"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:padding="@dimen/space_12"
            android:textAlignment="center"
            android:text="@string/buy_pending"
            android:textAppearance="@style/TextAppearance.App.Body"
            android:textColor="?attr/colorPrimary"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Loading skeleton: calm placeholder silhouettes that mirror the real tariff cards.
             The silhouette itself is the loading affordance (no spinner or label on top). Fill is
             the theme's surfaceVariant (matches bg_skeleton.xml) so it reads as a soft placeholder
             in BOTH light and dark, never a stark dark block. No shimmer/gradient — static, calm. -->
        <LinearLayout
            android:id="@+id/ll_skeleton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginBottom="@dimen/space_12"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="0dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginBottom="@dimen/space_12"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="0dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="76dp"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="0dp" />
        </LinearLayout>

        <!-- ============ 1. Tariffs ============ -->
        <LinearLayout
            android:id="@+id/ll_tariffs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- ============ 2. Config / checkout card ============ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_checkout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <!-- Extra devices stepper: icon + label on the left, «− N +» control on the right -->
                <LinearLayout
                    android:id="@+id/ll_extra_devices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Neutral, like every other tile in the product (D-5, §9): a coloured
                         tile encodes a category this app does not have. The fill is a THEME
                         ATTRIBUTE and not @drawable/bg_icon_blue's colour resource, so the mono
                         overlay can reach it — an overlay cannot restate a colour resource. -->
                    <ImageView
                        style="@style/Widget.Departament.Tile"
                        android:backgroundTint="?attr/colorSurfaceContainerHighest"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_acc_devices" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/buy_extra_devices_title"
                            android:textAppearance="@style/TextAppearance.App.Body" />

                        <TextView
                            android:id="@+id/tv_extra_devices_cost"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.App.Caption"
                            android:visibility="gone"
                            tools:text="+ 50 ₽"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_dev_minus"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="@dimen/view_height_dp48"
                        android:layout_height="@dimen/view_height_dp48"
                        android:contentDescription="@string/buy_extra_devices_minus"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:stateListAnimator="@anim/press_scale"
                        app:backgroundTint="?attr/colorSurfaceContainerHighest"
                        app:cornerRadius="@dimen/radius_pill"
                        app:icon="@drawable/ic_remove_24dp"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="20dp"
                        app:iconTint="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/tv_extra_devices_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/space_4"
                        android:minWidth="28dp"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.App.Title"
                        tools:text="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_dev_plus"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="@dimen/view_height_dp48"
                        android:layout_height="@dimen/view_height_dp48"
                        android:contentDescription="@string/buy_extra_devices_plus"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:stateListAnimator="@anim/press_scale"
                        app:backgroundTint="?attr/colorSurfaceContainerHighest"
                        app:cornerRadius="@dimen/radius_pill"
                        app:icon="@drawable/ic_add_24dp"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="20dp"
                        app:iconTint="?attr/colorPrimary" />
                </LinearLayout>

                <View
                    android:id="@+id/divider_total"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/space_16"
                    android:background="?attr/colorOutlineVariant" />

                <!-- Total -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/buy_total"
                        android:textAppearance="@style/TextAppearance.App.Body"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/tv_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.App.Headline"
                        android:textColor="?attr/colorPrimary"
                        tools:text="299 ₽" />
                </LinearLayout>

                <!-- Pay CTA — THE SAME BUTTON AS «Пополнить», because it is the same object:
                     an accent contour, no fill, 48dp, radius_button 24, stroke_frame 1.5dp,
                     accent label at TextAppearance.App.Button 15/700. «кнопка оплатить не
                     соответствует стилю общему, возьми стиль с кнопки пополнить».

                     It used to be Widget.Departament.Button.Primary.Tall — a filled accent slab
                     at 52dp, the only filled control in the whole account flow, so it read as a
                     different product from the tab that leads here. The prototype agrees: its own
                     «Оплатить …» is `border: 1.5px solid acc; color: acc` over no background.

                     Built on Button.Tertiary for the same reason activity_account.xml's pair is —
                     it is the app's only transparent-container button and it already owns the
                     press scale and the ripple-free feedback; what each instance adds is the
                     constant contour (Tertiary's own stroke is a focus ring, transparent at rest).

                     The label text is untouched: «Оплатить 1 290 ₽» is set by updateTotal.

                     progress_buy lives HERE, on the control that spends money. Its indicator is
                     the ACCENT now and not colorOnPrimary: with the fill gone, an on-accent arc
                     would be drawn in the label colour of a plate that is no longer there. -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_pay"
                        style="@style/Widget.Departament.Button.Tertiary"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/btn_height"
                        android:text="@string/buy_pay"
                        android:textAppearance="@style/TextAppearance.App.Button"
                        app:cornerRadius="@dimen/radius_button"
                        app:strokeColor="?attr/colorPrimary"
                        app:strokeWidth="@dimen/stroke_frame" />

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progress_buy"
                        style="@style/Widget.Departament.Progress.Circular.Inline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="@dimen/space_16"
                        android:importantForAccessibility="no"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </FrameLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
