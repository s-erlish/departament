<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  A-13 - группа «Транспорт», общая у VMess, VLESS, Trojan и Shadowsocks.
  ============================================================================

  ТРИ SPINNER'А УШЛИ. Spinner в разрешённый набор компонентов не входит (11.2), и
  это последние три в продукте: он рисуется системным поповером - своя заливка,
  свой угол, свой шрифт и свой ripple, - то есть ровно тем, по чему экран
  опознаётся как чужой. На их месте поле выбора: та же коробка 56 с радиусом 16,
  что и у соседних полей, значение написано внутри, справа каретка, нажатие
  открывает лист вариантов (EditorActionsSheet - тот же, что у «Подписки»).

  ПОЛЕ, А НЕ СТРОКА НАСТРОЕК, и это не вкусовщина: у поля есть строка отказа. На
  Trojan без TLS сохранение отказывает, и отказу надо куда-то встать - под своим
  элементом, а не тостом поверх формы (7.4).

  ЗАГОЛОВОК ТИПА ЗАГОЛОВКА МЕНЯЕТСЯ вместе с сетью: «Тип заголовка», «Режим
  gRPC», «Режим XHTTP» - одно поле с тремя именами, поэтому подпись здесь с id.
  Тем же способом меняются подписи узла и пути.

  ЧТО ВИДНО КОГДА: mKCP - только на kcp, XHTTP Extra - только на xhttp,
  переадресация браузера - на ws и xhttp. Форма показывает поля, которые
  относятся к выбранной сети, и прячет остальные; это состояние «частично», а не
  «пусто» (15).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/SettingsSectionLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/server_lab_more_function" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:labelFor="@id/et_network"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingEnd="@dimen/screen_gutter"
        android:text="@string/server_lab_network"
        android:textAppearance="@style/TextAppearance.App.Title.Medium" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_network"
        style="@style/Widget.Departament.TextField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_gutter"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginEnd="@dimen/screen_gutter"
        app:endIconContentDescription="@string/srv_pick_value"
        app:endIconDrawable="@drawable/ic_arrow_drop_down"
        app:endIconMode="custom">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_network"
            style="@style/Widget.Departament.TextField.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:maxLines="1"
            tools:ignore="TextFields" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tv_header_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:labelFor="@id/et_header_type"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingEnd="@dimen/screen_gutter"
        android:text="@string/server_lab_head_type"
        android:textAppearance="@style/TextAppearance.App.Title.Medium" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_header_type"
        style="@style/Widget.Departament.TextField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_gutter"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginEnd="@dimen/screen_gutter"
        app:endIconContentDescription="@string/srv_pick_value"
        app:endIconDrawable="@drawable/ic_arrow_drop_down"
        app:endIconMode="custom">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_header_type"
            style="@style/Widget.Departament.TextField.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:maxLines="1"
            tools:ignore="TextFields" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tv_request_host"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:labelFor="@id/et_request_host"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingEnd="@dimen/screen_gutter"
        android:text="@string/server_lab_request_host"
        android:textAppearance="@style/TextAppearance.App.Title.Medium" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_request_host"
        style="@style/Widget.Departament.TextField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_gutter"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginEnd="@dimen/screen_gutter"
        app:helperText="@string/srv_hint_optional">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_request_host"
            style="@style/Widget.Departament.TextField.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionNext"
            android:inputType="textUri"
            android:maxLines="1"
            tools:ignore="TextFields" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tv_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:labelFor="@id/et_path"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingEnd="@dimen/screen_gutter"
        android:text="@string/server_lab_path"
        android:textAppearance="@style/TextAppearance.App.Title.Medium" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_path"
        style="@style/Widget.Departament.TextField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_gutter"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginEnd="@dimen/screen_gutter"
        app:helperText="@string/srv_hint_optional">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_path"
            style="@style/Widget.Departament.TextField.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionNext"
            android:inputType="textUri"
            android:maxLines="1"
            tools:ignore="TextFields" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:id="@+id/layout_kcp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:labelFor="@id/et_kcp_mtu"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingEnd="@dimen/screen_gutter"
            android:text="@string/srv_kcp_mtu_label"
            android:textAppearance="@style/TextAppearance.App.Title.Medium" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_kcp_mtu"
            style="@style/Widget.Departament.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_gutter"
            android:layout_marginTop="@dimen/space_8"
            android:layout_marginEnd="@dimen/screen_gutter"
            app:helperText="@string/srv_hint_kcp_mtu">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_kcp_mtu"
                style="@style/Widget.Departament.TextField.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="number"
                android:maxLines="1"
                tools:ignore="TextFields" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:labelFor="@id/et_kcp_tti"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingEnd="@dimen/screen_gutter"
            android:text="@string/srv_kcp_tti_label"
            android:textAppearance="@style/TextAppearance.App.Title.Medium" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_kcp_tti"
            style="@style/Widget.Departament.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_gutter"
            android:layout_marginTop="@dimen/space_8"
            android:layout_marginEnd="@dimen/screen_gutter"
            app:helperText="@string/srv_hint_kcp_tti">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_kcp_tti"
                style="@style/Widget.Departament.TextField.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="number"
                android:maxLines="1"
                tools:ignore="TextFields" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_extra"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:labelFor="@id/et_extra"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingEnd="@dimen/screen_gutter"
            android:text="@string/srv_xhttp_extra_label"
            android:textAppearance="@style/TextAppearance.App.Title.Medium" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_extra"
            style="@style/Widget.Departament.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_gutter"
            android:layout_marginTop="@dimen/space_8"
            android:layout_marginEnd="@dimen/screen_gutter"
            app:helperText="@string/srv_hint_xhttp_extra">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_extra"
                style="@style/Widget.Departament.TextField.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:maxLines="12"
                android:minLines="4"
                tools:ignore="TextFields" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_fm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:labelFor="@id/et_fm"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingEnd="@dimen/screen_gutter"
            android:text="@string/srv_final_mask_label"
            android:textAppearance="@style/TextAppearance.App.Title.Medium" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_fm"
            style="@style/Widget.Departament.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_gutter"
            android:layout_marginTop="@dimen/space_8"
            android:layout_marginEnd="@dimen/screen_gutter"
            app:helperText="@string/srv_hint_final_mask">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_fm"
                style="@style/Widget.Departament.TextField.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:maxLines="12"
                android:minLines="4"
                tools:ignore="TextFields" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_browser_dialer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:labelFor="@id/et_browser_dialer_mode"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingEnd="@dimen/screen_gutter"
            android:text="@string/server_lab_browser_dialer"
            android:textAppearance="@style/TextAppearance.App.Title.Medium" />

        <!-- Предупреждение стоит подсказкой ПОД полем, а не отдельным абзацем под
             ним: у поля эта строка и так зарезервирована, а два разных способа
             написать пояснение к полю - это два компонента вместо одного. -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_browser_dialer_mode"
            style="@style/Widget.Departament.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_gutter"
            android:layout_marginTop="@dimen/space_8"
            android:layout_marginEnd="@dimen/screen_gutter"
            app:endIconContentDescription="@string/srv_pick_value"
            app:endIconDrawable="@drawable/ic_arrow_drop_down"
            app:endIconMode="custom"
            app:helperText="@string/server_lab_browser_dialer_tip">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_browser_dialer_mode"
                style="@style/Widget.Departament.TextField.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:maxLines="1"
                tools:ignore="TextFields" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</LinearLayout>
