<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  A-13 - группа «Шифрование канала» для Hysteria2.
  ============================================================================

  Короче общей: у Hysteria2 нет ни REALITY, ни отпечатка, ни ALPN, поэтому в
  списке первого поля только «Нет» и «tls». Раньше эта разница жила в том, что
  разметка брала @array/streamsecuritys, а код индексировал @array/streamsecurityxs
  - две параллельные таблицы, совпадающие первыми двумя строками; третья строка
  второй из них до пользователя не доходила только потому, что её нечем было
  выбрать.

  «Отпечаток сертификата» лежал ВНУТРИ блока «Разрешать небезопасные соединения»,
  то есть прятался вместе с ним по причине, которой в разметке не написано. Теперь
  это отдельный блок с собственным id, и видимостью всех блоков управляет одно
  место - выбор шифрования канала.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/SettingsSectionLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/srv_section_tls" />

    <LinearLayout
        android:id="@+id/lay_stream_security"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@id/et_stream_security"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingEnd="@dimen/screen_gutter"
            android:text="@string/server_lab_stream_security"
            android:textAppearance="@style/TextAppearance.App.Title.Medium" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_stream_security"
            style="@style/Widget.Departament.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_gutter"
            android:layout_marginTop="@dimen/space_8"
            android:layout_marginEnd="@dimen/screen_gutter"
            app:endIconContentDescription="@string/srv_pick_value"
            app:endIconDrawable="@drawable/ic_arrow_drop_down"
            app:endIconMode="custom">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_stream_security"
                style="@style/Widget.Departament.TextField.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:maxLines="1"
                tools:ignore="TextFields" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lay_sni"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:labelFor="@id/et_sni"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingEnd="@dimen/screen_gutter"
            android:text="@string/server_lab_sni"
            android:textAppearance="@style/TextAppearance.App.Title.Medium" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_sni"
            style="@style/Widget.Departament.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_gutter"
            android:layout_marginTop="@dimen/space_8"
            android:layout_marginEnd="@dimen/screen_gutter"
            app:helperText="@string/srv_hint_optional">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_sni"
                style="@style/Widget.Departament.TextField.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="textUri"
                android:maxLines="1"
                tools:ignore="TextFields" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lay_allow_insecure"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:labelFor="@id/et_allow_insecure"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingEnd="@dimen/screen_gutter"
            android:text="@string/server_lab_allow_insecure"
            android:textAppearance="@style/TextAppearance.App.Title.Medium" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_allow_insecure"
            style="@style/Widget.Departament.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_gutter"
            android:layout_marginTop="@dimen/space_8"
            android:layout_marginEnd="@dimen/screen_gutter"
            app:endIconContentDescription="@string/srv_pick_value"
            app:endIconDrawable="@drawable/ic_arrow_drop_down"
            app:endIconMode="custom">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_allow_insecure"
                style="@style/Widget.Departament.TextField.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:maxLines="1"
                tools:ignore="TextFields" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lay_pinned_ca256"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:labelFor="@id/et_pinned_ca256"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingEnd="@dimen/screen_gutter"
            android:text="@string/server_lab_pinned_ca256"
            android:textAppearance="@style/TextAppearance.App.Title.Medium" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_pinned_ca256"
            style="@style/Widget.Departament.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_gutter"
            android:layout_marginTop="@dimen/space_8"
            android:layout_marginEnd="@dimen/screen_gutter"
            app:helperText="@string/srv_hint_pinned_ca256">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_pinned_ca256"
                style="@style/Widget.Departament.TextField.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="text|textNoSuggestions"
                android:maxLines="1"
                tools:ignore="TextFields" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</LinearLayout>
