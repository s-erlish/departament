<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  A-26  Файл ресурсов - форма.  H3 · R4.
  ============================================================================

  Two bare `EditText`s under two unstyled labels, with save and delete on a toolbar
  menu A-38 removes. Now the shared form shape: label, 56 field, reserved helper and
  error slot, one Primary.Tall «Сохранить» and a Row.Destructive «Удалить файл».

  Both validations - a name that is already taken, and an empty field - moved out of
  toasts and into the field's own error slot, where the user is already looking.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".ui.UserAssetUrlActivity">

    <include
        android:id="@+id/toolbar"
        layout="@layout/view_toolbar" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_32"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:paddingStart="@dimen/screen_gutter"
                android:paddingEnd="@dimen/screen_gutter"
                android:text="@string/asset_name_label"
                android:textAppearance="@style/TextAppearance.App.Title.Medium" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_remarks"
                style="@style/Widget.Departament.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_gutter"
                android:layout_marginTop="@dimen/space_8"
                android:layout_marginEnd="@dimen/screen_gutter"
                app:helperText="@string/asset_name_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_remarks"
                    style="@style/Widget.Departament.TextField.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:paddingStart="@dimen/screen_gutter"
                android:paddingEnd="@dimen/screen_gutter"
                android:text="@string/asset_url_label"
                android:textAppearance="@style/TextAppearance.App.Title.Medium" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_url"
                style="@style/Widget.Departament.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_gutter"
                android:layout_marginTop="@dimen/space_8"
                android:layout_marginEnd="@dimen/screen_gutter">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_url"
                    style="@style/Widget.Departament.TextField.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:inputType="textUri|textMultiLine"
                    android:maxLines="4" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                style="@style/Widget.Departament.Button.Primary.Tall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_gutter"
                android:layout_marginTop="@dimen/space_24"
                android:layout_marginEnd="@dimen/screen_gutter"
                android:text="@string/editor_save" />

            <include
                android:id="@+id/row_delete"
                layout="@layout/view_row" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
