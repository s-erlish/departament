<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  servers/server/{guid} - Группа серверов.  H3 · R4.
  24-tab-conformance.md A-13.
  ============================================================================

  Was: two bare `EditText`s and two `Spinner`s - and §0.5.6 is blunt about the latter,
  «zero Spinner survives». Both become rows: the group type cycles its two values in
  place, and the subscription opens the editors' sheet. Save and delete come off the
  ActionBar A-38 removes.

  The old file also carried `tools:context=".ui.ServerCustomConfigActivity"` - it was
  copied from the custom-config screen and never corrected, which is how the two
  screens ended up with the same shape and neither of them the right one.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".ui.ServerGroupActivity">

    <include
        android:id="@+id/toolbar"
        layout="@layout/view_toolbar" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_32"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:paddingStart="@dimen/screen_gutter"
                android:paddingEnd="@dimen/screen_gutter"
                android:text="@string/srv_name_label"
                android:textAppearance="@style/TextAppearance.App.Title.Medium" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_remarks"
                style="@style/Widget.Departament.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_gutter"
                android:layout_marginTop="@dimen/space_8"
                android:layout_marginEnd="@dimen/screen_gutter">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_remarks"
                    style="@style/Widget.Departament.TextField.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <include
                android:id="@+id/row_group_type"
                layout="@layout/view_row" />

            <include
                android:id="@+id/row_group_sub"
                layout="@layout/view_row" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:paddingStart="@dimen/screen_gutter"
                android:paddingEnd="@dimen/screen_gutter"
                android:text="@string/srv_group_filter"
                android:textAppearance="@style/TextAppearance.App.Title.Medium" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Departament.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_gutter"
                android:layout_marginTop="@dimen/space_8"
                android:layout_marginEnd="@dimen/screen_gutter"
                app:helperText="@string/srv_group_filter_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_policy_group_filter"
                    style="@style/Widget.Departament.TextField.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                style="@style/Widget.Departament.Button.Primary.Tall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_gutter"
                android:layout_marginTop="@dimen/space_24"
                android:layout_marginEnd="@dimen/screen_gutter"
                android:text="@string/editor_save" />

            <include
                android:id="@+id/row_delete"
                layout="@layout/view_row" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
