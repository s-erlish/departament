<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  A-14  servers/provider/{id} - форма подписки.  H3 · R4.
  24-tab-conformance.md A-14.
  ============================================================================

  Was: five bare `EditText`s, two `AutoCompleteTextView`s with an `ImageButton`
  absolutely positioned over each one, and three `SwitchCompat`es whose labels were
  separate TextViews in a horizontal LinearLayout - so the label was not part of the
  control and tapping it did nothing. Save and delete were toolbar menu items.

  Now: the shared field block (label, 56 field, reserved helper and error slot), three
  `Row.Toggle`s where the whole row toggles, the two dropdown buttons folded into
  their fields' end icons, one Primary.Tall «Сохранить» and a `Row.Destructive`
  «Удалить подписку».

  The interval field is grouped WITH the auto-update toggle it belongs to, because a
  number that only matters when a switch is on belongs under that switch.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".ui.SubEditActivity">

    <include
        android:id="@+id/toolbar"
        layout="@layout/view_toolbar" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_32"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:paddingStart="@dimen/screen_gutter"
                android:paddingEnd="@dimen/screen_gutter"
                android:text="@string/subs_ed_name"
                android:textAppearance="@style/TextAppearance.App.Title.Medium" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_remarks"
                style="@style/Widget.Departament.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_gutter"
                android:layout_marginTop="@dimen/space_8"
                android:layout_marginEnd="@dimen/screen_gutter">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_remarks"
                    style="@style/Widget.Departament.TextField.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:paddingStart="@dimen/screen_gutter"
                android:paddingEnd="@dimen/screen_gutter"
                android:text="@string/subs_ed_url"
                android:textAppearance="@style/TextAppearance.App.Title.Medium" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_url"
                style="@style/Widget.Departament.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_gutter"
                android:layout_marginTop="@dimen/space_8"
                android:layout_marginEnd="@dimen/screen_gutter">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_url"
                    style="@style/Widget.Departament.TextField.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:inputType="textUri|textMultiLine"
                    android:maxLines="4"
                    tools:ignore="TextFields" />
            </com.google.android.material.textfield.TextInputLayout>

            <include
                android:id="@+id/row_enable"
                layout="@layout/view_row" />

            <!-- ============================================== Автообновление -->
            <TextView
                style="@style/SettingsSectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/subs_ed_section_update" />

            <include
                android:id="@+id/row_auto_update"
                layout="@layout/view_row" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:paddingStart="@dimen/screen_gutter"
                android:paddingEnd="@dimen/screen_gutter"
                android:text="@string/subs_ed_interval"
                android:textAppearance="@style/TextAppearance.App.Title.Medium" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_update_interval"
                style="@style/Widget.Departament.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_gutter"
                android:layout_marginTop="@dimen/space_8"
                android:layout_marginEnd="@dimen/screen_gutter"
                app:helperText="@string/subs_ed_interval_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_update_interval"
                    style="@style/Widget.Departament.TextField.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="number"
                    android:maxLines="1"
                    tools:ignore="TextFields" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ================================================ Дополнительно -->
            <TextView
                style="@style/SettingsSectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/subs_ed_section_advanced" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/screen_gutter"
                android:paddingEnd="@dimen/screen_gutter"
                android:text="@string/subs_ed_user_agent"
                android:textAppearance="@style/TextAppearance.App.Title.Medium" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_user_agent"
                style="@style/Widget.Departament.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_gutter"
                android:layout_marginTop="@dimen/space_8"
                android:layout_marginEnd="@dimen/screen_gutter"
                app:helperText="@string/subs_ed_user_agent_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_user_agent"
                    style="@style/Widget.Departament.TextField.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:paddingStart="@dimen/screen_gutter"
                android:paddingEnd="@dimen/screen_gutter"
                android:text="@string/subs_ed_filter"
                android:textAppearance="@style/TextAppearance.App.Title.Medium" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Departament.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_gutter"
                android:layout_marginTop="@dimen/space_8"
                android:layout_marginEnd="@dimen/screen_gutter"
                app:helperText="@string/subs_ed_filter_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_filter"
                    style="@style/Widget.Departament.TextField.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <include
                android:id="@+id/row_allow_insecure"
                layout="@layout/view_row" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:paddingStart="@dimen/screen_gutter"
                android:paddingEnd="@dimen/screen_gutter"
                android:text="@string/subs_ed_pre_profile"
                android:textAppearance="@style/TextAppearance.App.Title.Medium" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_pre_profile"
                style="@style/Widget.Departament.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_gutter"
                android:layout_marginTop="@dimen/space_8"
                android:layout_marginEnd="@dimen/screen_gutter"
                app:endIconContentDescription="@string/subs_ed_profile_pick"
                app:endIconDrawable="@drawable/ic_arrow_drop_down"
                app:endIconMode="custom"
                app:helperText="@string/subs_ed_profile_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_pre_profile"
                    style="@style/Widget.Departament.TextField.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:paddingStart="@dimen/screen_gutter"
                android:paddingEnd="@dimen/screen_gutter"
                android:text="@string/subs_ed_next_profile"
                android:textAppearance="@style/TextAppearance.App.Title.Medium" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_next_profile"
                style="@style/Widget.Departament.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_gutter"
                android:layout_marginTop="@dimen/space_8"
                android:layout_marginEnd="@dimen/screen_gutter"
                app:endIconContentDescription="@string/subs_ed_profile_pick"
                app:endIconDrawable="@drawable/ic_arrow_drop_down"
                app:endIconMode="custom"
                app:helperText="@string/subs_ed_profile_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_next_profile"
                    style="@style/Widget.Departament.TextField.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                style="@style/Widget.Departament.Button.Primary.Tall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_gutter"
                android:layout_marginTop="@dimen/space_24"
                android:layout_marginEnd="@dimen/screen_gutter"
                android:text="@string/editor_save" />

            <include
                android:id="@+id/row_delete"
                layout="@layout/view_row" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
