<?xml version="1.0" encoding="utf-8"?>
<!--
  A-30 «Облачная копия» - the WebDAV credentials form.

  Four bare `EditText`s with their labels used as PLACEHOLDERS, which §0.5.5 rules
  out: a placeholder disappears the moment the user types, so a half-filled form
  cannot be read back. Every field now carries a label above it, the 56dp box, and a
  helper line that survives the typing.

  The password field takes Material's own reveal toggle rather than a bespoke eye
  button, so the control is the platform's and carries its own accessible name.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_8"
        android:paddingTop="@dimen/space_8"
        android:paddingEnd="@dimen/space_8"
        android:paddingBottom="@dimen/space_8">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/webdav_url_label"
            android:textAppearance="@style/TextAppearance.App.Title.Medium" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_webdav_url"
            style="@style/Widget.Departament.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            app:helperText="@string/webdav_url_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_webdav_url"
                style="@style/Widget.Departament.TextField.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="textUri"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/webdav_user_label"
            android:textAppearance="@style/TextAppearance.App.Title.Medium" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Departament.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_webdav_user"
                style="@style/Widget.Departament.TextField.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="username"
                android:imeOptions="actionNext"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/webdav_pass_label"
            android:textAppearance="@style/TextAppearance.App.Title.Medium" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Departament.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_webdav_pass"
                style="@style/Widget.Departament.TextField.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="password"
                android:imeOptions="actionNext"
                android:inputType="textPassword"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/webdav_path_label"
            android:textAppearance="@style/TextAppearance.App.Title.Medium" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Departament.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            app:helperText="@string/webdav_path_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_webdav_remote_path"
                style="@style/Widget.Departament.TextField.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</ScrollView>
