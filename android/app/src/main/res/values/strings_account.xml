    <!-- Subscriptions -->
    <string name="account_subs_header">Мои подписки</string>
    <!-- «departament» is lower case in every string on both platforms — owner ruling B2. -->
    <string name="account_no_subscription">Купите тариф, чтобы подключаться к серверам departament.</string>
    <string name="account_empty_title">Подписки пока нет</string>
    <string name="account_error_load_title">Не удалось загрузить данные</string>
    <string name="account_retry">Повторить</string>
    <!-- The SAME row when the live connected count is not known for this подписка.
         GET /client/subscription/all does not carry one (SubscriptionDtos: «NOT present on
         /all — always 0 from this endpoint»), and only the ACTIVE подписка has a
         /client/devices call behind it, so every secondary card was printing the root's
         figure as if it were its own. The allowance is real and stays; the usage is not
         known and is not invented. -->
    <string name="account_unlimited">∞</string>

    <!-- The subscription card's own controls, brought across from the desktop's AccountView.
         «Продлить» is shown on a perpetual подписка too — owner ruling, «она должна быть и при
         бессрочной подписке». -->
    <string name="account_sub_renew">Продлить</string>
    <string name="account_sub_autorenew">Автопродление</string>
    <string name="account_sub_autorenew_on">Автопродление включено</string>
    <string name="account_sub_autorenew_next">Спишется %1$s · %2$s</string>
    <string name="account_sub_autorenew_off">Автопродление выключено</string>
    <string name="account_sub_autorenew_failed">Не удалось изменить автопродление</string>
    <!-- The traffic meter on the subscription card. Unlimited plans state the figure used and
         say so, because a bar with no ceiling encodes nothing. -->
    <string name="account_meter_traffic_over">Лимит исчерпан</string>
    <!-- The подписка carries no traffic payload — every secondary подписка, whose endpoint
         does not return one. The meter STAYS and says so: a card with a hole where the
         figure belongs is what reads as unfinished. -->
    <string name="account_meter_traffic_none">Нет данных</string>

    <!-- THE TRAFFIC RING's caption, under the 28sp figure in the middle of the disc
         (handoff README §5.2: «в центре «2,0 ТБ» и «без ограничений»» / «"1,9 ТБ" и "из 5 ТБ"»).

         Both are transcribed verbatim from the prototype, and neither duplicates the meter
         strings above: those state a figure AND its ceiling in one line («1,9 ТБ из 5 ТБ»,
         «1,9 ТБ · безлимит») because the meter is a bar with a label beside it. The ring
         splits the two — the figure is the hero line, the ceiling is the caption under it —
         so the ceiling has to be sayable on its own. Reusing the meter strings here would
         print the figure twice inside a 172dp disc. -->
    <string name="account_ring_unlimited">без ограничений</string>
    <string name="account_ring_of">из %1$s</string>

    <!-- «Способы входа»: what this account can be signed in with — Telegram and the site — and
         each row names the account it is actually linked to rather than only the method.

         THE TWO STATE LINES ARE SHARED BY BOTH ROWS. They are not Telegram's private copy: the
         sentences are «Привязан · …» and «Не привязан», which say nothing about the method, and
         both agree in gender with «Telegram» and with «Сайт» alike. A second pair spelling the
         same two words would be a second name for one string, which this project does not do.
         Their keys keep the older word because an id is not copy; see @string/auth_btn_email. -->
    <string name="account_login_methods">Способы входа</string>
    <string name="account_login_telegram">Telegram</string>
    <string name="account_login_telegram_linked">Привязан · %1$s</string>
    <string name="account_login_telegram_unlinked">Не привязан</string>
    <!-- ТРЕТЬЕ СОСТОЯНИЕ СТРОКИ «ПОЧТА», и оно существует потому, что привязка адреса пароля НЕ
         задаёт: `verify-link-email` на панели пишет только `email`. Аккаунт с адресом и без пароля
         по этой почте не пускает, и до сих пор строка про это молчала — говорила «Привязан» и вела
         в смену адреса, то есть предлагала чинить не то.

         СОСТОЯНИЕ ВПЕРЕДИ АДРЕСА, как и у «Привязан · …». Строка в одну линию с многоточием: если
         адрес длинный, обрезается он, а не новость. Тап ведёт в «Придумайте пароль» — тот же шаг,
         что и сразу после привязки. -->
    <string name="account_login_email_no_password">Нужен пароль для входа · %1$s</string>
    <!-- «в аккаунте добавь кнопку где способы входа туда сайт, чтобы можно было привязать почту
         с сайта». One word, and it is the SAME word the two sign-in surfaces use for this door, so
         the row and the button are recognisably one thing.

         IT WAS «Сайт», on the grounds that the e-mail is what the row REPORTS while the site is the
         way in. The way in moved: registration and sign-in both happen in the app now, the door
         says «Войти по почте», and a row still called «Сайт» would send the user looking for a
         browser that is no longer part of it.

         И СТРОКА НАКОНЕЦ ЧТО-ТО ДЕЛАЕТ. Она вела на экран входа, который для вошедшего человека
         закрывается сам, — то есть для того единственного, кто по ней нажимает (вошёл через
         Telegram, хочет добавить адрес), не делала ничего. Теперь она открывает «Привязку почты»:
         одно поле, письмо со ссылкой, ожидание. Когда адрес есть, строка его называет и никуда не
         ведёт — смены адреса в приложении нет. -->
    <string name="account_login_site">Почта</string>

    <!-- Payments history -->
