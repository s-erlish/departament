    <!-- WARNING: ServerActivity uses this array as BOTH the spinner labels and the persisted
         values (ServerActivity.kt:428,595 → ProfileItem.browserDialerMode), and
         CoreServiceManager.kt:275,278 compares that field against the literals "OkHttp"/"WebView".
         Translating an item silently disables browser dialer. Keep it untranslated until
         ServerActivity is switched over to the parallel @array/browser_dialer_mode_value. -->
    <string-array name="browser_dialer_mode" translatable="false">
