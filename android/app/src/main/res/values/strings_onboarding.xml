<?xml version="1.0" encoding="utf-8"?>
<!--
  НАЧАЛЬНЫЙ ЭКРАН — README §2.

  Формулировки взяты из прототипа дословно (решение владельца: «тексты дизайна —
  закон»). Три строки этот файл НЕ заводит, потому что они уже есть с тем же
  текстом и заводить второе имя для одного слова нельзя:
  @string/home_empty_add_clipboard «Добавить из буфера обмена»,
  @string/home_empty_add_qr «Добавить по QR-коду»,
  @string/home_gate_add_subscription «Добавить подписку».
-->
<resources>
    <!-- Заголовок начального экрана. 24sp/700. -->
    <string name="onb_title">Приветствуем!</string>

    <!-- Подзаголовок, состояние «буфер пуст». Высота слота зарезервирована под
         две строки, поэтому смена на onb_sub_found ничего не двигает. -->
    <string name="onb_sub_empty">Войдите в аккаунт, и подписка добавится сама.</string>

    <!-- Подзаголовок, состояние «в буфере ссылка». -->
    <string name="onb_sub_found">Нашли ссылку в буфере обмена. Или войдите, и подписка добавится сама.</string>

    <!-- Карточка найденной подписки. Имя подписки НЕ показывается нигде (§3) —
         в карточке стоит родовое «Подписка». -->
    <string name="onb_clip_title">Подписка</string>
    <string name="onb_clip_sub">Ссылка в буфере обмена</string>

    <!-- Основное действие входа. Глиф в фирменном синем, подпись обычная. -->
    <string name="onb_login_telegram">Войти через Telegram</string>

    <!-- Раскрывающийся блок с двумя оставшимися способами. -->
    <string name="onb_more">Другие способы</string>

    <!-- Единственный вход в LoginActivity с начального экрана. Раньше здесь было
         «Войти через сайт», и это перестало быть правдой: за этой дверью теперь и
         вход, и РЕГИСТРАЦИЯ, и обе целиком в приложении — «а регистрации внутри
         приложения не увидел, там регистрация через сайт идёт». Дверь называет
         способ (почта), а не чужое место (сайт). -->
    <string name="onb_login_site">Войти по почте</string>
</resources>
