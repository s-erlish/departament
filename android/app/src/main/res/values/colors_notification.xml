<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        ЦВЕТ БЕЙДЖА УВЕДОМЛЕНИЯ — тот, которым система заливает кружок вокруг знака.

        NotificationCompat.setColor не красит текст и не красит саму карточку: он задаёт заливку
        круглого бейджа, в котором рисуется малый значок, и подсветку служебных элементов строки.
        Здесь стоял синий #4C8DFF, и владелец попросил белый: «когда он в спокойном состоянии у
        него не синий фон должен быть, сделай белый».

        Знак внутри бейджа система рисует сама, подбирая контраст к этой заливке, поэтому на белом
        кружке марка выйдет тёмной — это её работа, а не наша, и переопределить это нечем.

        ОДНА ОГОВОРКА, КОТОРУЮ СТОИТ ЗНАТЬ. Начиная с Android 12 система прогоняет переданный цвет
        через собственную проверку контраста к фону шторки и вправе его сдвинуть. На тёмной шторке
        белый останется белым; на светлой система может его приглушить, чтобы бейдж не исчез на
        белом фоне. Это поведение платформы, а не сборки.
    -->
    <color name="notification_badge">#FFFFFF</color>

</resources>
