<?xml version="1.0" encoding="utf-8"?>
<!--
  ШТОРКА — три состояния уведомления о туннеле и слова к ним.

  Владелец: «надо в шторку сделать кнопку паузы, чтобы можно было остановить впн и потом
  обратно включить прям из шторки». До этого действие было одно, «Остановить», и оно уносило
  уведомление вместе со службой — включать обратно из шторки становилось нечем.

  ПОЧЕМУ «Пауза», а не «Приостановить». Правило продукта — глаголы, и «Приостановить» ему
  отвечает лучше. Но в строке действий уведомления на кнопку приходится половина ширины строки,
  и рядом стоит «Остановить»: тринадцать букв обрезаются в «Приостано…», а два действия начинают
  выглядеть одним словом дважды. «Пауза» — пять букв, ни с чем не сливается, и это ровно то
  слово, которым владелец назвал кнопку. Ответ на неё — «Возобновить», глагол.

  «Подключение…» — та же формулировка, что у @string/home_status_connecting,
  @string/connection_connecting и @string/toast_status_connecting: одно состояние продукта
  называется во всех четырёх местах одинаково. Строка своя, а не переиспользованная, потому что
  у каждой из тех троих свой экран и свой размер; общая формулировка держится списком, не
  ссылкой.

  Отдельный файл, а не строки в strings.xml, — по той же причине, что и strings_home_pill.xml:
  над деревом одновременно работают несколько агентов, и strings.xml читает каждый.
-->
<resources>
    <!-- Действия ongoing-уведомления. «Остановить» живёт в strings.xml и не переезжает. -->
    <string name="notification_action_pause">Пауза</string>
    <string name="notification_action_resume">Возобновить</string>

    <!-- Вторая строка уведомления. Пусто её не бывает: либо состояние, либо ничего. -->
    <string name="notification_state_paused">На паузе</string>
    <string name="notification_state_connecting">Подключение…</string>
</resources>
