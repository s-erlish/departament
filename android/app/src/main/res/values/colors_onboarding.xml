<?xml version="1.0" encoding="utf-8"?>
<!--
  Единственный цвет, который не может прийти из темы: фирменный синий Telegram.

  §2.6 и §8 задают его числом — #2AABEE, — и это марка чужого продукта, а не роль
  в палитре: она не светлеет в светлой теме и не обесцвечивается вместе с нашими.
  Поэтому это @color, а не ?attr. Используется РОВНО в двух местах: глиф на кнопке
  «Войти через Telegram» и глиф в кольце прогрузки. Ни подписи, ни заливки,
  ни обводки этим цветом нет — бюджет акцента экрана он не тратит.

  Всё остальное на обоих экранах — ?attr/... : кольца и свечение это
  ?attr/colorPrimary с прозрачностью на самой вьюхе, поэтому светлая и
  чёрно-белая темы работают без единого зашитого числа.
-->
<resources>
    <color name="telegram_brand">#2AABEE</color>
</resources>
