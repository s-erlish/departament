    <color name="mono_onPrimary">#FFFFFF</color>
    <color name="mono_primaryContainer">#E6E6E8</color>
    <color name="mono_onPrimaryContainer">#111214</color>
    <color name="mono_secondary">#3A3A3D</color>
    <color name="mono_onSecondary">#FFFFFF</color>
    <color name="mono_secondaryContainer">#E6E6E8</color>
    <color name="mono_onSecondaryContainer">#111214</color>
