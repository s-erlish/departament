    <color name="icon_tile_blue">#334C8DFF</color>
    <color name="icon_tile_red">#33F04452</color>

    <!-- The neutral tile has no colour resource any more. It reads
         ?attr/colorSurfaceContainerHighest for the fill and
         ?attr/colorOnSurfaceVariant for the glyph — same pixels in both live
         themes, and ThemeOverlay.Mono can re-point an attribute where it could
         never re-point @color/icon_tile_neutral. See Widget.Departament.Tile. -->

    <!-- Primary colors - main tone: departament blue -->
    <color name="md_theme_primary">#1E5FC7</color>
