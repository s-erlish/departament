<?xml version="1.0" encoding="utf-8"?>
<!--
  Colour tokens - LIGHT theme, plus the shared Layer 1 primitives and the mono
  (light base) set. values-night/colors.xml overrides the dark column.

  Three blocks, in this order (10-design-system.md 4.1):
    LAYER 1  primitives. No meaning, never referenced from a layout.
    LAYER 2  semantic. What a layout and a theme attribute may name.
    MONO     the third theme, applied via ThemeOverlay.Mono.

  Two standing rules from 00-rules.md 3 and 6:
    - A new colour carries a comment saying what it is for AND its measured
      contrast ratio against the surface it actually sits on. Every ratio in this
      file was computed (WCAG 2.1 relative luminance), not estimated.
    - Floors: body text 4.5:1, large text (>=24sp, or >=16sp at 700) 3:1, icons
      and control boundaries 3:1, placeholder text 4.5:1. Disabled content is
      exempt (WCAG 1.4.3) and must not be "fixed".
-->
<resources>
    <!-- ============================================================= -->
    <!-- LAYER 1: PRIMITIVES (10-design-system.md 1.1).                 -->
    <!-- These carry NO meaning: ink_11 is a near-black, not "the card". -->
    <!-- Nothing in a layout, a drawable or a style may name one - they  -->
    <!-- exist so the semantic layer has a closed, auditable palette to  -->
    <!-- alias, and so a theme change is a re-alias, not a re-invention. -->
    <!-- Numeric suffix ~= lightness on 0-100. Contrast claims live on   -->
    <!-- the semantic aliases below, not here.                           -->
    <!-- ============================================================= -->

    <!-- Ink ramp: the near-black neutrals, dark-theme spine. -->
    <color name="ink_00">#000000</color>
    <color name="ink_04">#08090B</color>
