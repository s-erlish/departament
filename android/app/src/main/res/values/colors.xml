    <color name="md_theme_surfaceTint">#1E5FC7</color>
    <color name="md_theme_scrim">#000000</color>

    <!-- ============================================================= -->
    <!-- LAYER 2 ADDITIONS (light). 2026-07 token wave: D-9, D-10,      -->
    <!-- accent interaction steps, selection fill, skeleton.            -->
    <!-- Wire each into AppThemeBase in themes.xml (10-design 4.7).      -->
    <!-- Ratios below are computed against the LIGHT surfaces:           -->
    <!-- surface #FFFFFF, background #F4F7FC, inset #E3EAF4.             -->
    <!-- ============================================================= -->

    <!-- D-9, ?attr/colorOutlineControl. THE boundary of a control: input field,
         outlined button, segmented track. Light measures: 3.45:1 on surface
         #FFFFFF, 3.21:1 on background #F4F7FC - both clear the WCAG 1.4.11 3:1
         floor for a UI component boundary. It exists because colorOutline
         #C3CCDC measures 1.62:1 on white and 1.45:1 on the dark ground and may
         never draw a control edge. On the inset plane #E3EAF4 it is 2.85:1, so a
         field on P3 in the light theme needs its fill lifted or its border
         darkened - do not ship that pair as-is.
         colorOutlineVariant keeps the 1dp hairline role at 1.29:1: structural
         decoration, not a control boundary, and 1.4.11 does not apply to it. -->
    <color name="md_theme_outlineControl">@color/paper_50</color>

    <!-- ?attr/colorOnSurfaceDim. The dimmed glyph tone, one step below
         onSurfaceVariant: a chevron or a decorative glyph that must recede
         without becoming disabled. 9.31:1 on surface, 8.67:1 on background,
         7.69:1 on the inset plane. Not for text that must be read as content -
         that is onSurfaceVariant #54607A (6.30:1 on surface). -->
    <color name="md_theme_onSurfaceDim">@color/paper_28</color>

    <!-- ?attr/warning. The "истекает" / "ждёт оплаты" hue and nothing else: it
         never becomes a button, a link or a selection colour (00-rules 1.4.1).
         5.43:1 on surface, 5.06:1 on background - AA as a glyph or as text on a
         plain plane. On its own chip fill it is NOT legible: see warning_text. -->
    <color name="warning">@color/amber_40</color>

    <!-- ?attr/warningContainer. The amber status-chip fill, light. 1.13:1 against
         surface - a fill delta, not a boundary, so 1.4.11 does not apply. -->
    <color name="warning_container">#FBF1D3</color>

    <!-- D-10, ?attr/warningText. On light, a status chip's text is NOT the status
         hue: #8A6300 on its own 18% fill measures 4.24:1 and fails AA. This
         darkened token measures 6.72:1 on warning_container #FBF1D3 (5.92:1 on a
         true amber-18%-over-white composite #EAE3D1, also AA). On DARK the chip
         fill is dark enough that the hue itself clears AA (7.51:1), which is why
         the two columns of this token differ. -->
    <color name="color_warning_text">@color/amber_28</color>
    <!-- Alias: 10-design-system.md 4.1/4.7 spells this warning_text and expects
         themes.xml to bind ?attr/warningText to it; D-10 spells it
         color_warning_text. One value, both spellings. -->
    <color name="warning_text">@color/color_warning_text</color>

    <!-- D-10 success-on-chip text, light. Green #0B7D4A on its own 18% fill is
         4.04:1 and fails AA; #065132 measures 7.34:1 on the spec's green chip
         fill #D3E8DE and 7.18:1 on the currently-shipped md_theme_tertiaryContainer
         #A8F0CE, so it is safe on either. Dark keeps the hue (#22C55E, 6.53:1 on
         the dark chip fill). Pair with ?attr/pingGood when the themes wiring
         lands; do NOT use onSurfaceVariant on a tinted fill (00-rules 6.7). -->
    <color name="color_success_text">@color/green_32</color>

    <!-- D-10 destructive-on-chip text, light. DEVIATION, stated openly: D-10
         names #C42B32 for this token, but #C42B32 IS the light destructive hue,
         and on the red chip fill it measures 4.22:1 - the exact failure D-10
         exists to remove (its own reason line quotes "4.22:1 red ... fails AA").
         10-design-system.md 1.1.4 defines red_38 #9B1B23 as "red text on a light
         red chip" and 2.3 measures it at 6.13:1 on the #F4D9DA fill, so the more
         specific table wins: 6.13:1 on #F4D9DA, 6.31:1 on the currently-shipped
         md_theme_errorContainer #FFDAD6. If the owner wants D-10's literal hex
         instead, change this one line to @color/red_45 and accept 4.22:1.
         Dark uses #FF6069 (5.65:1 on the dark red chip fill). -->
    <color name="color_destructive_text">@color/red_38</color>

    <!-- Accent interaction steps, light. One step DARKER than the accent, never
         lighter, never a hue flip. These are fills; the label on them is
         md_theme_onPrimary #FFFFFF, measuring 7.07:1 on accent_hover and 8.46:1
         on accent_pressed. As a text or glyph colour on surface they are 7.07:1 /
         8.46:1. Android has no hover state (00-rules 7.1) - accent_hover is a
         parity token for pointer devices and desktop, accent_pressed backs the
         pressed fill of a filled control. -->
    <color name="accent_hover">#1A54B4</color>
    <color name="accent_pressed">#17499E</color>

    <!-- 12% accent fill: THE selected-item surface (22-components 18). Composites
         to #E4ECF8 over surface and #DAE5F6 over background; onSurface #111826 on
         those measures 14.93:1 and 13.97:1. Selection always carries a second
         channel (accent glyph + weight 700) - tint alone is never a state. -->
    <color name="accent_fill_12">#1F1E5FC7</color>
    <!-- Alias: 10-design-system.md 4.1 and the bg_row_selected drawable spell
         this state_selected. Same 12% fill. -->
    <color name="state_selected">@color/accent_fill_12</color>
    <!-- 10% accent, the Android pressed/ripple overlay. Not a resting fill. -->
    <color name="state_press">#1A1E5FC7</color>

    <!-- ?attr/colorSkeleton. Loading placeholder bar, pulsing 0.45 <-> 1.0 over
         motion_pulse 1000ms. Equals the inset plane: 1.21:1 against surface,
         which is correct - a skeleton is a shape, not text, and onSurface over it
         is 14.67:1 once real content arrives. -->
    <color name="skeleton">@color/paper_89</color>

    <!-- ============================================================= -->
