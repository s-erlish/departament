<?xml version="1.0" encoding="utf-8"?>
<!-- BOTTOM-NAVIGATION touch feedback, on rung 2 of the press ladder (handoff
     README §1): scale 0.965, in @integer/motion_press_in 70ms on ease_press_in,
     out @integer/motion_press_out 200ms on ease_press_out.

     A nav destination is a discrete tappable OBJECT in a bar, not a slice of a
     surface — its background is @null, so there is nothing to tear — and rung 1
     (0.975) is for slabs, so it presses like a button. It was 0.92 at hard-coded
     100/120ms with no interpolator at all, i.e. linear; one gesture may not have
     three different numbers, which is the defect §1 exists to close.

     Why it scales at all: the owner forbids a ripple glow on the bottom
     navigation, so scale is the only acknowledgement this control is allowed,
     and a tap with no feedback inside 100ms is a defect of its own.

     This file is otherwise identical to @anim/press_button and exists only so
     the three hand-rolled nav item containers in activity_main.xml keep a named
     animator of their own. When the nav becomes a real M3 navigation bar, delete
     it and its three references together, not before. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator
                android:duration="@integer/motion_press_in"
                android:interpolator="@interpolator/ease_press_in"
                android:propertyName="scaleX"
                android:valueTo="0.965"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="@integer/motion_press_in"
                android:interpolator="@interpolator/ease_press_in"
                android:propertyName="scaleY"
                android:valueTo="0.965"
                android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator
                android:duration="@integer/motion_press_out"
                android:interpolator="@interpolator/ease_press_out"
                android:propertyName="scaleX"
                android:valueTo="1.0"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="@integer/motion_press_out"
                android:interpolator="@interpolator/ease_press_out"
                android:propertyName="scaleY"
                android:valueTo="1.0"
                android:valueType="floatType" />
        </set>
    </item>
</selector>
