<?xml version="1.0" encoding="utf-8"?>
<!-- LEGACY SPELLING OF RUNG 2. Identical to @anim/press_button: scale 0.965, in
     @integer/motion_press_in 70ms on ease_press_in, out
     @integer/motion_press_out 200ms on ease_press_out.

     It was ONE press value for the whole product (0.97 on the 90/160 clock),
     which is why it is called press_scale rather than press_button. The handoff
     README §1 replaces that single value with a four-rung ladder — row/card
     0.975, button/chip/option 0.965, borderless icon 0.88, connect 0.97 — so
     "the press scale" is no longer a thing that exists and the name no longer
     says what the file does.

     The file stays, and stays correct, because deleting a token that thirty-odd
     layouts reference is how a wave breaks screens it never opened. NEW WORK
     NAMES THE RUNG: @anim/press_row, @anim/press_button, @anim/press_icon,
     @anim/press_connect. A call site still pointing here is telling you it has
     not been visited yet. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator
                android:duration="@integer/motion_press_in"
                android:interpolator="@interpolator/ease_press_in"
                android:propertyName="scaleX"
                android:valueTo="0.965"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="@integer/motion_press_in"
                android:interpolator="@interpolator/ease_press_in"
                android:propertyName="scaleY"
                android:valueTo="0.965"
                android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator
                android:duration="@integer/motion_press_out"
                android:interpolator="@interpolator/ease_press_out"
                android:propertyName="scaleX"
                android:valueTo="1.0"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="@integer/motion_press_out"
                android:interpolator="@interpolator/ease_press_out"
                android:propertyName="scaleY"
                android:valueTo="1.0"
                android:valueType="floatType" />
        </set>
    </item>
</selector>
