<UserControl
    x:Class="departament.Desktop.Views.LoginView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:departament.Desktop.Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vms="clr-namespace:departament.Desktop.ViewModels"
    d:DesignHeight="760"
    d:DesignWidth="380"
    x:DataType="vms:AccountViewModel"
    mc:Ignorable="d">

    <!--
        Экран «Вход» departament (порт Android LoginActivity.kt + strings_auth.xml).
        КОМПАКТНОЕ окно (~360–380px): бесшовный тулбар «← Вход», единая центрированная колонка
        контента (MaxWidth 440), фирменный щит-логотип, заголовок + подзаголовок, CTA Telegram
        (акцент, самолётик) и CTA сайта (тональная), поля Incy, блок 2FA (6 сегментных ячеек).
        Два экрана состояния переключает code-behind С ДВИЖЕНИЕМ (кроссфейд, а не мгновенный IsVisible):
          • MethodBlock — выбор способа входа + форма сайта + 2FA + строка ошибки;
          • AwaitingBlock — сфокусированное ожидание подтверждения в Telegram (кольцо + «дышащий»
            самолётик + текст + «Открыть Telegram» + «Начать заново» + «Другой способ входа»).
        Incy: pure dark + один синий #4C8DFF, Space Grotesk, sentence-case Russian, сетка 4/8/12/16/24,
        radius chip 12 / input 14 / button 16 / card 20. Состояния (idle / awaiting-TG / loading-site /
        2FA / success / error) — по AccountViewModel.CurrentLoginState. Моушен-токены Ease.*/Dur.* и
        Geo.Check / Brush.RedText берутся из GlobalResources (Фаза 0). Поле = ГЛОБАЛЬНЫЙ TextBox.Incy.
    -->

    <UserControl.Resources>
        <!--  Глифы (порт Android res/drawable, Material 24dp).  -->
        <!--  Стрелка «назад» тулбара (arrow_back).  -->
        <StreamGeometry x:Key="Geo.Login.Back">M20,11H7.83l5.59,-5.59L12,4l-8,8 8,8 1.41,-1.41L7.83,13H20v-2z</StreamGeometry>
        <!--  Фирменный щит (bg_connect, filled) — логотип departament на экране входа.  -->
        <StreamGeometry x:Key="Geo.Login.Shield">M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3z</StreamGeometry>
        <!--  Telegram (ic_telegram_24dp, viewport 1024) — контурный бумажный самолётик.  -->
        <StreamGeometry x:Key="Geo.Login.Telegram">M912.2,154A85.3,85.3 0,0 0,853.3 128a85.3,85.3 0,0 0,-33.3 6.8l-708.3,306.8a42.7,42.7 0,0 0,-26.5 42.7V512a42.7,42.7 0,0 0,29.4 42.7L298.7,616.1l55.5,187.3a75.9,75.9 0,0 0,56.3 53.3,62.7 62.7,0 0,0 15.4,0 73.8,73.8 0,0 0,50.8 -20.5l67.8,-64 131.4,103.7a85.3,85.3 0,0 0,90 9.4l14.1,-7.3a88.3,88.3 0,0 0,46.5 -62.7L938.7,235.1a90,90 0,0 0,-26.5 -81.1zM763.7,805.1a25.2,25.2 0,0 1,-12.8 17.5l-14.1,7.3a19.6,19.6 0,0 1,-9 2.1,19.6 19.6,0 0,1 -12.4,-4.7l-160.4,-128a20.9,20.9 0,0 0,-27.7 0l-94.7,89.2a11.1,11.1 0,0 1,-6 2.1V640a21.8,21.8 0,0 1,6.8 -15.8c136.1,-128 217.6,-199.7 266.2,-240.6a15.8,15.8 0,0 0,5.1 -11.1,13.7 13.7,0 0,0 -4.3,-11.1 14.9,14.9 0,0 0,-17.9 -4.3l-322.6,203.5a21.3,21.3 0,0 1,-18.3 0L149.3,494.9l694.2,-301.2a16.6,16.6 0,0 1,7.7 0,22.2 22.2,0 0,1 16.2,7.7 26.9,26.9 0,0 1,6.8 23.5z</StreamGeometry>
        <!--  Глаз password-toggle: «показать» (visibility) / «скрыть» (visibility_off).  -->
        <StreamGeometry x:Key="Geo.Login.Eye">M12,4.5C7,4.5 2.73,7.61 1,12c1.73,4.39 6,7.5 11,7.5s9.27,-3.11 11,-7.5c-1.73,-4.39 -6,-7.5 -11,-7.5zM12,17c-2.76,0 -5,-2.24 -5,-5s2.24,-5 5,-5 5,2.24 5,5 -2.24,5 -5,5zM12,9c-1.66,0 -3,1.34 -3,3s1.34,3 3,3 3,-1.34 3,-3 -1.34,-3 -3,-3z</StreamGeometry>
        <StreamGeometry x:Key="Geo.Login.EyeOff">M12,7c2.76,0 5,2.24 5,5 0,0.65 -0.13,1.26 -0.36,1.83l2.92,2.92c1.51,-1.26 2.7,-2.89 3.43,-4.75 -1.73,-4.39 -6,-7.5 -11,-7.5 -1.4,0 -2.74,0.25 -3.98,0.7l2.16,2.16C10.74,7.13 11.35,7 12,7zM2,4.27l2.28,2.28 0.46,0.46C3.08,8.3 1.78,10.02 1,12c1.73,4.39 6,7.5 11,7.5 1.55,0 3.03,-0.3 4.38,-0.84l0.42,0.42L19.73,22 21,20.73 3.27,3 2,4.27zM7.53,9.8l1.55,1.55c-0.05,0.21 -0.08,0.43 -0.08,0.65 0,1.66 1.34,3 3,3 0.22,0 0.44,-0.03 0.65,-0.08l1.55,1.55c-0.67,0.33 -1.41,0.53 -2.2,0.53 -2.76,0 -5,-2.24 -5,-5 0,-0.79 0.2,-1.53 0.53,-2.2zM11.84,9.02l3.15,3.15 0.02,-0.16c0,-1.66 -1.34,-3 -3,-3l-0.17,0.01z</StreamGeometry>
        <!--  Google «G» (одноцветный силуэт — кнопка «Скоро» неактивна, мультиколор был бы неуместен в mono).  -->
        <StreamGeometry x:Key="Geo.Login.Google">M12,11v2.4h5.6c-0.24,1.5 -1.7,4.4 -5.6,4.4 -3.37,0 -6.12,-2.79 -6.12,-6.2S8.63,5.4 12,5.4c1.92,0 3.2,0.82 3.94,1.52l2.68,-2.58C16.9,2.7 14.66,1.8 12,1.8 6.9,1.8 2.8,5.9 2.8,11S6.9,20.2 12,20.2c5.9,0 9.8,-4.15 9.8,-9.99 0,-0.67 -0.07,-1.18 -0.16,-1.69L12,11z</StreamGeometry>
        <!--  Конверт (mail) — глиф пред-состояний «письмо отправлено».  -->
        <StreamGeometry x:Key="Geo.Login.Mail">M20,4H4c-1.1,0 -1.99,0.9 -1.99,2L2,18c0,1.1 0.9,2 2,2h16c1.1,0 2,-0.9 2,-2V6c0,-1.1 -0.9,-2 -2,-2zM20,8l-8,5 -8,-5V6l8,5 8,-5v2z</StreamGeometry>
        <!--  Глобус (public) — глиф «Войти через сайт» (браузер-хэндофф), тот же, что демотированная ссылка сайта в онбординге.  -->
        <StreamGeometry x:Key="Geo.Login.Globe">M12,2C6.48,2 2,6.48 2,12s4.48,10 10,10 10,-4.48 10,-10S17.52,2 12,2zM11,19.93c-3.95,-0.49 -7,-3.85 -7,-7.93 0,-0.62 0.08,-1.21 0.21,-1.79L9,15v1c0,1.1 0.9,2 2,2v1.93zM17.9,17.39c-0.26,-0.81 -1,-1.39 -1.9,-1.39h-1v-3c0,-0.55 -0.45,-1 -1,-1H8v-2h2c0.55,0 1,-0.45 1,-1V7h2c1.1,0 2,-0.9 2,-2v-0.41c2.93,1.19 5,4.06 5,7.41 0,2.08 -0.8,3.97 -2.1,5.39z</StreamGeometry>

        <!--  Тема поля Incy теперь ГЛОБАЛЬНАЯ (GlobalResources.axaml → TextBox.Incy). Локальный дубль
              удалён (P0): поля ссылаются на Theme="{StaticResource TextBox.Incy}" — рендерятся 1:1.  -->
    </UserControl.Resources>

    <UserControl.Styles>
        <!--  Кнопка «назад» тулбара — глобальный Button.BackNav. Линк-действие (LinkAction),
              тональная 48h, Primary/Tall, focus-кольца — тоже глобальные (GlobalStyles).  -->

        <!--  СВЕЧЕНИЯ ПРИ НАВЕДЕНИИ НЕТ (общее правило приложения): подложка вспыхивала на всю
              кнопку разом и читалась как моргание. Держим фон прозрачным и под курсором — иначе
              тема Semi подставит свой светлый токен. Отклик остаётся на нажатии.  -->
        <Style Selector="Button.LinkAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.LinkAction:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
        </Style>

        <!--  Высокая тональная (52h) — вторичный CTA формы сайта, чтобы совпадать по высоте с
              Primary.Tall (глобально .Tall задан только для Primary).  -->
        <Style Selector="Button.Tonal.Tall">
            <Setter Property="Height" Value="52" />
        </Style>

        <!--  ===== Сегмент «Вход | Регистрация» =====
              Трек SurfaceVariant (radius chip), два равных таба. Активный таб — приподнятая плитка
              Brush.Bg + жирный OnSurface; неактивный — прозрачный, OnSurfaceVariant. Индикатор
              нейтральный (не синий): ЕДИНСТВЕННЫЙ акцент остаётся за CTA Telegram. Смена цвета/фона
              плавная (150мс), без движения — под lite просто мгновенная.  -->
        <Style Selector="Border.SegTrack">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceVariant}" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Chip}" />
        </Style>
        <Style Selector="Button.SegItem">
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
            <Setter Property="BorderThickness" Value="0" />
            <!--  Концентрично треку (Radius.Chip 12 − 4 паддинг = 8), а не off-scale 10.  -->
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.Grotesk}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <!--  Неактивный таб под курсором не заливается — правило то же.  -->
        <Style Selector="Button.SegItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.SegItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
        </Style>
        <Style Selector="Button.SegItem.segActive">
            <Setter Property="Background" Value="{DynamicResource Brush.Bg}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.SegItem.segActive:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.Bg}" />
        </Style>

        <!--  «Скоро» — маленький нейтральный чип-подпись на неактивной провайдер-кнопке (Google).  -->
        <Style Selector="Border.SoonPill">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceVariant}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--  Флеш-рамка поля при Unauthorized (§3.5): класс .fieldError красит ВНУТРЕННЮЮ рамку
              PART_BorderElement в Brush.Red. UserControl-стиль перекрывает :focus/:pointerover темы
              (приоритет источника выше ControlTheme), поэтому вспышка видна даже на сфокусированном
              поле. Возврат к OutlineVariant/Accent идёт по BrushTransition шаблона (150мс) —
              никакого shake/bounce, только цвет.  -->
        <Style Selector="TextBox.fieldError /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Red}" />
        </Style>

        <!--  Маска пароля (§A3): лёгкий глиф • (U+2022) вместо тяжёлого ● (U+25CF) + межбуквенный
              трекинг на самом презентере (не на всём TextBox, иначе разъехались бы email/watermark) —
              точки «дышат», а не слипаются в жирную полосу. Каретка/выделение — акцент из TextBox.Incy.  -->
        <Style Selector="TextBox.MaskField /template/ TextPresenter#PART_TextPresenter">
            <Setter Property="LetterSpacing" Value="2" />
        </Style>

        <!--  Скрытое реальное поле 2FA под сегментными ячейками: прозрачная рамка/фон даже в
              фокусе/наведении (визуал несут ячейки + focus-адорнер вокруг всей группы).  -->
        <Style Selector="TextBox.CodeInput /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <!--  Сегментная ячейка кода 2FA: 52h, radius 12, фон SurfaceVariant, 1px OutlineVariant.
              filled — рамка чуть плотнее (Outline); active — рамка Accent (следующая к вводу).
              Смена цвета плавная (BrushTransition 150мс), без движения.  -->
        <Style Selector="Border.CodeCell">
            <Setter Property="Height" Value="52" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceVariant}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.OutlineVariant}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Chip}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.CodeCell.filled">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Outline}" />
        </Style>
        <Style Selector="Border.CodeCell.active">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
        </Style>
        <Style Selector="TextBlock.CodeDigit">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.Numeric}" />
            <Setter Property="FontFeatures" Value="tnum,lnum,zero" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}" />
        </Style>

        <!--
            Спиннер: дуга ~25% окружности (Ellipse со штрих-пунктиром, приём ConnectHeroView),
            равномерное вращение только с классом .spinning (навешивает code-behind), центр —
            относительный origin «50%,50%» на самом Ellipse. Крутится и под «Облегчённым режимом»:
            спиннер — знак «идёт работа», а не украшение.
        -->
        <Style Selector="Ellipse.Spinner">
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Ellipse.Spinner.spinning">
            <Style.Animations>
                <Animation
                    Easing="LinearEasing"
                    IterationCount="Infinite"
                    Duration="0:0:1.1">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

    </UserControl.Styles>

    <!--  Фон прозрачный, как у остальных подэкранов (README «Хром окна»): под страницей лежит
          радиальный Brush.HomeGradient самого окна (windowShell), а шелл под стеком подэкранов погашен.
          Это тот же бренд-радиал, что под онбордингом, так что щит-логотип на push-переходе
          онбординг→вход стоит на одном фоне, во всех трёх темах.
          Раньше страница красила СВОЙ радиал от своих границ, то есть от строки под полосой заголовка:
          центр и радиус уезжали относительно радиала окна, и по кромке y=40 шла ступенька в 1–3 уровня
          во всю ширину. Вдобавок каждый кадр входа и выхода считал второй радиальный градиент на всё
          окно. Transparent, а не пусто: пустые места страницы по-прежнему ловят нажатия.
          Контраст на светлейшем стопе #1B2D50: подзаголовок / поля (SurfaceVariant-заливка) /
          RedText-ошибки держат ≥4.5:1 (подзаголовок ≈4.6:1, как онбординг; поля несут собственную
          заливку/рамку, ошибки — крупный RedText). Никакого glow/ring за щитом — он бренд-марка,
          а не индикатор состояния (это язык connect-героя).  -->
    <Grid Background="Transparent" RowDefinitions="Auto,*">

        <!--  ============ Бесшовный тулбар суб-страницы: «← Вход» ============  -->
        <Border Grid.Row="0" Classes="SubToolbar">
            <Grid ColumnDefinitions="Auto,*">
                <Button
                    x:Name="BackButton"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Classes="IconButton BackNav">
                    <PathIcon Data="{StaticResource Geo.Login.Back}" />
                </Button>
                <TextBlock
                    x:Name="ToolbarTitle"
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Classes="Headline"
                    Text="{loc:T Login_SignIn}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <!--  ============ Контент: скролл, gutter 16, центрированная колонка ≤440 ============  -->
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Panel Margin="16,8,16,28">
                <!--  Обёртка = Panel (z-стек): MethodBlock и AwaitingBlock ПЕРЕКРЫВАЮТСЯ в одной ячейке,
                      чтобы кроссфейд между ними шёл без пустого кадра. HAlign=Stretch + MaxWidth 440:
                      заполняет компактное окно, центрируется на широком.  -->
                <Panel MaxWidth="440" HorizontalAlignment="Stretch">

                    <!--  ==================== MethodBlock: выбор способа входа ====================  -->
                    <StackPanel
                        x:Name="MethodBlock"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Stretch"
                        RenderTransformOrigin="50%,50%">

                        <!--  Фирменный щит-логотип: плитка 64, радиус 20, фон Tile.Blue, глиф Accent 30.
                              RenderTransformOrigin 50%,50% — чтобы entrance scale-in 0.90→1 (§3b, общий с
                              connect-героем) центрировался, а не «проваливался» в угол.  -->
                        <Border
                            x:Name="ShieldTile"
                            Width="64"
                            Height="64"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource Brush.Tile.Blue}"
                            CornerRadius="{DynamicResource Radius.Card}"
                            RenderTransformOrigin="50%,50%">
                            <PathIcon
                                Width="30"
                                Height="30"
                                Data="{StaticResource Geo.Login.Shield}"
                                Foreground="{DynamicResource Brush.Accent}" />
                        </Border>

                        <!--  Вордмарк departament (паритет с онбордингом: общий щит + вордмарк — единая
                              бренд-идентичность на переходе онбординг↔вход). Бренд-имя не переводится.  -->
                        <TextBlock
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            Classes="Title"
                            Text="departament" />

                        <!--  Заголовок + подзаголовок (по центру, sentence-case). Текст меняется по режиму
                              (вход/регистрация) в code-behind (ApplyMode). Ритм: title 16.  -->
                        <TextBlock
                            x:Name="TitleText"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Stretch"
                            Classes="Headline"
                            Text="{loc:T Login_Title}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="SubtitleText"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"
                            Classes="Body"
                            Foreground="{DynamicResource Brush.OnSurfaceVariant}"
                            Text="{loc:T Login_Subtitle}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />

                        <!--  Сегмент «Вход | Регистрация» — переключает режим формы (ApplyMode). Оба таба
                              равной ширины; активный — приподнятая нейтральная плитка (не синяя).  -->
                        <Border
                            x:Name="ModeSegment"
                            Margin="0,16,0,0"
                            Classes="SegTrack">
                            <Grid ColumnDefinitions="*,*">
                                <Button
                                    x:Name="SignInTab"
                                    Grid.Column="0"
                                    Classes="SegItem"
                                    Content="{loc:T Login_TabSignIn}" />
                                <Button
                                    x:Name="RegisterTab"
                                    Grid.Column="1"
                                    Classes="SegItem"
                                    Content="{loc:T Login_TabRegister}" />
                            </Grid>
                        </Border>

                        <!--  Email (auth_email_hint). Enter переводит фокус на пароль. Форма email/пароля —
                              первичный способ входа: CTA Telegram/сайт демотированы ПОД форму (§A2), чтобы
                              путь email/сайт не «зажимался» самолётиком сверху. Ритм: email 24.  -->
                        <TextBox
                            x:Name="EmailBox"
                            Margin="0,24,0,0"
                            Text="{Binding LoginEmail, Mode=TwoWay}"
                            Theme="{StaticResource TextBox.Incy}"
                            PlaceholderText="{loc:T Login_Email}" />
                        <!--  Живая подсказка невалидного email (auth_email_invalid). Текст = RedText.  -->
                        <TextBlock
                            x:Name="EmailError"
                            Margin="0,8,0,0"
                            Classes="Caption"
                            Foreground="{DynamicResource Brush.RedText}"
                            IsVisible="False"
                            Text="{loc:T Login_EmailInvalid}"
                            TextWrapping="Wrap" />

                        <!--  Пароль (auth_password_hint) + глаз (password_toggle). Enter = войти.  -->
                        <TextBox
                            x:Name="PasswordBox"
                            Margin="0,12,0,0"
                            Classes="MaskField"
                            PasswordChar="•"
                            Text="{Binding LoginPassword, Mode=TwoWay}"
                            Theme="{StaticResource TextBox.Incy}"
                            PlaceholderText="{loc:T Login_Password}">
                            <TextBox.InnerRightContent>
                                <Button
                                    x:Name="TogglePasswordButton"
                                    Width="40"
                                    Height="40"
                                    Padding="0"
                                    Classes="IconButton">
                                    <Panel>
                                        <PathIcon
                                            x:Name="EyeOnIcon"
                                            Width="20"
                                            Height="20"
                                            Data="{StaticResource Geo.Login.Eye}"
                                            Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
                                        <PathIcon
                                            x:Name="EyeOffIcon"
                                            Width="20"
                                            Height="20"
                                            Data="{StaticResource Geo.Login.EyeOff}"
                                            Foreground="{DynamicResource Brush.OnSurfaceVariant}"
                                            IsVisible="False" />
                                    </Panel>
                                </Button>
                            </TextBox.InnerRightContent>
                        </TextBox>

                        <!--  Подсказка требований к паролю — ТОЛЬКО в режиме регистрации (муто, не ошибка).  -->
                        <TextBlock
                            x:Name="RegisterPasswordHint"
                            Margin="0,8,0,0"
                            Classes="Caption"
                            Foreground="{DynamicResource Brush.OnSurfaceVariant}"
                            IsVisible="False"
                            Text="{loc:T Login_PasswordHint}"
                            TextWrapping="Wrap" />

                        <!--  Повтор пароля — ТОЛЬКО в режиме регистрации. Enter = создать аккаунт.  -->
                        <TextBox
                            x:Name="ConfirmPasswordBox"
                            Margin="0,12,0,0"
                            Classes="MaskField"
                            IsVisible="False"
                            PasswordChar="•"
                            Text="{Binding RegisterConfirmPassword, Mode=TwoWay}"
                            Theme="{StaticResource TextBox.Incy}"
                            PlaceholderText="{loc:T Login_ConfirmPassword}" />
                        <!--  Живая подсказка несовпадения паролей (RedText).  -->
                        <TextBlock
                            x:Name="ConfirmPasswordError"
                            Margin="0,8,0,0"
                            Classes="Caption"
                            Foreground="{DynamicResource Brush.RedText}"
                            IsVisible="False"
                            Text="{loc:T Login_PasswordMismatch}"
                            TextWrapping="Wrap" />

                        <!--  Первичный CTA формы — вход по email+паролю «Войти» (ЕДИНСТВЕННЫЙ залитый акцент
                              экрана) + спиннер поверх при SiteLoading. В режиме регистрации скрыт — его
                              заменяет RegisterSubmitButton ниже. Раньше был мислейбл «Войти через сайт»
                              (тональная): честный лейбл = это отправка email/пароля, а браузер-хэндофф
                              «Войти через сайт» демотирован в блок альтернатив ниже (§A1/§A2).  -->
                        <Panel x:Name="SiteButtonHost" Margin="0,16,0,0">
                            <Button
                                x:Name="SiteButton"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Classes="Primary Tall"
                                Command="{Binding LoginSiteCmd}">
                                <TextBlock
                                    x:Name="SiteButtonLabel"
                                    HorizontalAlignment="Center"
                                    TextAlignment="Center"
                                    Text="{loc:T Login_SubmitSignIn}" />
                            </Button>
                            <Ellipse
                                x:Name="SiteSpinner"
                                Width="22"
                                Height="22"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Classes="Spinner"
                                IsVisible="False"
                                RenderTransformOrigin="50%,50%"
                                Stroke="{DynamicResource Brush.Accent}"
                                StrokeDashArray="6.9,20.8"
                                StrokeLineCap="Round"
                                StrokeThickness="2.5" />
                        </Panel>

                        <!--  CTA регистрации «Создать аккаунт» — ТОЛЬКО в режиме регистрации. Залитый акцент
                              (в регистрации это единственное первичное действие) + инлайн-спиннер при RegisterLoading.  -->
                        <Panel x:Name="RegisterButtonHost" Margin="0,16,0,0" IsVisible="False">
                            <Button
                                x:Name="RegisterSubmitButton"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Classes="Primary Tall"
                                Command="{Binding RegisterCmd}">
                                <TextBlock
                                    x:Name="RegisterButtonLabel"
                                    HorizontalAlignment="Center"
                                    TextAlignment="Center"
                                    Text="{loc:T Login_CreateAccount}" />
                            </Button>
                            <Ellipse
                                x:Name="RegisterSpinner"
                                Width="22"
                                Height="22"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Classes="Spinner"
                                IsVisible="False"
                                RenderTransformOrigin="50%,50%"
                                Stroke="{DynamicResource Brush.Accent}"
                                StrokeDashArray="6.9,20.8"
                                StrokeLineCap="Round"
                                StrokeThickness="2.5" />
                        </Panel>

                        <!--  ==================== CTA поручений «Способов входа» ====================
                              Та же кнопка, тот же класс и тот же инлайн-спиннер, что у «Войти» и
                              «Создать аккаунт»: экран один, и третьего вида первичного действия у него
                              быть не должно. Отличается только НАДПИСЬ («Отправить ссылку» / «Сохранить
                              пароль») и команда — их ставит code-behind по виду поручения, поэтому
                              биндинга здесь нет. Виден только в поручениях; вход и регистрация его не
                              показывают, и ни одно состояние не рисует два первичных действия сразу.  -->
                        <Panel x:Name="ErrandButtonHost" Margin="0,16,0,0" IsVisible="False">
                            <Button
                                x:Name="ErrandButton"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Classes="Primary Tall">
                                <TextBlock
                                    x:Name="ErrandButtonLabel"
                                    HorizontalAlignment="Center"
                                    TextAlignment="Center" />
                            </Button>
                            <Ellipse
                                x:Name="ErrandSpinner"
                                Width="22"
                                Height="22"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Classes="Spinner"
                                IsVisible="False"
                                RenderTransformOrigin="50%,50%"
                                Stroke="{DynamicResource Brush.Accent}"
                                StrokeDashArray="6.9,20.8"
                                StrokeLineCap="Round"
                                StrokeThickness="2.5" />
                        </Panel>

                        <!--  «Пропустить» на шаге пароля: третичное действие тем же классом, что и
                              «Отправить снова» / «Вернуться ко входу» — шаг можно не делать, но по
                              умолчанию ведём в него, поэтому пропуск и выглядит как второстепенный.  -->
                        <Button
                            x:Name="SkipButton"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            Classes="LinkAction"
                            Foreground="{DynamicResource Brush.OnSurfaceVariant}"
                            IsVisible="False" />

                        <!--  Пассворлесс-ссылки — ТОЛЬКО в режиме входа: «Войти по ссылке» · «Забыли пароль?».  -->
                        <StackPanel
                            x:Name="PasswordlessLinks"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                x:Name="MagicLinkButton"
                                Classes="LinkAction"
                                Command="{Binding MagicLinkCmd}"
                                Content="{loc:T Login_MagicLink}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource Brush.OnSurfaceVariant}"
                                Text="·" />
                            <Button
                                x:Name="ForgotPasswordButton"
                                Classes="LinkAction"
                                Command="{Binding PasswordResetCmd}"
                                Content="{loc:T Login_ForgotPassword}" />
                        </StackPanel>

                        <!--  ==================== Альтернативные способы входа (ДЕМОТИРОВАНЫ под форму) ====================
                              §A2: раньше CTA Telegram стоял НАД формой email/сайта и «зажимал» её. Теперь форма
                              email — первична (её «Войти» — единственный залитый акцент), а Telegram + браузер-
                              хэндофф «Войти через сайт» + «войти по коду» демотированы сюда, под разделитель «или»,
                              тональными/текст-действиями. Виден ТОЛЬКО в режиме входа (в регистрации скрыт).  -->
                        <StackPanel x:Name="AltMethodsBlock" Margin="0,24,0,0">
                            <!--  Разделитель «или»: две тонкие линии + подпись по центру.  -->
                            <Grid ColumnDefinitions="*,Auto,*">
                                <Border
                                    Grid.Column="0"
                                    Height="1"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Brush.OutlineVariant}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="12,0"
                                    Classes="Caption"
                                    Text="{loc:T Login_Or}" />
                                <Border
                                    Grid.Column="2"
                                    Height="1"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Brush.OutlineVariant}" />
                            </Grid>

                            <!--  ОДНА тональная альтернатива — Telegram (§A2): демотирован из первичного акцента,
                                  но остаётся заметным способом входа. Остальные (сайт / код / Google) — тихие
                                  текст-ссылки ниже, чтобы под формой НЕ было «стопки одинаковых кнопок» (AI-slop
                                  tell) и один filled-акцент оставался за «Войти». Активен, кроме опроса.  -->
                            <Button
                                x:Name="TelegramButton"
                                Margin="0,16,0,0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Classes="Tonal Tall">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <PathIcon
                                        Width="20"
                                        Height="20"
                                        Data="{StaticResource Geo.Login.Telegram}"
                                        Foreground="{DynamicResource Brush.OnSurface}" />
                                    <TextBlock VerticalAlignment="Center" Text="{loc:T Common_SignInTelegram}" />
                                </StackPanel>
                            </Button>

                            <!--  «Войти через сайт» — браузер-хэндофф (§A1), теперь тихой ссылкой (не второй
                                  тональной кнопкой): открывает /app-login сайта, где залогиненная веб-сессия
                                  чеканит одноразовый код и возвращает его в приложение по departamentvpn://auth.  -->
                            <Button
                                x:Name="SiteBrowserButton"
                                Margin="0,14,0,0"
                                HorizontalAlignment="Center"
                                Classes="LinkAction"
                                Command="{Binding LoginBrowserCmd}">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <PathIcon
                                        Width="18"
                                        Height="18"
                                        Data="{StaticResource Geo.Login.Globe}"
                                        Foreground="{DynamicResource Brush.Accent}" />
                                    <TextBlock VerticalAlignment="Center" Text="{loc:T Common_SignInWebsite}" />
                                </StackPanel>
                            </Button>

                            <!--  «У меня есть код» — ручной фолбэк браузер-хэндоффа (§A1 #5): для платформ/кейсов,
                                  где callback-схема не срабатывает. Ссылка разворачивает поле для вставки кода
                                  (иная формулировка, чтобы не все действия начинались с «Войти…»).  -->
                            <Button
                                x:Name="CodeEntryToggle"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Center"
                                Classes="LinkAction"
                                Content="{loc:T Login_ByCode}" />
                            <StackPanel x:Name="CodeEntryHost" Margin="0,8,0,0" IsVisible="False">
                                <TextBox
                                    x:Name="HandoffCodeBox"
                                    Text="{Binding HandoffCodeInput, Mode=TwoWay}"
                                    Theme="{StaticResource TextBox.Incy}"
                                    PlaceholderText="{loc:T Login_CodePaste}" />
                                <Button
                                    x:Name="CodeSubmitButton"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Classes="Tonal Tall"
                                    Command="{Binding LoginByCodeCmd}"
                                    Content="{loc:T Login_SubmitSignIn}" />
                            </StackPanel>

                            <!--  Google — ЧЕСТНО неактивная «Скоро», ДЕМОТИРОВАНА из hero-слота (§A4) в
                                  самый низ альтернатив текст-действием, а не полновесной кнопкой.  -->
                            <Button
                                x:Name="GoogleButton"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Center"
                                Classes="LinkAction"
                                Foreground="{DynamicResource Brush.OnSurfaceVariant}"
                                IsEnabled="False">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <PathIcon
                                        Width="18"
                                        Height="18"
                                        Data="{StaticResource Geo.Login.Google}"
                                        Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
                                    <TextBlock VerticalAlignment="Center" Text="{loc:T Login_ContinueGoogle}" />
                                    <Border Classes="SoonPill">
                                        <TextBlock
                                            Classes="Caption"
                                            Foreground="{DynamicResource Brush.OnSurfaceVariant}"
                                            Text="{loc:T Login_ComingSoon}" />
                                    </Border>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!--  Блок 2FA (TOTP): виден только когда бэкенд запросил код (layout_2fa).  -->
                        <StackPanel
                            x:Name="TwoFaBlock"
                            Margin="0,16,0,0"
                            IsVisible="False">
                            <Border Height="1" Background="{DynamicResource Brush.OutlineVariant}" />
                            <TextBlock
                                Margin="0,16,0,0"
                                HorizontalAlignment="Stretch"
                                Classes="Body"
                                Foreground="{DynamicResource Brush.OnSurfaceVariant}"
                                Text="{loc:T Login_EnterCode}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />

                            <!--  6 сегментных ячеек + скрытое реальное поле-источник истины поверх.
                                  Реальный TextBox (CodeBox) держит ввод/вставку/клавиатуру/автофокус;
                                  ячейки — только визуал, отражают цифры. Прозрачный CodeBox сверху
                                  ловит клики/фокус (Transparent hit-testable), его текст/каретка скрыты.  -->
                            <Panel Margin="0,12,0,0">
                                <UniformGrid x:Name="CodeCells" Columns="6">
                                    <Border Classes="CodeCell"><TextBlock Classes="CodeDigit" /></Border>
                                    <Border Classes="CodeCell"><TextBlock Classes="CodeDigit" /></Border>
                                    <Border Classes="CodeCell"><TextBlock Classes="CodeDigit" /></Border>
                                    <Border Classes="CodeCell"><TextBlock Classes="CodeDigit" /></Border>
                                    <Border Classes="CodeCell"><TextBlock Classes="CodeDigit" /></Border>
                                    <Border Classes="CodeCell"><TextBlock Classes="CodeDigit" /></Border>
                                </UniformGrid>
                                <TextBox
                                    x:Name="CodeBox"
                                    Classes="CodeInput"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CaretBrush="Transparent"
                                    FontFamily="{DynamicResource Font.Numeric}"
                                    FontFeatures="tnum,lnum,zero"
                                    FontSize="20"
                                    Foreground="Transparent"
                                    MaxLength="6"
                                    SelectionBrush="Transparent"
                                    Text="{Binding TwoFaCode, Mode=TwoWay}"
                                    TextAlignment="Center"
                                    Theme="{StaticResource TextBox.Incy}" />
                            </Panel>
                            <!--  Живая подсказка (auth_code_invalid). Текст = RedText.  -->
                            <TextBlock
                                x:Name="CodeError"
                                Margin="0,8,0,0"
                                Classes="Caption"
                                Foreground="{DynamicResource Brush.RedText}"
                                IsVisible="False"
                                Text="{loc:T Login_CodeIs6}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                            <Panel Margin="0,12,0,0">
                                <Button
                                    x:Name="ConfirmButton"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Classes="Primary Tall"
                                    Command="{Binding Submit2FaCmd}">
                                    <TextBlock
                                        x:Name="ConfirmButtonLabel"
                                        HorizontalAlignment="Center"
                                        TextAlignment="Center"
                                        Text="{loc:T Login_Confirm}" />
                                </Button>
                                <Ellipse
                                    x:Name="ConfirmSpinner"
                                    Width="22"
                                    Height="22"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Classes="Spinner"
                                    IsVisible="False"
                                    RenderTransformOrigin="50%,50%"
                                    Stroke="{DynamicResource Brush.Accent}"
                                    StrokeDashArray="6.9,20.8"
                                    StrokeLineCap="Round"
                                    StrokeThickness="2.5" />
                            </Panel>
                        </StackPanel>

                        <!--  Строка ошибки (tv_error): RedText, по центру, только реальный диагностик.  -->
                        <TextBlock
                            x:Name="ErrorLine"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Stretch"
                            Classes="Body"
                            Foreground="{DynamicResource Brush.RedText}"
                            IsVisible="False"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!--  ==================== ЭКРАНА ОЖИДАНИЯ ЗДЕСЬ БОЛЬШЕ НЕТ ====================
                          Был AwaitingBlock: «Ожидаем подтверждения в Telegram» + кольцо с самолётиком +
                          «Открыть Telegram» / «Начать заново» / «Другой способ входа». Владелец его
                          убрал: на одно действие приходилось два ожидания подряд, причём второе — по
                          старому лекалу. Теперь «Войти через Telegram» СРАЗУ открывает экран прогрузки
                          (AccountSyncView), и ждёт подтверждения он — шагом 0 «Открываем Telegram ·
                          Подтвердите вход в приложении», ровно как в пакете (shots/H_tg_step0).
                          Сам ОПРОС никуда не делся и не изменился: его ведёт AuthManager (2 с между
                          запросами, 3 минуты предела, переходный сбой пережидается, 410/401
                          останавливают сразу, поздний ответ не входит за спиной у закрытого окна).  -->

                    <!--  ==================== EmailPendingBlock: письмо отправлено ====================
                          Общий пред-экран трёх пассворлесс-состояний (подтвердите почту · magic-ссылка
                          отправлена · сброс пароля отправлен). Заголовок/подсказка/действия задаёт
                          code-behind (ConfigureEmailPending) по виду состояния. Кольцо-спиннер крутится
                          ТОЛЬКО для verify-email (идёт поллинг логина); для magic/reset — статичный «отправлено».
                          ЗАМЕНЯЕТ MethodBlock тем же кроссфейдом, что AwaitingBlock.  -->
                    <StackPanel
                        x:Name="EmailPendingBlock"
                        Margin="0,40,0,0"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Stretch"
                        IsVisible="False"
                        RenderTransformOrigin="50%,50%">
                        <Panel
                            Width="64"
                            Height="64"
                            HorizontalAlignment="Center">
                            <Ellipse
                                Width="64"
                                Height="64"
                                Stroke="{DynamicResource Brush.OutlineVariant}"
                                StrokeThickness="3" />
                            <Ellipse
                                x:Name="PendingSpinner"
                                Width="64"
                                Height="64"
                                Classes="Spinner"
                                RenderTransformOrigin="50%,50%"
                                Stroke="{DynamicResource Brush.Accent}"
                                StrokeDashArray="16.75,50.25"
                                StrokeLineCap="Round"
                                StrokeThickness="3" />
                            <PathIcon
                                Width="26"
                                Height="26"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="{StaticResource Geo.Login.Mail}"
                                Foreground="{DynamicResource Brush.Accent}" />
                        </Panel>
                        <TextBlock
                            x:Name="PendingTitle"
                            Margin="0,20,0,0"
                            HorizontalAlignment="Stretch"
                            Classes="Headline"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="PendingHint"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"
                            Classes="Body"
                            Foreground="{DynamicResource Brush.OnSurfaceVariant}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="ResendButton"
                            Margin="0,24,0,0"
                            HorizontalAlignment="Center"
                            Classes="LinkAction"
                            Content="{loc:T Login_Resend}" />
                        <Button
                            x:Name="BackToSignInButton"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Center"
                            Classes="LinkAction"
                            Content="{loc:T Login_BackToSignIn}"
                            Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
                    </StackPanel>

                    <!--  Транзиентная success-плашка (§3.4 fallback): показывается ТОЛЬКО когда success
                          пришёл, не показав AwaitingBlock (путь сайт/2FA) — 64 галочка там, где стоял CTA,
                          форма гаснет под ней. Оверлей синхронизации перекрывает хэндофф без пустого кадра.  -->
                    <Border
                        x:Name="SuccessBadge"
                        Width="64"
                        Height="64"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Brush.Tile.Blue}"
                        CornerRadius="{DynamicResource Radius.Card}"
                        IsVisible="False"
                        Opacity="0"
                        RenderTransformOrigin="50%,50%">
                        <PathIcon
                            Width="30"
                            Height="30"
                            Data="{StaticResource Geo.Check}"
                            Foreground="{DynamicResource Brush.Accent}" />
                    </Border>

                </Panel>
            </Panel>
        </ScrollViewer>
    </Grid>
</UserControl>
