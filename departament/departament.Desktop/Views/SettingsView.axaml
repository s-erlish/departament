<UserControl
    x:Class="departament.Desktop.Views.SettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:departament.Desktop.Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:departament.Desktop.Views"
    xmlns:vms="clr-namespace:departament.Desktop.ViewModels"
    x:DataType="vms:SettingsViewModel"
    Design.DataContext="{x:Static vms:SettingsViewModel.Design}"
    TextOptions.TextRenderingMode="Antialias"
    mc:Ignorable="d">

    <!--
        ВКЛАДКА «НАСТРОЙКИ» (блок 9a). Шесть разделов, состав строк — screens.md «Вкладка Настройки».
        ЗАГОЛОВКА СВЕРХУ НЕТ: раздел уже назван в навигации, второй раз его называть нечем.
        Колонка 760 по центру; на любой ширине окна раскладка одна, меняются только поля.

        ГЕОМЕТРИЯ СТРОКИ (tokens.md «Строка настроек»): высота от 56, плитка 40 со скруглением 10,
        глиф 22, отступ до текста 16, заголовок 13.5/1.35, подпись 12, значение 12.5, шеврон 18,
        разделитель НА ВСЮ ШИРИНУ карточки перед каждой строкой кроме первой.

        ЕДИНАЯ ВЫСОТА — не «получилась», а ЗАДАНА, двумя замками сразу (оба дефекта известны по
        Android-стороне этого же продукта, где строки разъехались):
          1) содержимое строки лежит в Grid ФИКСИРОВАННОЙ высоты 40 (= плитка). Плитка — самый
             высокий элемент строки, поэтому высота строки = 40 + 9 + 9 = 58 у ВСЕХ строк без
             исключения: с подписью и без, с тумблером, со значением, с окошком;
          2) подпись НЕ ПЕРЕНОСИТСЯ (NoWrap + многоточие). Вторая строка подписи — первая из двух
             причин разъехавшихся высот на Android; здесь она невозможна.
        Вторая причина там — у Material-тумблера минимальная высота больше плитки. Здешний
        ToggleSwitch.Row — трек 46×28, ниже плитки 40, и ему дополнительно снят MinHeight (см. стиль
        RowSwitch), так что и он высоту строки поднять не может.

        ОТКЛИК НА НАЖАТИЕ. У строки настроек его НЕТ, кроме ховера — так в прототипе: класс `.srow`
        несёт только `:hover` с фоном ховера, тогда как прогиб 0.985 живёт на `.row`
        (Главная, Аккаунт). Разница не случайна: строка настроек — ЯКОРЬ раскрытого окошка, а окошко
        лежит внутри неё, и любой масштаб на строке масштабировал бы вместе с ней и окошко. motion.md
        про это прямо говорит: «Масштаб не использовать — от него текст внутри дёргается». Поэтому
        единая лестница (GlobalStyles → cm:PressFeedback на Border.SettingRow) здесь ГАСИТСЯ одним
        сеттером ниже; сама лестница и её потребители на других экранах не тронуты.

        ОКОШКО У ЗНАЧЕНИЯ. Восемь строк (Режим · DNS · Пинг · Число Mux · Оформление · Язык ·
        Масштаб · Автообновление) отдают правую половину общему views:ValuePicker — он несёт
        значение, каретку и сам ValuePopup. Своего окошка этот экран не заводит. Контракт компонента
        исполняется здесь: карточка НЕ обрезает содержимое (ClipToBounds=False), а скругление
        крайних строк считает ValuePopup.RowCorners в code-behind.
    -->

    <UserControl.Resources>
        <!--  Токены tokens.md, которых нет в GlobalResources (файл занят другим агентом — заявка
              на промоушен в отчёте). Держим локально, чтобы вкладка совпадала с прототипом:
              «плитка 10» и «карточка 16» (в ветке Radius.Tile 12 и Radius.Card 20).  -->
        <CornerRadius x:Key="Radius.SetTile">10</CornerRadius>
        <CornerRadius x:Key="Radius.SetCard">16</CornerRadius>

        <!--  Векторные глифы 22. Плитки НЕЙТРАЛЬНЫЕ у всех строк без исключения — в прототипе цветной
              плитки в настройках нет ни одной, и «одна синяя строка» была бы иерархией на пустом месте.  -->
        <!--  Щит-контур (ic_shield_outline) — F0 = evenOdd, чтобы получить обводку.  -->
        <StreamGeometry x:Key="Geo.Set.Shield">F0 M12,2.2 L19.6,5.2 L19.6,11.4 C19.6,16.1 15.9,19.9 12,21.8 C8.1,19.9 4.4,16.1 4.4,11.4 L4.4,5.2 Z M12,4.7 L17.2,6.8 L17.2,11.4 C17.2,14.9 14.7,17.9 12,19.3 C9.3,17.9 6.8,14.9 6.8,11.4 L6.8,6.8 Z</StreamGeometry>
        <!--  Сетка приложений (ic_per_apps_24dp)  -->
        <StreamGeometry x:Key="Geo.Set.Grid">M4,8h4L8,4L4,4v4zM10,20h4v-4h-4v4zM4,20h4v-4L4,16v4zM4,14h4v-4L4,10v4zM10,14h4v-4h-4v4zM16,4v4h4L20,4h-4zM10,8h4L14,4h-4v4zM16,14h4v-4h-4v4zM16,20h4v-4h-4v4z</StreamGeometry>
        <!--  Глобус (ic_globe_24dp)  -->
        <StreamGeometry x:Key="Geo.Set.Globe">M12,2C6.48,2 2,6.48 2,12s4.48,10 10,10 10,-4.48 10,-10S17.52,2 12,2zM11,19.93c-3.95,-0.49 -7,-3.85 -7,-7.93 0,-0.62 0.08,-1.21 0.21,-1.79L9,15v1c0,1.1 0.9,2 2,2v1.93zM17.9,17.39c-0.26,-0.81 -1,-1.39 -1.9,-1.39h-1v-3c0,-0.55 -0.45,-1 -1,-1H8v-2h2c0.55,0 1,-0.45 1,-1V7h2c1.1,0 2,-0.9 2,-2v-0.41c2.93,1.19 5,4.06 5,7.41 0,2.08 -0.8,3.97 -2.1,5.39z</StreamGeometry>
        <!--  Щит-персона (ic_privacy_24dp, viewport 1024)  -->
        <StreamGeometry x:Key="Geo.Set.Privacy">M471.5,77.5a128,128 0,0 1,72.1 -2.6l8.9,2.6 256,85.3a128,128 0,0 1,87.3 113.6l0.3,7.8L896,512c0,101.6 -44.5,186 -103.2,253.1l-8.1,9 -12.1,12.8a618.2,618.2 0,0 1,-25 24.2l-12.8,11.4 -13,11a839.3,839.3 0,0 1,-127.7 86.5l-19.5,10.5 -17.5,9a101.4,101.4 0,0 1,-90.5 0l-18.9,-9.6c-40.1,-21.1 -93.9,-53.2 -145.9,-96.3l-12.9,-11 -12.8,-11.4a618.2,618.2 0,0 1,-24.9 -24.2l-12.1,-12.8 -8.1,-9c-55.9,-63.9 -98.9,-143.4 -102.9,-238.6L128,512L128,284.2A128,128 0,0 1,208.2 165.5l7.3,-2.7 256,-85.3zM512,661.3c-80.2,0 -151.1,40.3 -193.4,101.7 62,57.2 132.2,97.2 176.6,119a37.4,37.4 0,0 0,33.7 0c44.4,-21.9 114.6,-61.9 176.6,-119A234.4,234.4 0,0 0,512 661.3zM491.8,138.2l-256,85.3A64,64 0,0 0,192 284.2L192,512c0,78.5 32.9,146.4 81.5,204.2A298.2,298.2 0,0 1,512 597.3a298.2,298.2 0,0 1,238.5 118.8C799.1,658.4 832,590.5 832,512L832,284.2a64,64 0,0 0,-43.8 -60.7l-256,-85.3a64,64 0,0 0,-40.4 0zM512,298.7a128,128 0,1 1,0 256,128 128,0 0,1 0,-256zM512,362.7a64,64 0,1 0,0 128,64 64,0 0,0 0,-128z</StreamGeometry>
        <!--  Пинг / радар (ic_ping_24dp)  -->
