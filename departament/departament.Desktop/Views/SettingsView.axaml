        <StreamGeometry x:Key="Geo.Set.File">M537,85.3A85.3,85.3 0,0 1,597.3 110.3L828.3,341.3A85.3,85.3 0,0 1,853.3 401.7L853.3,810.7a128,128 0,0 1,-128 128L298.7,938.7a128,128 0,0 1,-128 -128L170.7,213.3a128,128 0,0 1,128 -128zM537,170.7L298.7,170.7a42.7,42.7 0,0 0,-42.7 42.7v597.3a42.7,42.7 0,0 0,42.7 42.7h426.7a42.7,42.7 0,0 0,42.7 -42.7L768,401.7L537,170.7zM512,384a42.7,42.7 0,0 1,42.4 37.7L554.7,426.7v85.3h85.3a42.7,42.7 0,0 1,5 85L640,597.3h-85.3v85.3a42.7,42.7 0,0 1,-85 5L469.3,682.7v-85.3L384,597.3a42.7,42.7 0,0 1,-5 -85L384,512h85.3v-85.3a42.7,42.7 0,0 1,42.7 -42.7z</StreamGeometry>
        <!--  О приложении / инфо (ic_about_24dp, viewport 1024)  -->
        <StreamGeometry x:Key="Geo.Set.About">M810.7,206.3A426.7,426.7 0,1 0,512 938.7h5.5A426.7,426.7 0,0 0,810.7 206.3zM771.8,765A360.1,360.1 0,0 1,517.1 874.7L512,874.7a362.7,362.7 0,0 1,-4.9 -725.3h3.4a362.7,362.7 0,0 1,261.3 615.7zM547.2,390a57.4,57.4 0,0 0,62.3 -55.3,39.3 39.3,0 0,0 -45,-42.7 58.9,58.9 0,0 0,-64 54.6c-1.7,26.9 13.9,43.3 46.7,43.3zM548.3,663.5c-5.5,0 -7.9,-7.3 -2.3,-28.2l31.1,-118c11.7,-42.7 7.9,-71.3 -15.8,-71.3 -28.4,0 -94.7,28.4 -152.5,76.4l11.7,19.4a181.3,181.3 0,0 1,56.1 -24.7c5.5,0 4.7,7.3 0,25.2l-27.3,112.2c-16.6,64 0,77.7 24.5,77.7s85.3,-21.3 141,-77.7l-13.4,-17.9a122.7,122.7 0,0 1,-53.1 26.9z</StreamGeometry>
        <!--  Резервное копирование (ic_backup_24dp, viewport 1024)  -->
        <StreamGeometry x:Key="Geo.Set.Backup">M864,192L704,192L704,96c0,-17.7 -14.3,-32 -32,-32L352,64c-9,0 -17.2,3.7 -22.9,9.7L137.7,265.1c-6,5.8 -9.7,14 -9.7,22.9v512c0,17.7 14.3,32 32,32h160v96c0,17.7 14.3,32 32,32h512c17.7,0 32,-14.3 32,-32L896,224c0,-17.7 -14.3,-32 -32,-32zM320,173.2L320,256h-82.8l82.8,-82.8zM192,768L192,320h160c17.7,0 32,-14.3 32,-32L384,128h256v64h-96c-9,0 -17.2,3.7 -22.9,9.7L329.7,393.1c-6,5.8 -9.7,14 -9.7,22.9v352L192,768zM512,301.2L512,384h-82.8l82.8,-82.8zM832,896L384,896L384,448h160c17.7,0 32,-14.3 32,-32L576,256h256v640z</StreamGeometry>
        <!--  Схемы URL / ссылка (ic_hub_url_scheme)  -->
        <StreamGeometry x:Key="Geo.Set.UrlScheme">M3.9,12c0,-1.71 1.39,-3.1 3.1,-3.1h4V7H7c-2.76,0 -5,2.24 -5,5s2.24,5 5,5h4v-1.9H7c-1.71,0 -3.1,-1.39 -3.1,-3.1zM8,13h8v-2H8v2zM17,7h-4v1.9h4c1.71,0 3.1,1.39 3.1,3.1s-1.39,3.1 -3.1,3.1h-4V17h4c2.76,0 5,-2.24 5,-5s-2.24,-5 -5,-5z</StreamGeometry>

        <!--  ==================== ТУМБЛЕР СТРОКИ ====================
              tokens.md «Тумблер»: 46×28, скругление 14, обводка 2.
                · выключен — трек «вариант поверхности» с контуром, бегунок 14, ход 5, цвет
                  приглушённых чернил;
                · включён  — трек и контур акцентные, бегунок 20, ход 20, белый.
              Обводка входит в габарит (box-sizing: border-box в прототипе), поэтому ход бегунка
              отсчитывается от ВНУТРЕННЕЙ кромки: 5 и 20 — координаты внутри поля 42×24.
              Всё движение 220 мс ease-out-quart (motion.md «Тумблер»): трек, контур, положение
              и РАЗМЕР бегунка.

              Почему не общий ToggleSwitch.iOS: там трек 52×32, бегунок 26 постоянного размера и
              без обводки — другая фигура. Прототип держит ОДИН тумблер на все экраны, поэтому
              правильное место этой ControlTheme — Assets/GlobalResources.axaml рядом с
              ToggleSwitch.iOS (файл занят другим агентом — заявка на промоушен в отчёте). До тех
              пор она живёт здесь и покрывает шесть тумблеров этой вкладки.

              Габарит трека НЕИЗМЕНЕН — его можно ставить прямо в шаблоне. Всё, что переключается
              состоянием (цвета, размер и ход бегунка), задаётся ТОЛЬКО селекторами: значение,
              записанное в шаблоне, стало бы локальным и перебило бы стиль :checked.  -->
        <ControlTheme x:Key="ToggleSwitch.Row" TargetType="ToggleSwitch">
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        x:Name="track"
                        Width="46"
                        Height="28"
                        BorderThickness="2"
                        CornerRadius="14">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition
                                    Duration="0:0:0.22"
                                    Easing="{StaticResource Ease.OutQuart}"
                                    Property="Background" />
                                <BrushTransition
                                    Duration="0:0:0.22"
                                    Easing="{StaticResource Ease.OutQuart}"
                                    Property="BorderBrush" />
                            </Transitions>
                        </Border.Transitions>
                        <!--  PART_MovingKnobs / PART_SwitchKnob — обязательные части ToggleSwitch (AVLN2205).  -->
                        <Panel x:Name="PART_MovingKnobs">
                            <Panel
                                x:Name="PART_SwitchKnob"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                                <Panel.Transitions>
                                    <Transitions>
                                        <TransformOperationsTransition
                                            Duration="0:0:0.22"
                                            Easing="{StaticResource Ease.OutQuart}"
                                            Property="RenderTransform" />
                                        <DoubleTransition
                                            Duration="0:0:0.22"
                                            Easing="{StaticResource Ease.OutQuart}"
                                            Property="Width" />
                                        <DoubleTransition
                                            Duration="0:0:0.22"
                                            Easing="{StaticResource Ease.OutQuart}"
                                            Property="Height" />
                                    </Transitions>
                                </Panel.Transitions>
                                <Ellipse x:Name="knobFill">
                                    <Ellipse.Transitions>
                                        <Transitions>
                                            <BrushTransition
                                                Duration="0:0:0.22"
                                                Easing="{StaticResource Ease.OutQuart}"
                                                Property="Fill" />
                                        </Transitions>
                                    </Ellipse.Transitions>
                                </Ellipse>
                            </Panel>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>

            <!--  ВЫКЛЮЧЕН  -->
            <Style Selector="^ /template/ Border#track">
                <Setter Property="Background" Value="{DynamicResource Brush.SurfaceVariant}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Outline}" />
            </Style>
            <Style Selector="^ /template/ Panel#PART_SwitchKnob">
                <Setter Property="Width" Value="14" />
                <Setter Property="Height" Value="14" />
                <Setter Property="RenderTransform" Value="translateX(5px)" />
            </Style>
            <Style Selector="^ /template/ Ellipse#knobFill">
                <Setter Property="Fill" Value="{DynamicResource Brush.OnSurfaceVariant}" />
            </Style>

            <!--  ВКЛЮЧЁН  -->
            <Style Selector="^:checked /template/ Border#track">
                <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
            </Style>
            <Style Selector="^:checked /template/ Panel#PART_SwitchKnob">
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="20" />
                <Setter Property="RenderTransform" Value="translateX(20px)" />
            </Style>
            <Style Selector="^:checked /template/ Ellipse#knobFill">
                <Setter Property="Fill" Value="White" />
            </Style>

            <!--  Выключенных тумблеров в этой вкладке сейчас нет; состояние держим ради полноты.  -->
            <Style Selector="^:disabled">
                <Setter Property="Opacity" Value="0.38" />
            </Style>
        </ControlTheme>

    </UserControl.Resources>

    <UserControl.Styles>
        <!--  Border.SettingRow (минимальная высота, ховер, кольцо фокуса, прогиб 0.985 через
              cm:PressFeedback) живёт в GlobalStyles. Здесь — только то, чем эта вкладка от него
              отличается, и её собственные потомки-селекторы.  -->

        <!--  Вертикальный паддинг 9 вместо 12: 40 (плитка) + 9 + 9 = 58 — высота строки прототипа.
              При 12 строка выросла бы до 64 и вкладка стала бы на треть экрана длиннее. Эта вкладка —
              ЕДИНСТВЕННЫЙ потребитель Border.SettingRow во всём приложении (проверено), поэтому
              локальная правка ничего больше не задевает; заявка на перенос 16,9 в GlobalStyles — в отчёте.

              ПРОГИБ СНЯТ (NaN): см. «ОТКЛИК НА НАЖАТИЕ» в шапке файла. Прототип не гнёт `.srow`, а
              масштаб на строке-якоре растянул бы и раскрытое окошко — запрещено motion.md. Ховер и
              кольцо фокуса из GlobalStyles остаются; лестница на других экранах не тронута.
              Одна строка, чтобы вернуть: убрать сеттер ниже.  -->
        <Style Selector="Border.SettingRow">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="loc:PressFeedback.Scale" Value="NaN" />
            <!--  ...но отклик на нажатие строке нужен — фоном (Brush.PressBg). Пока гасился только
                  масштаб, вместе с ним отключалась подписка на указатель, и строка не отвечала на
                  нажатие вообще. Ink разводит эти две вещи: класс .pressed вешается, трансформа
                  по-прежнему нет.  -->
            <Setter Property="loc:PressFeedback.Ink" Value="True" />
        </Style>

        <!--  Содержимое строки — фиксированные 40 (первый замок единой высоты, см. шапку файла).  -->
        <Style Selector="Border.SettingRow > Grid">
            <Setter Property="Height" Value="{DynamicResource Size.Tile}" />
        </Style>

        <!--  Разделитель 1px НА ВСЮ ШИРИНУ карточки (tokens.md). Не инсет: в прототипе линия у строк
              настроек идёт от края до края, инсет 72 — только у строк подэкранов.  -->
        <Style Selector="Border.SettingDivider">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource Brush.OutlineVariant}" />
        </Style>

        <!--  Плитка 40 со скруглением 10 (tokens.md), глиф 22 по центру.  -->
        <Style Selector="Border.SetTile">
            <Setter Property="Width" Value="{DynamicResource Size.Tile}" />
            <Setter Property="Height" Value="{DynamicResource Size.Tile}" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.SetTile}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Tile.Neutral}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.SetTile > PathIcon">
            <Setter Property="Width" Value="{DynamicResource Size.Glyph}" />
            <Setter Property="Height" Value="{DynamicResource Size.Glyph}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
        </Style>

        <!--  Текстовый блок строки: 16 до текста, 8 до правой половины, ничего не переносится.  -->
        <Style Selector="StackPanel.RowText">
            <Setter Property="Margin" Value="16,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--  Заголовок строки 13.5/1.35 (tokens.md «Строка настроек»). Одна строка с многоточием:
              длинное имя деградирует в «…», а не наезжает на значение и не режется по букве.  -->
        <Style Selector="TextBlock.RowTitle">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurface}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!--  Подпись 12/1.35. NoWrap — ВТОРОЙ замок единой высоты: перенос подписи на вторую строку
              и есть первая из двух причин разъехавшихся высот на Android-стороне.  -->
        <Style Selector="TextBlock.RowSub">
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!--  Значение строки-НАВИГАЦИИ 12.5, приглушённое (у строк с окошком значение полной яркости —
              это разница между «значение живёт там» и «значение меняется здесь», её ведёт ValuePicker).  -->
        <Style Selector="TextBlock.RowNavValue">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="MaxWidth" Value="170" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!--  Шеврон 18 — ТОЛЬКО у строк-навигаций (тап открывает суб-страницу). Каретка строк с
              окошком принадлежит ValuePicker, здесь её нет.  -->
        <Style Selector="PathIcon.Chevron">
            <!--  14, не 18: PathIcon заливает чернилами весь бокс, и 18 читались слишком жирным
                  шевроном. В прототипе бокс 18, а сам глиф внутри мелкий.  -->
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnSurfaceVariant}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>

        <!--  Заголовок раздела 15/700 sentence-case, паддинг 16/4/8 (прототип). НЕ мелкий ALL-CAPS.  -->
        <Style Selector="TextBlock.SettingsSection">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="4,16,4,8" />
        </Style>

        <!--  Карточка раздела: скругление 16, БЕЗ внутреннего паддинга и БЕЗ обрезки содержимого.
              ClipToBounds=False — контракт «окошка у значения»: обрезающая карточка срезала бы окошко
              нижней кромкой. Раз карточка больше не маскирует углы, скругление крайних строк считает
              ValuePopup.RowCorners (code-behind).  -->
        <Style Selector="Border.SetCard">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.OutlineVariant}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.SetCard}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ClipToBounds" Value="False" />
            <!--  Нижнего поля у карточки НЕТ: зазор до следующего раздела даёт верхний отступ 16 его
                  заголовка (прототип: padding:16px 4px 8px у заголовка, у карточки полей нет).
                  Собственное поле 8 добавляло бы к нему второй зазор — 24 вместо 16.  -->
            <Setter Property="Margin" Value="0" />
        </Style>

        <!--  Тумблер строки. MinHeight=0 — второй из двух известных источников неравных высот
              (у Material-тумблера он больше плитки). Здесь трек 46×28 < плитки 40, и снятый MinHeight
              гарантирует, что тумблер не поднимет строку ни при какой теме.
              Focusable/IsTabStop=False — таб-стоп и Enter/Space принадлежат самой СТРОКЕ.  -->
        <Style Selector="ToggleSwitch.RowSwitch">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>

        <!--  Правая половина строк с окошком.  -->
        <Style Selector="views|ValuePicker">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <!--  Прозрачный фон: общий Incy-градиент рисуется под хостом страниц (MainWindow), показываем его.  -->
    <ScrollViewer
        Background="Transparent"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">

        <!--  Колонка 760 по центру (прототип: max-width 760, внутренние поля 20). Заголовка сверху нет.

              Выравнивание — Stretch, а НЕ Center: при Center Avalonia отдаёт панели её собственную
              желаемую ширину, и колонка сжималась по самой длинной строке (карточки выходили ~430
              вместо 720, а вкладка — узкой лентой посреди экрана). Stretch + MaxWidth даёт ровно
              то, что нужно: ширина 720, а остаток свободного места делится поровну — то есть та же
              центровка, но колонка честно занимает свою ширину.

              720, а не 760, потому что в прототипе 760 — это ВНЕШНИЙ габарит колонки ВМЕСТЕ с
              полями по 20 (`max-width:760;padding:0 20px`), то есть карточки внутри — 720. В
              Avalonia Margin лежит СНАРУЖИ MaxWidth, поэтому ту же геометрию даёт 720 + поля 20.  -->
        <StackPanel
            MaxWidth="720"
            Margin="20,14,20,20"
            HorizontalAlignment="Stretch">

            <!--  ==================== ПОДКЛЮЧЕНИЕ ====================  -->
            <TextBlock Classes="SectionHeader SettingsSection" Text="{loc:T Settings_SecConnection}" />

            <Border x:Name="CardConnection" Classes="SetCard">
                <StackPanel>

                    <!--  Режим → окошко: TUN · Только прокси  -->
                    <Border x:Name="RowMode" Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Classes="SetTile">
                                <PathIcon Data="{StaticResource Geo.Set.Shield}" />
                            </Border>
                            <StackPanel Grid.Column="1" Classes="RowText">
                                <TextBlock Classes="RowTitle" Text="{loc:T Settings_Mode}" />
                            </StackPanel>
                            <views:ValuePicker
                                x:Name="PickMode"
                                Grid.Column="2"
                                Anchor="{Binding #RowMode}"
                                Options="{Binding ModeOptions}"
                                SelectedIndex="{Binding ModeIndex, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <Border Classes="SettingDivider" />

                    <!--  Прокси по приложениям → подэкран, значение приглушено  -->
                    <Border x:Name="RowPerApp" Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <Border Grid.Column="0" Classes="SetTile">
                                <PathIcon Data="{StaticResource Geo.Set.Grid}" />
                            </Border>
                            <StackPanel Grid.Column="1" Classes="RowText">
                                <TextBlock Classes="RowTitle" Text="{loc:T Settings_PerApp}" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="2"
                                Classes="RowNavValue"
                                Text="{Binding PerAppText}" />
                            <PathIcon
                                Grid.Column="3"
                                Classes="Chevron"
                                Data="{StaticResource Geo.Set.Chevron}" />
                        </Grid>
                    </Border>

                    <Border Classes="SettingDivider" />

                    <!--  Обход локальной сети + тумблер  -->
                    <Border x:Name="RowBypassLan" Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Classes="SetTile">
                                <PathIcon Data="{StaticResource Geo.Set.Lan}" />
                            </Border>
                            <StackPanel Grid.Column="1" Classes="RowText">
                                <TextBlock Classes="RowTitle" Text="{loc:T Settings_BypassLan}" />
                                <TextBlock Classes="RowSub" Text="{loc:T Settings_BypassLanHint}" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="SwitchBypassLan"
                                Grid.Column="2"
                                Classes="RowSwitch"
                                IsChecked="{Binding BypassLan, Mode=TwoWay}"
                                Theme="{StaticResource ToggleSwitch.Row}" />
                        </Grid>
                    </Border>

                    <Border Classes="SettingDivider" />

                    <!--  IPv6 + тумблер  -->
                    <Border x:Name="RowIpv6" Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Classes="SetTile">
                                <PathIcon Data="{StaticResource Geo.Set.Globe}" />
                            </Border>
                            <StackPanel Grid.Column="1" Classes="RowText">
                                <TextBlock Classes="RowTitle" Text="IPv6" />
                                <TextBlock Classes="RowSub" Text="{loc:T Settings_Ipv6Hint}" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="SwitchIpv6"
                                Grid.Column="2"
                                Classes="RowSwitch"
                                IsChecked="{Binding EnableIpv6, Mode=TwoWay}"
                                Theme="{StaticResource ToggleSwitch.Row}" />
                        </Grid>
                    </Border>

                    <Border Classes="SettingDivider" />

                    <!--  DNS → окошко (решение координатора: прототип объявляет строку как pop, ширина 236).
                          Пресеты — реальные адреса движка (Global.DomainRemoteDNSAddress), см. VM.  -->
                    <Border x:Name="RowDns" Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Classes="SetTile">
                                <PathIcon Data="{StaticResource Geo.Set.Privacy}" />
                            </Border>
                            <StackPanel Grid.Column="1" Classes="RowText">
                                <TextBlock Classes="RowTitle" Text="DNS" />
                            </StackPanel>
                            <views:ValuePicker
                                x:Name="PickDns"
                                Grid.Column="2"
                                Anchor="{Binding #RowDns}"
                                Options="{Binding DnsOptions}"
                                SelectedIndex="{Binding DnsIndex, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <Border Classes="SettingDivider" />

                    <!--  Пинг → окошко (решение координатора; ширина 246).  -->
                    <Border x:Name="RowPingMethod" Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Classes="SetTile">
                                <PathIcon Data="{StaticResource Geo.Set.Ping}" />
                            </Border>
                            <StackPanel Grid.Column="1" Classes="RowText">
                                <TextBlock Classes="RowTitle" Text="{loc:T Settings_Ping}" />
                            </StackPanel>
                            <views:ValuePicker
                                x:Name="PickPing"
                                Grid.Column="2"
                                Anchor="{Binding #RowPingMethod}"
                                Options="{Binding PingOptions}"
                                SelectedIndex="{Binding PingIndex, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <Border Classes="SettingDivider" />

                    <!--  Локальный прокси → подэкран (screens.md: «Порт и SOCKS5-авторизация»).
                          Раньше строка раскрывала инлайн-панель — той панели больше нет: подэкран
                          LocalProxyPage в ветке появился и, в отличие от панели, не даёт менять порт
                          на живом туннеле. Шеврон обычный, статичный: строка уходит, а не раскрывает.  -->
                    <Border x:Name="RowLocalProxy" Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Classes="SetTile">
                                <PathIcon Data="{StaticResource Geo.Set.Router}" />
                            </Border>
                            <StackPanel Grid.Column="1" Classes="RowText">
                                <TextBlock Classes="RowTitle" Text="{loc:T Settings_LocalProxy}" />
                                <TextBlock Classes="RowSub" Text="{loc:T Settings_LocalProxyHint}" />
                            </StackPanel>
                            <PathIcon
                                Grid.Column="2"
                                Classes="Chevron"
                                Data="{StaticResource Geo.Set.Chevron}" />
                        </Grid>
                    </Border>

                </StackPanel>
            </Border>

            <!--  ==================== ОБХОД БЛОКИРОВОК ====================  -->
            <TextBlock Classes="SectionHeader SettingsSection" Text="{loc:T Settings_SecBypass}" />

            <Border x:Name="CardBypass" Classes="SetCard">
                <StackPanel>

                    <!--  Мультиплексирование (Mux) + тумблер  -->
                    <Border x:Name="RowMux" Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Classes="SetTile">
                                <PathIcon Data="{StaticResource Geo.Set.Mux}" />
                            </Border>
                            <StackPanel Grid.Column="1" Classes="RowText">
                                <TextBlock Classes="RowTitle" Text="{loc:T Settings_Mux}" />
                                <TextBlock Classes="RowSub" Text="{loc:T Settings_MuxHint}" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="SwitchMux"
                                Grid.Column="2"
                                Classes="RowSwitch"
                                IsChecked="{Binding MuxEnabled, Mode=TwoWay}"
                                Theme="{StaticResource ToggleSwitch.Row}" />
                        </Grid>
                    </Border>

                    <!--  ЗАВИСИМАЯ СТРОКА: «Число соединений Mux» существует только при включённом Mux.
                          Разделитель уезжает ВМЕСТЕ с ней (иначе при выключенном Mux остались бы две
                          линии подряд), поэтому оба лежат в одной группе, которую и раскрывает
                          code-behind по высоте за 320 мс (motion.md «Зависимая строка»).  -->
                    <StackPanel x:Name="MuxCountGroup" IsVisible="False">
                        <Border Classes="SettingDivider" />
                        <Border x:Name="RowMuxCount" Classes="SettingRow">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" Classes="SetTile">
                                    <PathIcon Data="{StaticResource Geo.Set.Speed}" />
                                </Border>
                                <StackPanel Grid.Column="1" Classes="RowText">
                                    <TextBlock Classes="RowTitle" Text="{loc:T Settings_MuxCount}" />
                                </StackPanel>
                                <views:ValuePicker
                                    x:Name="PickMuxCount"
                                    Grid.Column="2"
                                    Anchor="{Binding #RowMuxCount}"
                                    Options="{Binding MuxCountOptions}"
                                    SelectedIndex="{Binding MuxCountIndex, Mode=TwoWay}" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Border Classes="SettingDivider" />

                    <!--  Фрагментация пакетов + тумблер  -->
                    <Border x:Name="RowFragment" Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Classes="SetTile">
                                <PathIcon Data="{StaticResource Geo.Set.Fragment}" />
                            </Border>
                            <StackPanel Grid.Column="1" Classes="RowText">
                                <TextBlock Classes="RowTitle" Text="{loc:T Settings_Fragment}" />
                                <TextBlock Classes="RowSub" Text="{loc:T Settings_FragmentHint}" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="SwitchFragment"
                                Grid.Column="2"
                                Classes="RowSwitch"
                                IsChecked="{Binding FragmentEnabled, Mode=TwoWay}"
                                Theme="{StaticResource ToggleSwitch.Row}" />
                        </Grid>
                    </Border>

                </StackPanel>
            </Border>

            <!--  ==================== ПРОИЗВОДИТЕЛЬНОСТЬ ====================  -->
            <TextBlock Classes="SectionHeader SettingsSection" Text="{loc:T Settings_SecPerformance}" />

            <Border x:Name="CardPerformance" Classes="SetCard">
                <StackPanel>

                    <!--  Облегчённый режим гасит ВСЁ движение приложения: прогиб строк, окошко,
                          раскрытие зависимой строки, кольцо, переходы вкладок (общий MotionState).  -->
                    <Border x:Name="RowLiteMode" Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Classes="SetTile">
                                <PathIcon Data="{StaticResource Geo.Set.Speed}" />
                            </Border>
                            <StackPanel Grid.Column="1" Classes="RowText">
                                <TextBlock Classes="RowTitle" Text="{loc:T Settings_LiteMode}" />
                                <TextBlock Classes="RowSub" Text="{loc:T Settings_LiteModeHint}" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="SwitchLiteMode"
                                Grid.Column="2"
                                Classes="RowSwitch"
                                IsChecked="{Binding LiteMode, Mode=TwoWay}"
                                Theme="{StaticResource ToggleSwitch.Row}" />
                        </Grid>
                    </Border>

                </StackPanel>
            </Border>

            <!--  ==================== ИНТЕРФЕЙС ====================  -->
            <TextBlock Classes="SectionHeader SettingsSection" Text="{loc:T Settings_SecInterface}" />

            <Border x:Name="CardInterface" Classes="SetCard">
                <StackPanel>

                    <!--  Оформление → окошко из ЧЕТЫРЁХ РАВНЫХ пунктов: Тёмная · Светлая · Чёрно-белая ·
                          Как в системе. Прежде чёрно-белая была отдельным тумблером-надстройкой над
                          базой — пятым состоянием, которого в списке нет; теперь пункты взаимоисключающие
                          (см. SettingsViewModel.SetLook).  -->
                    <Border x:Name="RowAppearance" Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Classes="SetTile">
                                <PathIcon Data="{StaticResource Geo.Set.Palette}" />
                            </Border>
                            <StackPanel Grid.Column="1" Classes="RowText">
                                <TextBlock Classes="RowTitle" Text="{loc:T Settings_Appearance}" />
                            </StackPanel>
                            <views:ValuePicker
                                x:Name="PickLook"
                                Grid.Column="2"
                                Anchor="{Binding #RowAppearance}"
                                Options="{Binding LookOptions}"
                                SelectedIndex="{Binding LookIndex, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <Border Classes="SettingDivider" />

                    <!--  Язык → окошко: Системный · Русский · English (живое переключение, без перезапуска)  -->
                    <Border x:Name="RowLanguage" Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Classes="SetTile">
                                <PathIcon Data="{StaticResource Geo.Set.Globe}" />
                            </Border>
                            <StackPanel Grid.Column="1" Classes="RowText">
                                <TextBlock Classes="RowTitle" Text="{loc:T Settings_Language}" />
                            </StackPanel>
                            <views:ValuePicker
                                x:Name="PickLanguage"
                                Grid.Column="2"
                                Anchor="{Binding #RowLanguage}"
                                Options="{Binding LanguageOptions}"
                                SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <Border Classes="SettingDivider" />

                    <!--  Масштаб интерфейса → окошко. Те же значения дают Ctrl +/Ctrl −/Ctrl 0 (ToolTip);
                          набор досчитывается фактическим фактором, если он набран клавишами.  -->
                    <Border
                        x:Name="RowUiScale"
                        Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Classes="SetTile">
                                <PathIcon Data="{StaticResource Geo.Set.Scale}" />
                            </Border>
                            <StackPanel Grid.Column="1" Classes="RowText">
                                <TextBlock Classes="RowTitle" Text="{loc:T Settings_UiScale}" />
                            </StackPanel>
                            <views:ValuePicker
                                x:Name="PickUiScale"
                                Grid.Column="2"
                                Anchor="{Binding #RowUiScale}"
                                Options="{Binding UiScaleOptions}"
                                SelectedIndex="{Binding UiScaleIndex, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <Border Classes="SettingDivider" />

                    <!--  Запуск с системой + тумблер  -->
                    <Border x:Name="RowBoot" Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Classes="SetTile">
                                <PathIcon Data="{StaticResource Geo.Set.Power}" />
                            </Border>
                            <StackPanel Grid.Column="1" Classes="RowText">
                                <TextBlock Classes="RowTitle" Text="{loc:T Settings_Autostart}" />
                                <TextBlock Classes="RowSub" Text="{loc:T Settings_AutostartHint}" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="SwitchBoot"
                                Grid.Column="2"
                                Classes="RowSwitch"
                                IsChecked="{Binding AutoStart, Mode=TwoWay}"
                                Theme="{StaticResource ToggleSwitch.Row}" />
                        </Grid>
                    </Border>

                    <Border Classes="SettingDivider" />

                    <!--  Скрыть значок в трее + тумблер. Пакет ставит эту строку на «Локальный
                          прокси»; владелец вернул её сюда, к автозапуску — оба про поведение
                          приложения в системе, и искать её тут естественнее.  -->
                    <Border x:Name="RowTrayIcon" Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Classes="SetTile">
                                <PathIcon Data="{StaticResource Geo.Set.HideTray}" />
                            </Border>
                            <StackPanel Grid.Column="1" Classes="RowText">
                                <TextBlock Classes="RowTitle" Text="{loc:T Settings_HideTray}" />
                                <TextBlock Classes="RowSub" Text="{loc:T Settings_HideTrayHint}" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="SwitchTrayIcon"
                                Grid.Column="2"
                                Classes="RowSwitch"
                                IsChecked="{Binding HideTrayIcon, Mode=TwoWay}"
                                Theme="{StaticResource ToggleSwitch.Row}" />
                        </Grid>
                    </Border>

                    

                </StackPanel>
            </Border>

            <!--  ==================== ПОДПИСКА ====================  -->
            <TextBlock Classes="SectionHeader SettingsSection" Text="{loc:T Settings_SecSubscription}" />

            <Border x:Name="CardSubscription" Classes="SetCard">
                <StackPanel>

                    <!--  Автообновление подписки → окошко: 1 час · 3 часа · 6 часов · 12 часов · Выключено  -->
                    <Border x:Name="RowSubAutoUpdate" Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Classes="SetTile">
                                <PathIcon Data="{StaticResource Geo.Set.Refresh}" />
                            </Border>
                            <StackPanel Grid.Column="1" Classes="RowText">
                                <TextBlock Classes="RowTitle" Text="{loc:T Settings_SubAutoUpdate}" />
                            </StackPanel>
                            <views:ValuePicker
                                x:Name="PickAutoUpdate"
                                Grid.Column="2"
                                Anchor="{Binding #RowSubAutoUpdate}"
                                Options="{Binding AutoUpdateOptions}"
                                SelectedIndex="{Binding AutoUpdateIndex, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <Border Classes="SettingDivider" />

                    <!--  Маршрутизация → подэкран  -->
                    <Border x:Name="RowRouting" Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Classes="SetTile">
                                <PathIcon Data="{StaticResource Geo.Set.Routing}" />
                            </Border>
                            <StackPanel Grid.Column="1" Classes="RowText">
                                <TextBlock Classes="RowTitle" Text="{loc:T Settings_Routing}" />
                                <TextBlock Classes="RowSub" Text="{loc:T Settings_RoutingHint}" />
                            </StackPanel>
                            <PathIcon
                                Grid.Column="2"
                                Classes="Chevron"
                                Data="{StaticResource Geo.Set.Chevron}" />
                        </Grid>
                    </Border>

                    <Border Classes="SettingDivider" />

                    <!--  Файлы ресурсов → подэкран  -->
                    <Border x:Name="RowAssets" Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Classes="SetTile">
                                <PathIcon Data="{StaticResource Geo.Set.File}" />
                            </Border>
                            <StackPanel Grid.Column="1" Classes="RowText">
                                <TextBlock Classes="RowTitle" Text="{loc:T Settings_GeoFiles}" />
                                <TextBlock Classes="RowSub" Text="{loc:T Settings_GeoFilesHint}" />
                            </StackPanel>
                            <PathIcon
                                Grid.Column="2"
                                Classes="Chevron"
                                Data="{StaticResource Geo.Set.Chevron}" />
                        </Grid>
                    </Border>

                </StackPanel>
            </Border>

            <!--  ==================== О ПРИЛОЖЕНИИ ====================  -->
            <TextBlock Classes="SectionHeader SettingsSection" Text="{loc:T Settings_About}" />

            <Border x:Name="CardAbout" Classes="SetCard">
                <StackPanel>

                    <!--  Журнал → подэкран  -->
                    <Border x:Name="RowLog" Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Classes="SetTile">
                                <PathIcon Data="{StaticResource Geo.Set.Fragment}" />
                            </Border>
                            <StackPanel Grid.Column="1" Classes="RowText">
                                <TextBlock Classes="RowTitle" Text="{loc:T Settings_Log}" />
                                <TextBlock Classes="RowSub" Text="{loc:T Settings_LogHint}" />
                            </StackPanel>
                            <PathIcon
                                Grid.Column="2"
                                Classes="Chevron"
                                Data="{StaticResource Geo.Set.Chevron}" />
                        </Grid>
                    </Border>

                    <Border Classes="SettingDivider" />

                    <!--  Резервное копирование → подэкран  -->
                    <Border x:Name="RowBackup" Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Classes="SetTile">
                                <PathIcon Data="{StaticResource Geo.Set.Backup}" />
                            </Border>
                            <StackPanel Grid.Column="1" Classes="RowText">
                                <TextBlock Classes="RowTitle" Text="{loc:T Settings_Backup}" />
                                <TextBlock Classes="RowSub" Text="{loc:T Settings_BackupHint}" />
                            </StackPanel>
                            <PathIcon
                                Grid.Column="2"
                                Classes="Chevron"
                                Data="{StaticResource Geo.Set.Chevron}" />
                        </Grid>
                    </Border>

                    <Border Classes="SettingDivider" />

                    <!--  Схемы URL-адресов → подэкран  -->
                    <Border x:Name="RowUrlScheme" Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Classes="SetTile">
                                <PathIcon Data="{StaticResource Geo.Set.UrlScheme}" />
                            </Border>
                            <StackPanel Grid.Column="1" Classes="RowText">
                                <TextBlock Classes="RowTitle" Text="{loc:T Settings_UrlSchemes}" />
                                <TextBlock Classes="RowSub" Text="{loc:T Settings_UrlSchemesHint}" />
                            </StackPanel>
                            <PathIcon
                                Grid.Column="2"
                                Classes="Chevron"
                                Data="{StaticResource Geo.Set.Chevron}" />
                        </Grid>
                    </Border>

                    <Border Classes="SettingDivider" />

                    <!--  О приложении → подэкран  -->
                    <Border x:Name="RowCheckUpdate" Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <Border Grid.Column="0" Classes="SetTile">
                                <PathIcon Data="{StaticResource Geo.Set.Refresh}" />
                            </Border>
                            <StackPanel Grid.Column="1" Classes="RowText">
                                <TextBlock Classes="RowTitle" Text="{loc:T Settings_CheckUpdate}" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="2"
                                Classes="RowNavValue"
                                Text="{Binding VersionText}" />
                            <PathIcon
                                Grid.Column="3"
                                Classes="Chevron"
                                Data="{StaticResource Geo.Set.Chevron}" />
                        </Grid>
                    </Border>

                    <Border Classes="SettingDivider" />

                    <!--  О приложении → подэкран  -->
                    <Border x:Name="RowAbout" Classes="SettingRow">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Classes="SetTile">
                                <PathIcon Data="{StaticResource Geo.Set.About}" />
                            </Border>
                            <StackPanel Grid.Column="1" Classes="RowText">
                                <TextBlock Classes="RowTitle" Text="{loc:T Settings_About}" />
                            </StackPanel>
                            <PathIcon
                                Grid.Column="2"
                                Classes="Chevron"
                                Data="{StaticResource Geo.Set.Chevron}" />
                        </Grid>
                    </Border>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
