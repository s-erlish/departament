        <!--  Роутер (ic_hub_local_proxy)  -->
        <StreamGeometry x:Key="Geo.Set.Router">M20.2,5.9l0.8,-0.8C19.6,3.7 17.8,3 16,3s-3.6,0.7 -5,2.1l0.8,0.8C13,4.8 14.5,4.2 16,4.2s3,0.6 4.2,1.7zM19.3,6.7c-0.8,-0.8 -2.1,-1.4 -3.3,-1.4s-2.5,0.5 -3.3,1.4l0.8,0.8c0.6,-0.6 1.6,-1 2.5,-1s1.9,0.4 2.5,1l0.8,-0.8zM19,13h-2V9h-2v4H5c-1.1,0 -2,0.9 -2,2v4c0,1.1 0.9,2 2,2h14c1.1,0 2,-0.9 2,-2v-4c0,-1.1 -0.9,-2 -2,-2zM8,18H6v-2h2v2zM11.5,18h-2v-2h2v2zM15,18h-2v-2h2v2z</StreamGeometry>
        <!--  Mux — два канала в одной стойке (ic_lp_http), тот же глиф, что у строки «Мультиплексирование»
              на Android. Раньше здесь стоял сплошной круг: в плитке он читался как заглушка на месте
              пропавшей иконки, а не как знак.  -->
        <StreamGeometry x:Key="Geo.Set.Mux">M20,13H4c-0.55,0 -1,0.45 -1,1v6c0,0.55 0.45,1 1,1h16c0.55,0 1,-0.45 1,-1v-6c0,-0.55 -0.45,-1 -1,-1zM7,19c-0.83,0 -1.5,-0.67 -1.5,-1.5S6.17,16 7,16s1.5,0.67 1.5,1.5S7.83,19 7,19zM20,3H4c-0.55,0 -1,0.45 -1,1v6c0,0.55 0.45,1 1,1h16c0.55,0 1,-0.45 1,-1V4c0,-0.55 -0.45,-1 -1,-1zM7,9c-0.83,0 -1.5,-0.67 -1.5,-1.5S6.17,6 7,6s1.5,0.67 1.5,1.5S7.83,9 7,9z</StreamGeometry>
