<UserControl
    x:Class="departament.Desktop.Views.SudoPasswordInputView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:departament.Desktop.Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--  ================================================================================
          Пароль sudo — Linux и macOS спрашивают его, когда включается режим «весь трафик» (TUN).

          Раньше здесь стоял стоковый диалог апстрима: две вложенные карточки темы Semi, подпись
          СЛЕВА от поля, серые кнопки по 100 точек — «Подтвердить» в них не помещалось и читалось
          «Подтверди», — и тире в русском пояснении. Теперь это тот же словарь, что у остальных
          диалогов: заголовок, короткое пояснение, поле Incy с глазом, ошибка прямо под полем,
          «Отмена» тональная и «Подтвердить» акцентная справа (как в MessageBoxDialog).

          Карточка ОДНА и своя. DialogHost в MainWindow рисует только затемнение страницы, а его
          собственная подложка прозрачна (владелец: «чёрный фон вокруг этого надо убрать»), поэтому
          поверхность, скругление 20 и волосяную рамку диалог приносит сам — как MessageBoxDialog.
          Вложенности нет: под карточкой ничего, кроме затемнения.
          =================================================================================  -->

    <UserControl.Resources>
        <!--  Глаз «показать / скрыть пароль» — те же пути, что у поля пароля на «Входе» (LoginView):
              одна иконка на одно действие во всём приложении.  -->
        <StreamGeometry x:Key="Geo.Sudo.Eye">M12,4.5C7,4.5 2.73,7.61 1,12c1.73,4.39 6,7.5 11,7.5s9.27,-3.11 11,-7.5c-1.73,-4.39 -6,-7.5 -11,-7.5zM12,17c-2.76,0 -5,-2.24 -5,-5s2.24,-5 5,-5 5,2.24 5,5 -2.24,5 -5,5zM12,9c-1.66,0 -3,1.34 -3,3s1.34,3 3,3 3,-1.34 3,-3 -1.34,-3 -3,-3z</StreamGeometry>
        <StreamGeometry x:Key="Geo.Sudo.EyeOff">M12,7c2.76,0 5,2.24 5,5 0,0.65 -0.13,1.26 -0.36,1.83l2.92,2.92c1.51,-1.26 2.7,-2.89 3.43,-4.75 -1.73,-4.39 -6,-7.5 -11,-7.5 -1.4,0 -2.74,0.25 -3.98,0.7l2.16,2.16C10.74,7.13 11.35,7 12,7zM2,4.27l2.28,2.28 0.46,0.46C3.08,8.3 1.78,10.02 1,12c1.73,4.39 6,7.5 11,7.5 1.55,0 3.03,-0.3 4.38,-0.84l0.42,0.42L19.73,22 21,20.73 3.27,3 2,4.27zM7.53,9.8l1.55,1.55c-0.05,0.21 -0.08,0.43 -0.08,0.65 0,1.66 1.34,3 3,3 0.22,0 0.44,-0.03 0.65,-0.08l1.55,1.55c-0.67,0.33 -1.41,0.53 -2.2,0.53 -2.76,0 -5,-2.24 -5,-5 0,-0.79 0.2,-1.53 0.53,-2.2zM11.84,9.02l3.15,3.15 0.02,-0.16c0,-1.66 -1.34,-3 -3,-3l-0.17,0.01z</StreamGeometry>
    </UserControl.Resources>

    <UserControl.Styles>
        <!--  Неверный пароль: рамка поля красная, пока человек не начнёт печатать заново
              (00-rules §7.4 «error below the field, border red»).  -->
        <Style Selector="TextBox.fieldError /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Red}" />
        </Style>
    </UserControl.Styles>

    <!--  Ширина 344: пояснение укладывается в три строки по ~50 знаков, а не тянется в одну
          длинную (00-rules §5.8 «measure»).  -->
    <Border
        Padding="24"
        Background="{DynamicResource Brush.Surface}"
        BorderBrush="{DynamicResource Brush.OutlineVariant}"
        BorderThickness="1"
        CornerRadius="{DynamicResource Radius.Card}">
        <StackPanel Width="344" Spacing="24">

            <StackPanel Spacing="8">
                <TextBlock
                    Classes="Title"
                    Text="{loc:T Sudo_Title}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Classes="Body"
                    Foreground="{DynamicResource Brush.OnSurfaceVariant}"
                    Text="{loc:T Sudo_Hint}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!--  Поле + ошибка под ним. Заголовок диалога и есть подпись поля (оно здесь одно), поэтому
                  отдельной подписи над полем нет, а для экранного диктора имя поля задано явно.  -->
            <StackPanel Spacing="8">
                <TextBox
                    x:Name="txtPassword"
                    AutomationProperties.Name="{loc:T Sudo_Title}"
                    PasswordChar="•"
                    Theme="{StaticResource TextBox.Incy}">
                    <TextBox.InnerRightContent>
                        <Button
                            x:Name="btnReveal"
                            Width="40"
                            Height="40"
                            Padding="0"
                            Classes="IconButton">
                            <Panel>
                                <PathIcon
                                    x:Name="EyeOnIcon"
                                    Width="20"
                                    Height="20"
                                    Data="{StaticResource Geo.Sudo.Eye}"
                                    Foreground="{DynamicResource Brush.OnSurfaceVariant}" />
                                <PathIcon
                                    x:Name="EyeOffIcon"
                                    Width="20"
                                    Height="20"
                                    Data="{StaticResource Geo.Sudo.EyeOff}"
                                    Foreground="{DynamicResource Brush.OnSurfaceVariant}"
                                    IsVisible="False" />
                            </Panel>
                        </Button>
                    </TextBox.InnerRightContent>
                </TextBox>
                <TextBlock
                    x:Name="txtError"
                    Classes="Caption"
                    Foreground="{DynamicResource Brush.RedText}"
                    IsVisible="False"
                    Text="{loc:T Sudo_Wrong}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!--  Действия: «Отмена» (тональная) · «Подтвердить» (акцентная), обе по ширине подписи с
                  минимумом — фиксированная ширина и обрезала подпись.  -->
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="12">
                <Button
                    x:Name="btnCancel"
                    MinWidth="96"
                    Classes="Tonal"
                    Content="{loc:T Common_Cancel}"
                    IsCancel="True" />
                <Button
                    x:Name="btnSave"
                    MinWidth="112"
                    Classes="Primary"
                    Content="{loc:T Sudo_Confirm}"
                    IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
