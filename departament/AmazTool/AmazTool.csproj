<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Установщик обновлений departament. Запускается приложением на время обновления, ждёт его выхода,
		раскладывает пакет и поднимает новую версию. Окна у него нет вовсе (WinExe): раньше это было
		консольное окно с английским и китайским текстом, которое пользователь видел поверх рабочего стола.
		Всё, что он делает, пишется в guiLogs/upgrade.log.

		NativeAOT, а не self-contained single-file. Directory.Build.props включает PublishSingleFile для
		ВСЕХ проектов в Release, и AmazTool выходил полным пакетом со своей средой .NET: около 30 МБ сверху
		к каждому архиву обновления, который качает каждый пользователь (сборка CI 109: dist 136,8 → 170,3 МБ).
		Машинный код без среды — около 3 МБ. Для AOT одиночный файл не нужен и с ним несовместим, поэтому
		PublishSingleFile здесь снят. Команда публикации та же, что у CI:
		  dotnet publish departament/AmazTool/AmazTool.csproj -c Release -r win-x64 -p:SelfContained=true -o dist
		На windows-latest для AOT нужен MSVC, он там есть; с Linux под Windows AOT не собирается.
	-->
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<PublishAot>true</PublishAot>
		<PublishSingleFile>false</PublishSingleFile>
		<PublishReadyToRun>false</PublishReadyToRun>
		<OptimizationPreference>Size</OptimizationPreference>
		<!--  Сообщений для людей в установщике нет, только журнал: таблицы культур ему не нужны.  -->
		<InvariantGlobalization>true</InvariantGlobalization>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<!--  Символы не кладём рядом с exe: в пакет обновления попадает всё, что лежит в dist.  -->
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
		<StripSymbols>true</StripSymbols>
	</PropertyGroup>

</Project>
